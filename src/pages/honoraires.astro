---
/**
 * Barème des honoraires.
 *
 * Obligation professionnelle : le barème doit être accessible depuis toutes
 * les pages, en HTML et pas seulement en PDF (§15). Les taux viennent du
 * back-office (registre `agence.honoraires`), avec pour repli ceux transcrits
 * du PDF publié par l'agence.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';
import { COMPANY, REGULATED, LEGAL_DISCREPANCIES, isMissing } from '~/lib/site';
import { agency, field, fieldPairs } from '~/lib/content';

const recette = import.meta.env.PUBLIC_RECETTE === '1';
const contact = agency();

const sale = fieldPairs('agence.honoraires', 'vente');
const rental = fieldPairs('agence.honoraires', 'location');
const management = fieldPairs('agence.honoraires', 'gestion');
const inForce = field('agence.honoraires', 'en_vigueur');
const mention = field('agence.honoraires', 'mention');

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Barème des honoraires' },
];
---

<Base
  title="Barème des honoraires – AUREA Immobilier"
  description="Nos honoraires de transaction, de location et de gestion locative, en clair : taux, minimums et partie qui les prend en charge."
  path="/honoraires/"
  crumbs={crumbs}
>
  <PageHeader
    title="Barème des honoraires"
    kicker="Transparence"
    lede="Nos honoraires sont publics. Le prix affiché sur chaque annonce les inclut, et l’annonce précise qui les prend en charge."
    crumbs={crumbs}
    width="narrow"
  >
    {
      inForce && (
        <p class="updated">
          <Icon name="calendar" size={15} /> Barème en vigueur depuis le {inForce}
        </p>
      )
    }
  </PageHeader>

  <div class="wrap-narrow section">
    <section class="bloc">
      <h2>Transaction — vente</h2>
      {
        sale.length > 0 ? (
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Honoraires de transaction</caption>
              <thead>
                <tr>
                  <th scope="col">Nature du bien</th>
                  <th scope="col">Honoraires</th>
                  <th scope="col">Minimum</th>
                </tr>
              </thead>
              <tbody>
                {sale.map(([label, rate, min]) => (
                  <tr>
                    <th scope="row">{label}</th>
                    <td class="tnum">{rate ?? '—'}</td>
                    <td class="tnum">{min || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="notice">Barème de transaction communiqué sur simple demande à l’agence.</p>
        )
      }
      <p>
        Les honoraires sont <strong>à la charge du vendeur</strong>. À titre exceptionnel, ils
        peuvent être mis à la charge de l’acquéreur : le barème appliqué est alors identique à
        celui du vendeur.
      </p>
      <p class="small muted">La délivrance d’une note d’honoraires est obligatoire.</p>
    </section>

    <section class="bloc">
      <h2>Location</h2>
      {
        rental.length > 0 ? (
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Honoraires de location</caption>
              <thead>
                <tr>
                  <th scope="col">Prestation</th>
                  <th scope="col">Part locataire</th>
                  <th scope="col">Part bailleur</th>
                </tr>
              </thead>
              <tbody>
                {rental.map(([label, tenant, owner]) => (
                  <tr>
                    <th scope="row">{label}</th>
                    <td class="tnum">{tenant || '—'}</td>
                    <td class="tnum">{owner || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="notice">Barème de location communiqué sur simple demande à l’agence.</p>
        )
      }
      <p class="small muted">
        Les honoraires à la charge du locataire sont plafonnés par décret, au mètre carré de
        surface habitable et selon la zone. Ils ne peuvent pas dépasser ceux du bailleur.
      </p>
    </section>

    <section class="bloc">
      <h2>Gestion locative</h2>
      {
        management.length > 0 ? (
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Honoraires de gestion locative</caption>
              <thead>
                <tr>
                  <th scope="col">Prestation</th>
                  <th scope="col">Honoraires</th>
                </tr>
              </thead>
              <tbody>
                {management.map(([label, fee]) => (
                  <tr>
                    <th scope="row">{label}</th>
                    <td class="tnum">{fee || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="notice">Barème de gestion locative communiqué sur simple demande à l’agence.</p>
        )
      }
      <p class="small">
        <a href="/gestion-locative/" class="link-arrow">Découvrir ce que comprend notre mandat de gestion</a>
      </p>
    </section>

    {mention && <p class="mention">{mention}</p>}

    <section class="bloc regulated">
      <h2>Mentions réglementaires</h2>
      <dl>
        <div>
          <dt>Raison sociale</dt>
          <dd>
            {COMPANY.legalName}, {COMPANY.legalForm} au capital de {COMPANY.capital}, RCS
            {' '}{COMPANY.rcsCity} {COMPANY.rcs}
          </dd>
        </div>
        <div>
          <dt>Siège social</dt>
          <dd>{COMPANY.headOffice}</dd>
        </div>
        <div>
          <dt>Agence</dt>
          <dd>{contact.street}, {contact.postalCode} {contact.city} — SIRET {COMPANY.agencySiret}</dd>
        </div>
        <div>
          <dt>Carte professionnelle</dt>
          <dd>
            {REGULATED.cpiScope}, n° {REGULATED.cpiNumber}, délivrée par la
            {' '}{REGULATED.cpiIssuer} le 5 septembre 2024
          </dd>
        </div>
        <div>
          <dt>Assurance responsabilité civile professionnelle</dt>
          <dd>
            {REGULATED.insurer}, police n° {REGULATED.insurancePolicy} —
            {' '}{REGULATED.insurerAddress}
          </dd>
        </div>
        <div>
          <dt>Détention de fonds</dt>
          <dd>
            L’agence déclare ne pas recevoir ni détenir d’autres fonds, effets ou valeurs que ceux
            représentatifs de sa rémunération ou de sa commission.
          </dd>
        </div>
        {
          !isMissing(REGULATED.financialGuarantee) && (
            <div>
              <dt>Garantie financière</dt>
              <dd>{REGULATED.financialGuarantee}</dd>
            </div>
          )
        }
      </dl>
      <p class="small muted">Source : {REGULATED.source}.</p>
    </section>

    {
      recette && (
        <aside class="notice">
          <h2 class="notice-title">Points à trancher avant publication</h2>
          <ul>
            {LEGAL_DISCREPANCIES.map((d) => (
              <li>
                <strong>{d.field}</strong> — mentions légales : {d.inLegalNotice} ; barème des
                honoraires : {d.inFeesPdf}. {d.note}
              </li>
            ))}
            <li>
              <strong>Garantie financière et gestion locative</strong> — la déclaration de
              non-détention de fonds figurant au barème est difficilement compatible avec
              l’encaissement de loyers pour le compte de propriétaires. À faire confirmer.
            </li>
          </ul>
          <p class="small">Cet encadré n’est visible qu’en recette.</p>
        </aside>
      )
    }

    <p class="foot">
      {/* Le PDF d'origine portait le RCS d'une autre société (MAUME VR). La
          version imprimable de cette page le remplace : mêmes chiffres que
          ceux saisis dans le back-office, mentions d'AUREA IMMOBILIER. */}
      <button type="button" class="btn btn-outline no-print" data-print>
        <Icon name="file" size={18} /> Imprimer ou enregistrer en PDF
      </button>
      <span class="small muted">
        Ce barème est celui affiché en agence. Une question ?{' '}
        <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a>
      </span>
    </p>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  /* Impression : le barème seul, au format affiché en vitrine. */
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.action-bar),
    :global(.cookie-notice),
    :global(.breadcrumb),
    :global(.cta-band),
    .no-print {
      display: none !important;
    }

    :global(body) {
      font-size: 11pt;
    }

    :global(.page-header) {
      padding-block: 0 1rem;
      background: none;
      border: 0;
    }

    :global(.table-wrap) {
      overflow: visible;
      border-color: #999;
    }

    :global(th),
    :global(td) {
      padding: 0.35rem 0.5rem;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }
  }

  .updated {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: var(--space-s) 0 0;
  }

  .bloc {
    margin-bottom: var(--space-xl);
  }

  .bloc h2 {
    font-size: var(--step-2);
  }

  .table-wrap {
    margin-bottom: var(--space-s);
  }

  .mention {
    padding: var(--space-s) var(--space-m);
    margin-bottom: var(--space-xl);
    background: var(--sand-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: var(--ink-soft);
  }

  .regulated dl {
    margin: 0 0 var(--space-s);
  }

  .regulated dl > div {
    padding-block: var(--space-2xs);
    border-bottom: 1px solid var(--line);
  }

  .regulated dt {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .regulated dd {
    margin: 0;
  }

  .notice-title {
    font-family: var(--font-body);
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }

  .notice ul {
    margin-bottom: var(--space-2xs);
    padding-left: 1.1rem;
  }

  .notice li + li {
    margin-top: var(--space-2xs);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin: var(--space-l) 0 0;
  }
</style>
