---
/**
 * Gestion locative — vraie page de vente, pas un formulaire (§7, §8).
 * Textes du registre `page.gestion` ; le bareme n'est affiche que s'il a ete
 * saisi dans le back-office.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import LeadForm from '~/components/LeadForm.astro';
import AgentCard from '~/components/AgentCard.astro';
import Icon from '~/components/Icon.astro';
import Faq, { type FaqItem } from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { agentBySlug, editorialMedia } from '~/lib/catalog';
import { faqSchema } from '~/lib/schema';
import { field, fieldPairs, agency } from '~/lib/content';

const manager = agentBySlug('marion-nicaise');
const visual = editorialMedia('gestion-locative');
const contact = agency();
const included = fieldPairs('page.gestion', 'prestations');
const fees = fieldPairs('agence.honoraires', 'gestion');
const recette = import.meta.env.PUBLIC_RECETTE === '1';

const INCLUDED_ICONS = ['users', 'file', 'key', 'euro', 'chart', 'home', 'calendar'] as const;

/** Calendrier officiel — a verifier sur Legifrance a chaque evolution (§11). */
const dpeCalendar = [
  ['1ᵉʳ janvier 2025', 'Logements classés G', 'Interdits à la location en tant que logement décent'],
  ['1ᵉʳ janvier 2028', 'Logements classés F', 'Interdits à la location en tant que logement décent'],
  ['1ᵉʳ janvier 2034', 'Logements classés E', 'Interdits à la location en tant que logement décent'],
];

const faq: FaqItem[] = [
  {
    question: 'Combien coûte la gestion locative ?',
    answer:
      'Les honoraires de gestion sont exprimés en pourcentage des loyers encaissés et vous sont communiqués avant toute signature, avec le détail des prestations incluses. Ils sont déductibles de vos revenus fonciers au régime réel.',
  },
  {
    question: 'Proposez-vous une garantie contre les loyers impayés ?',
    answer:
      'Une garantie loyers impayés peut être proposée en option, selon le dossier du locataire. Elle couvre généralement les impayés, les dégradations et les frais de procédure. Nous en étudions l’intérêt avec vous au moment du mandat.',
  },
  {
    question: 'Mon logement est classé F ou G : puis-je encore le louer ?',
    answer:
      'La loi interdit progressivement la mise en location des logements les plus énergivores. Les logements classés G sont concernés depuis 2025, les F le seront en 2028 et les E en 2034. Un bail en cours n’est pas rompu, mais le renouvellement et la relocation sont bloqués.',
    details: ['Nous établissons avec vous un plan de travaux chiffré et priorisé pour sortir du seuil.'],
  },
  {
    question: 'Puis-je récupérer mon bien pour l’habiter ou le vendre ?',
    answer:
      'Oui, en donnant congé au locataire dans les délais légaux et pour un motif prévu par la loi : reprise pour habiter, vente, ou motif légitime et sérieux. Nous préparons le congé et vérifions sa validité.',
  },
];

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Gestion locative' },
];
---

<Base
  title="Gestion locative à Mantes-la-Jolie"
  description="Loyers encaissés, locataires sélectionnés, travaux suivis : confiez votre bien à notre gestionnaire dédiée. Honoraires transparents, un interlocuteur unique."
  path="/gestion-locative/"
  crumbs={crumbs}
  schemas={[faqSchema(faq.map((f) => ({ question: f.question, answer: f.answer })))]}
>
  <PageHeader
    title={field('page.gestion', 'titre')}
    lede={field('page.gestion', 'chapo')}
    crumbs={crumbs}
    kicker="Gestion locative"
    image={visual}
    imageAlt="Remise des clés d’un logement géré par AUREA Immobilier"
  >
    <p class="cluster">
      <a class="btn" href="#contact">Confier mon bien</a>
      <a class="btn btn-outline" href="/honoraires/">Voir le barème</a>
    </p>
  </PageHeader>

  <!-- Prestations -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Le mandat</p>
          <h2>Ce que comprend notre gestion</h2>
        </div>
        <p class="lede">Tout ce qu’un propriétaire doit normalement faire lui-même, pris en charge de bout en bout.</p>
      </div>
      <ul class="included">
        {
          included.map(([title, body], i) => (
            <li>
              <span class="icon-pill">
                <Icon name={INCLUDED_ICONS[i % INCLUDED_ICONS.length]} />
              </span>
              <div>
                <h3>{title}</h3>
                {body && <p>{body}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Honoraires -->
  <section class="section section-alt">
    <div class="wrap fees">
      <div>
        <p class="kicker">Transparence</p>
        <h2>Nos honoraires de gestion</h2>
        {
          fees.length > 0 ? (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Prestation</th>
                    <th scope="col">Honoraires</th>
                  </tr>
                </thead>
                <tbody>
                  {fees.map(([label, amount]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      <td>{amount ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="lede">
              Le barème de gestion vous est communiqué sur simple demande, avec le détail des
              prestations incluses, avant toute signature.
            </p>
          )
        }
        <p class="small muted">
          Le barème complet de l’agence est publié sur la page{' '}
          <a href="/honoraires/">Barème des honoraires</a>. Les honoraires de gestion sont
          déductibles de vos revenus fonciers au régime réel.
        </p>
      </div>
      <ul class="reassure">
        <li><Icon name="check" size={18} /> Un seul interlocuteur, joignable en direct</li>
        <li><Icon name="check" size={18} /> Compte rendu de gestion régulier</li>
        <li><Icon name="check" size={18} /> Aucun frais caché : tout est écrit au mandat</li>
        <li><Icon name="check" size={18} /> Mandat résiliable dans les conditions prévues au contrat</li>
      </ul>
    </div>
  </section>

  <!-- DPE -->
  <section class="section">
    <div class="wrap dpe">
      <div>
        <p class="kicker">Réglementation</p>
        <h2>Location et performance énergétique : le calendrier</h2>
        <p>
          La loi interdit progressivement la mise en location des logements les plus énergivores.
          Si votre bien est classé E, F ou G, anticipez : les travaux conditionnent votre capacité
          à relouer.
        </p>
        <p class="small muted">
          Sources : <a href="https://www.legifrance.gouv.fr/" rel="noopener">Légifrance</a> et{' '}
          <a href="https://www.service-public.fr/" rel="noopener">service-public.fr</a>. Calendrier
          révisé à chaque évolution législative.
        </p>
        {
          recette && (
            <p class="notice">Recette : validation juridique du calendrier applicable à confirmer.</p>
          )
        }
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">À partir du</th>
              <th scope="col">Classe DPE</th>
              <th scope="col">Conséquence</th>
            </tr>
          </thead>
          <tbody>
            {
              dpeCalendar.map(([date, klass, effect]) => (
                <tr>
                  <td>{date}</td>
                  <td><strong>{klass}</strong></td>
                  <td>{effect}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Gestionnaire -->
  {
    manager && (
      <section class="section section-alt">
        <div class="wrap manager">
          <div>
            <p class="kicker">Votre interlocutrice</p>
            <h2>Une gestionnaire dédiée, pas un service anonyme</h2>
            <p class="lede">{field('page.gestion', 'gestionnaire')}</p>
            <p class="cluster">
              <a class="btn btn-navy" href="#contact">Lui décrire mon bien</a>
              <a class="btn btn-outline" href={`tel:${contact.phoneE164}`}>
                <Icon name="phone" size={18} /> <span class="tnum">{contact.phone}</span>
              </a>
            </p>
          </div>
          <AgentCard agent={manager} variant="row" sizes="6.5rem" />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap two-col">
      <Faq items={faq} title="Gestion locative : vos questions" />
      <LeadForm
        type="gestion"
        title="Confier mon bien en gestion"
        intro="Décrivez votre bien en quelques lignes : notre gestionnaire vous rappelle sous 48 h ouvrées."
      />
    </div>
  </section>

  <CtaBand
    title="Un bien à mettre en location ?"
    text="Nous évaluons le loyer de marché et le périmètre de gestion adapté à votre situation, sans engagement."
    primaryHref="#contact"
    primaryLabel="Demander une proposition"
    secondaryHref="/estimation/"
    secondaryLabel="Estimer plutôt pour vendre"
  />
</Base>

<style>
  .included {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .included li {
    display: flex;
    gap: 1rem;
    padding: 1.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .included h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
  }

  .included p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .fees,
  .dpe,
  .manager {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .fees {
      grid-template-columns: 1.4fr 1fr;
    }
    .dpe {
      grid-template-columns: 1fr 1.3fr;
      align-items: center;
    }
    .manager {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
    }
  }

  .fees .table-wrap {
    margin-bottom: var(--space-s);
  }

  .reassure {
    list-style: none;
    margin: 0;
    padding: 1.4rem 1.5rem;
    background: var(--navy-900);
    color: #fff;
    border-radius: var(--radius-m);
  }

  .reassure li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding-block: 0.55rem;
  }

  .reassure li + li {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .reassure svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--gold-300);
  }

  .two-col {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) 30rem;
    }
  }
</style>
