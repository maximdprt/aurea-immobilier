---
/** Estimation gratuite — formulaire multi-etapes (§7, §14). */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import EstimationForm from '~/components/EstimationForm.astro';
import Icon from '~/components/Icon.astro';
import Faq, { type FaqItem } from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { faqSchema } from '~/lib/schema';
import { field, fieldPairs, agency } from '~/lib/content';

const methods = fieldPairs('page.estimation', 'methodes');
const contact = agency();

const faq: FaqItem[] = [
  {
    question: 'L’estimation est-elle vraiment gratuite ?',
    answer:
      'Oui, et sans engagement. Un conseiller se déplace, relève les caractéristiques de votre bien et vous remet un avis de valeur écrit. Vous n’êtes pas tenu de nous confier la vente ensuite.',
  },
  {
    question: 'Quelle différence entre estimation en ligne et avis de valeur ?',
    answer:
      'Une estimation en ligne donne une fourchette indicative à partir de moyennes. Un avis de valeur repose sur une visite, l’état réel du bien, son exposition, son DPE et les ventes comparables : c’est ce document que nous produisons.',
  },
  {
    question: 'Combien de temps faut-il pour obtenir mon estimation ?',
    answer:
      'Nous vous rappelons sous 48 heures ouvrées pour fixer le rendez-vous. L’avis de valeur écrit vous est remis dans les jours qui suivent la visite.',
  },
  {
    question: 'Que se passe-t-il avec les informations que je transmets ?',
    answer:
      'Elles servent uniquement à préparer votre estimation, ne sont jamais cédées, et sont conservées trois ans après notre dernier échange. Vous pouvez demander leur suppression à tout moment.',
  },
];

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Estimation' },
];
---

<Base
  title="Estimation gratuite à Mantes-la-Jolie"
  description="Estimez votre maison ou appartement avec quatre méthodes croisées et un conseiller local. Avis de valeur écrit, gratuit et sans engagement, réponse sous 48 h."
  path="/estimation/"
  crumbs={crumbs}
  schemas={[faqSchema(faq.map((f) => ({ question: f.question, answer: f.answer })))]}
  noActionBar
>
  <PageHeader
    title={field('page.estimation', 'titre')}
    lede={field('page.estimation', 'chapo')}
    crumbs={crumbs}
    kicker="Estimation"
  />

  <div class="wrap section layout">
    <div class="main">
      <ul class="promises">
        <li><Icon name="check" size={18} /> Gratuit et sans engagement</li>
        <li><Icon name="check" size={18} /> Rappel sous 48 h ouvrées</li>
        <li><Icon name="check" size={18} /> Avis de valeur écrit, après visite</li>
      </ul>

      <section class="section-tight">
        <p class="kicker">Notre approche</p>
        <h2>Les quatre méthodes que nous croisons</h2>
        <ol class="methods">
          {
            methods.map(([name, body], i) => (
              <li>
                <span class="num" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{name}</h3>
                  {body && <p>{body}</p>}
                </div>
              </li>
            ))
          }
        </ol>
        <p class="small muted">
          Aucune décision n’est automatisée : la valeur est arrêtée par un conseiller après visite,
          jamais par un calcul à l’écran.
        </p>
      </section>

      <section class="section-tight">
        <Faq items={faq} title="L’estimation en pratique" />
      </section>

      <p class="call panel panel-cream">
        <Icon name="phone" size={20} />
        <span>
          Vous préférez en parler ? Appelez l’agence au{' '}
          <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a>, nous fixons le
          rendez-vous ensemble.
        </span>
      </p>
    </div>

    <aside class="form-col">
      <EstimationForm />
    </aside>
  </div>

  <CtaBand
    title="Une question avant de vous lancer ?"
    text="Un conseiller vous répond sur votre situation, votre bien et le marché de votre commune, sans engagement."
    primaryHref="/contact/"
    primaryLabel="Poser ma question"
    secondaryHref="/vendre/"
    secondaryLabel="Découvrir notre méthode de vente"
  />
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--space-xl);
  }

  .promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
    font-weight: 600;
    color: var(--navy-900);
  }

  .promises li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .promises svg {
    color: var(--gold-600);
  }

  .methods {
    list-style: none;
    margin: 0 0 var(--space-s);
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .methods li {
    display: flex;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--sand-50);
    border: 1px solid var(--sand-100);
    border-radius: var(--radius-m);
  }

  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
    color: var(--navy-900);
    font-weight: 700;
  }

  .methods h3 {
    margin: 0.2rem 0 0.25rem;
    font-size: 1.05rem;
  }

  .methods p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .call {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin: 0;
  }

  .call svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--gold-700);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 30rem;
      align-items: start;
    }
    .form-col {
      position: sticky;
      top: calc(var(--header-height) + 1rem);
    }
  }
</style>
