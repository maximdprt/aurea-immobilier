---
/**
 * Notre agence : qui nous sommes, ce que nous nous engageons a faire, qui
 * vous recevra, et ou nous trouver. Tous les textes viennent du registre
 * `page.agence.*`, modifiables dans le back-office.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Picture from '~/components/Picture.astro';
import Icon from '~/components/Icon.astro';
import AgentCard from '~/components/AgentCard.astro';
import PhoneReel from '~/components/PhoneReel.astro';
import CtaBand from '~/components/CtaBand.astro';
import { agentBySlug, agentMedia, allAgents, catalogStats, editorialMedia, logoMedia } from '~/lib/catalog';
import { COMPANY, MAP_EMBED_URL, REGULATED, SOCIAL } from '~/lib/site';
import { agency, field, fieldPairs, paragraphs } from '~/lib/content';

const stats = catalogStats();
const facade = editorialMedia('agence');
const vitrine = editorialMedia('vitrine') ?? facade;
const logo = logoMedia();
const contact = agency();

/**
 * Metiers partenaires annonces par l'agence sur son ancienne page « Notre
 * agence ». Les METIERS sont sources ; les noms des partenaires ne le sont
 * pas et ne sont donc pas affiches.
 */
const PARTNER_TRADES = [
  ['Courtiers en financement', 'euro'],
  ['Notaires', 'file'],
  ['Diagnostiqueurs', 'leaf'],
  ['Architectes', 'building'],
  ['Géomètres', 'compass'],
  ['Paysagistes', 'garden'],
] as const;

const ENGAGEMENT_ICONS = ['chart', 'camera', 'handshake', 'shield', 'star'] as const;
const engagements = fieldPairs('page.agence', 'engagements');
const histoire = paragraphs(field('page.agence', 'histoire'));

const direction = [agentBySlug('helene-vermeire-benz'), agentBySlug('vincent-maume')].filter(
  (a): a is NonNullable<typeof a> => Boolean(a)
);
const team = allAgents();
const instagram = SOCIAL.find((s) => s.label === 'Instagram');
const recette = import.meta.env.PUBLIC_RECETTE === '1';

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'L’agence' },
];
---

<Base
  title="AUREA Immobilier, agence indépendante à Mantes-la-Jolie"
  description="Agence immobilière indépendante créée en 2024 à Mantes-la-Jolie : la même exigence pour un studio que pour une maison, neuf conseillers joignables en direct."
  path="/agence/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.agence', 'titre')}
    crumbs={crumbs}
    kicker="Notre agence"
    lede={field('page.agence', 'chapo')}
    image={facade}
    imageAlt="L’intérieur de l’agence AUREA Immobilier, 44 rue Nationale à Mantes-la-Jolie"
  >
    <p class="cluster">
      <a class="btn btn-navy" href="/equipe/">Rencontrer l’équipe</a>
      <a class="btn btn-outline" href="/contact/">Nous contacter</a>
    </p>
  </PageHeader>

  <!-- Histoire -->
  <section class="section">
    <div class="wrap histoire">
      <div class="prose">
        <p class="kicker">Notre histoire</p>
        <h2>Une agence créée en 2024, pour faire les choses autrement</h2>
        {histoire.map((par) => <p>{par}</p>)}
        <p class="signature">« {field('site.identite', 'slogan')} »</p>
      </div>
      <dl class="stats side-stats">
        <div>
          <dd>2024</dd>
          <dt>création de l’agence, 44 rue Nationale</dt>
        </div>
        <div>
          <dd>{stats.archivedTotal}</dd>
          <dt>biens vendus ou loués depuis l’ouverture</dt>
        </div>
        <div>
          <dd>{stats.communes}</dd>
          <dt>communes où nous avons déjà accompagné une transaction</dt>
        </div>
        <div>
          <dd>{team.length}</dd>
          <dt>conseillers, chacun avec sa ligne directe</dt>
        </div>
      </dl>
    </div>
  </section>

  <!-- Engagements -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Nos engagements</p>
          <h2>Ce que vous pouvez attendre de nous</h2>
        </div>
        <p><a class="link-arrow" href="/vendre/">Notre méthode de vente</a></p>
      </div>
      <ul class="engagements">
        {
          engagements.map(([title, text], i) => (
            <li>
              <span class="icon-pill">
                <Icon name={ENGAGEMENT_ICONS[i % ENGAGEMENT_ICONS.length]} />
              </span>
              <h3>{title}</h3>
              {text && <p>{text}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Direction -->
  {
    direction.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">La direction</p>
              <h2>Deux fondateurs, une même exigence</h2>
            </div>
          </div>
          <ul class="direction">
            {direction.map((a) => (
              <li class="founder">
                <a class="founder-photo" href={`/equipe/${a.slug}/`} tabindex="-1" aria-hidden="true">
                  <Picture media={agentMedia(a.slug)} alt="" sizes="(min-width: 48rem) 16rem, 40vw" aspect="4 / 5" />
                </a>
                <div class="founder-text">
                  <h3>
                    <a href={`/equipe/${a.slug}/`}>{a.name}</a>
                  </h3>
                  <p class="role">{a.role}</p>
                  {a.bio && (
                    <blockquote>
                      {a.bio.split(/\n{2,}/).map((par) => (
                        <p>{par}</p>
                      ))}
                    </blockquote>
                  )}
                  <p>
                    <a class="link-arrow" href={`/equipe/${a.slug}/`}>
                      Sa page et ses biens
                    </a>
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Equipe -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">L’équipe</p>
          <h2>Les personnes que vous allez rencontrer</h2>
          <p class="lede">{field('page.agence', 'equipe_intro')}</p>
        </div>
        <p><a class="link-arrow" href="/equipe/">Toute l’équipe en détail</a></p>
      </div>
      <ul class="team-grid">
        {team.map((a) => <li><AgentCard agent={a} sizes="(min-width: 64rem) 14rem, 45vw" /></li>)}
      </ul>
    </div>
  </section>

  <!-- Nous trouver -->
  <section class="section">
    <div class="wrap trouver">
      <div>
        <p class="kicker">Nous trouver</p>
        <h2>Au cœur de Mantes-la-Jolie</h2>
        <address class="coords">
          <p>
            <Icon name="pin" size={20} />
            <span>
              <strong>{COMPANY.name}</strong><br />
              {contact.street}<br />
              {contact.postalCode} {contact.city}
            </span>
          </p>
          <p>
            <Icon name="phone" size={20} />
            <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a>
          </p>
          <p>
            <Icon name="mail" size={20} />
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </address>
        <h3 class="hours-title"><Icon name="clock" size={18} /> Horaires d’ouverture</h3>
        <ul class="hours">
          {contact.hours.map((h) => <li>{h}</li>)}
        </ul>
        <p class="cluster">
          <a class="btn btn-navy" href="/contact/">Prendre rendez-vous</a>
        </p>
      </div>

      <div class="map-col">
        <div class="map-facade" data-map-facade>
          {vitrine && <Picture media={vitrine} alt="" aspect="4 / 3" sizes="(min-width: 64rem) 34rem, 92vw" class="map-photo" />}
          <div class="map-overlay">
            <p class="small">
              La carte Google n’est chargée qu’après votre clic : aucun traceur tiers n’est déposé
              à l’ouverture de la page.
            </p>
            <button type="button" class="btn btn-light" data-load-map={MAP_EMBED_URL}>
              <Icon name="pin" size={18} /> Afficher le plan d’accès
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partenaires -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Nos partenaires</p>
          <h2>Les métiers réunis autour de votre projet</h2>
          <p class="lede">{field('page.agence', 'partenaires_intro')}</p>
        </div>
      </div>
      <ul class="partners">
        {
          PARTNER_TRADES.map(([trade, icon]) => (
            <li>
              <span class="icon-pill icon-pill-navy"><Icon name={icon} size={20} /></span>
              <span>{trade}</span>
            </li>
          ))
        }
      </ul>
      {
        recette && (
          <p class="notice">
            Recette : les noms des partenaires et leur accord écrit restent à fournir avant de les
            citer nommément.
          </p>
        )
      }
    </div>
  </section>

  <!-- Reseaux -->
  <section class="section">
    <div class="wrap reseaux">
      <PhoneReel
        poster={facade}
        alt="L’équipe d’AUREA Immobilier dans les bureaux de l’agence"
        href={instagram?.url}
        place={`${contact.street}, ${contact.city.toUpperCase()}`}
        watermark={logo}
        caption="La vidéo s’ouvre sur notre compte : rien n’est chargé avant votre clic."
      />
      <div class="reseaux-text">
        <p class="kicker">Nous suivre</p>
        <h2>Les nouveautés avant leur mise en ligne</h2>
        <p>
          Nous publions les nouveaux biens, les coulisses des visites et les ventes conclues sur
          nos deux comptes. C’est le moyen le plus rapide de voir un bien avant qu’il n’apparaisse
          sur les portails.
        </p>
        <ul class="social-list">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" target="_blank" class="btn btn-outline">
                  <Icon name={s.label === 'Instagram' ? 'instagram' : 'tiktok'} size={18} />
                  {s.label} <span class="muted">{s.handle}</span>
                  <span class="visually-hidden"> (nouvel onglet)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          <a class="link-arrow" href="/alerte/">Ou recevez les nouveautés par email</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Informations legales -->
  <section class="section-tight section-alt">
    <div class="wrap">
      <details class="legal-box">
        <summary>
          <span><Icon name="shield" size={18} /> Informations légales et professionnelles</span>
          <Icon name="chevron" size={18} class="chev" />
        </summary>
        <dl class="legal">
          <div><dt>Raison sociale</dt><dd>{COMPANY.legalName}, {COMPANY.legalForm} au capital de {COMPANY.capital}</dd></div>
          <div><dt>SIRET de l’agence</dt><dd>{COMPANY.agencySiret}</dd></div>
          <div><dt>RCS</dt><dd>{COMPANY.rcs} — {COMPANY.rcsCity}</dd></div>
          <div><dt>TVA intracommunautaire</dt><dd>{COMPANY.vatId}</dd></div>
          <div><dt>Carte professionnelle</dt><dd>{REGULATED.cpiNumber}, délivrée par la {REGULATED.cpiIssuer}</dd></div>
          <div><dt>Assurance RCP</dt><dd>{REGULATED.insurer}, police n° {REGULATED.insurancePolicy}</dd></div>
          <div><dt>Agence</dt><dd>{contact.street}, {contact.postalCode} {contact.city}</dd></div>
          <div><dt>Siège social</dt><dd>{COMPANY.headOffice}</dd></div>
          <div><dt>Présidente</dt><dd>{COMPANY.president}</dd></div>
        </dl>
        <p class="small">
          <a href="/mentions-legales/">Mentions légales complètes</a> · <a href="/honoraires/">Barème des honoraires</a>
        </p>
      </details>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* --- Histoire ------------------------------------------------------------ */
  .histoire {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .histoire {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .signature {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--gold-700);
  }

  .side-stats {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
  }

  .side-stats div {
    padding: var(--space-m);
    background: var(--sand-50);
    border: 1px solid var(--sand-100);
    border-radius: var(--radius-m);
  }

  /* --- Engagements --------------------------------------------------------- */
  .engagements {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .engagements li {
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .engagements h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.05rem;
  }

  .engagements p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* --- Direction ------------------------------------------------------------ */
  .direction {
    display: grid;
    gap: var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 64rem) {
    .direction {
      grid-template-columns: 1fr 1fr;
    }
  }

  .founder {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  @media (min-width: 40rem) {
    .founder {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .founder-photo :global(img) {
    border-radius: var(--radius-s);
    object-position: center top;
  }

  .founder h3 {
    margin: 0 0 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .founder h3 a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .founder .role {
    margin: 0 0 var(--space-s);
    color: var(--gold-700);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .founder blockquote {
    margin: 0 0 var(--space-s);
    padding-left: var(--space-s);
    border-left: 3px solid var(--gold-300);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .founder blockquote p {
    margin: 0 0 0.6rem;
  }

  .founder-text > p:last-child {
    margin: 0;
  }

  /* --- Equipe --------------------------------------------------------------- */
  .team-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Nous trouver --------------------------------------------------------- */
  .trouver {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .trouver {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .coords {
    font-style: normal;
    margin-bottom: var(--space-m);
  }

  .coords p {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0 0 0.75rem;
  }

  .coords svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--gold-600);
  }

  .coords a {
    font-weight: 600;
    text-decoration: none;
  }

  .hours-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }

  .hours {
    list-style: none;
    margin: 0 0 var(--space-m);
    padding: 0;
    color: var(--ink-soft);
  }

  .hours li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .map-facade {
    position: relative;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--navy-900);
    aspect-ratio: 4 / 3;
  }

  .map-facade :global(.map-photo),
  .map-facade :global(.map-photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-s);
    padding: var(--space-m);
    text-align: center;
    background: rgb(0 19 42 / 0.6);
    color: #fff;
  }

  .map-overlay p {
    margin: 0;
    max-width: 34ch;
    color: rgb(255 255 255 / 0.85);
  }

  .map-overlay .btn {
    justify-self: center;
  }

  .map-facade :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* --- Partenaires ---------------------------------------------------------- */
  .partners {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partners li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-weight: 600;
    color: var(--navy-900);
  }

  .partners .icon-pill {
    width: 2.5rem;
    height: 2.5rem;
  }

  .notice {
    margin-top: var(--space-m);
  }

  /* --- Reseaux -------------------------------------------------------------- */
  .reseaux {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .reseaux {
      grid-template-columns: auto 1fr;
    }
  }

  .reseaux-text p {
    color: var(--ink-soft);
  }

  .social-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin: var(--space-s) 0 var(--space-m);
    padding: 0;
  }

  /* --- Legal ---------------------------------------------------------------- */
  .legal-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .legal-box summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    font-weight: 600;
    color: var(--navy-900);
    cursor: pointer;
    list-style: none;
  }

  .legal-box summary::-webkit-details-marker {
    display: none;
  }

  .legal-box summary span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legal-box summary :global(.chev) {
    transition: transform var(--dur) var(--ease-out);
  }

  .legal-box[open] summary :global(.chev) {
    transform: rotate(180deg);
  }

  .legal {
    margin: 0;
    padding: 0 1.2rem;
    font-size: var(--step--1);
  }

  .legal > div {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr;
    gap: var(--space-2xs);
    padding-block: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .legal dt {
    color: var(--ink-muted);
  }

  .legal dd {
    margin: 0;
  }

  .legal-box > p {
    margin: 0;
    padding: 0.75rem 1.2rem 1rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-load-map]').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const box = btn.closest<HTMLElement>('[data-map-facade]');
        const url = btn.dataset.loadMap;
        if (!box || !url) return;
        const f = document.createElement('iframe');
        f.src = url;
        f.title = 'Plan d’accès à l’agence, 44 rue Nationale, Mantes-la-Jolie';
        f.loading = 'lazy';
        f.referrerPolicy = 'no-referrer-when-downgrade';
        f.allowFullscreen = true;
        box.replaceChildren(f);
      },
      { once: true }
    );
  });
</script>
