---
/**
 * Liste des biens a louer, et passerelle vers la gestion locative pour les
 * proprietaires.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ListingResults from '~/components/ListingResults.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { activeListings } from '~/lib/catalog';
import { field } from '~/lib/content';

const listings = activeListings('location');
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Louer', href: '/louer/' },
];
---

<Base
  title="Biens à louer à Mantes-la-Jolie et Mantois"
  description="Appartements et maisons à louer dans le Mantois par AUREA Immobilier. Loyer charges comprises, dépôt de garantie et honoraires affichés sur chaque annonce."
  path="/louer/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.louer', 'titre')}
    lede={field('page.louer', 'chapo')}
    crumbs={crumbs}
    kicker="Louer"
  >
    <p class="cluster">
      <span class="badge badge-gold">
        {listings.length} location{listings.length > 1 ? 's' : ''} disponible{listings.length > 1 ? 's' : ''}
      </span>
      <a class="btn btn-outline btn-sm" href="/acheter/">Voir plutôt les biens à vendre</a>
    </p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <ListingResults
        listings={listings}
        emptyMessage="Aucun bien à louer pour le moment. Créez une alerte pour être prévenu dès qu’un bien correspond à vos critères."
      />
    </div>
  </section>

  <section class="section-tight section-alt">
    <div class="wrap two">
      <div class="box">
        <span class="icon-pill"><Icon name="bell" /></span>
        <h2>Être prévenu des prochaines locations</h2>
        <p>
          Les locations partent vite. Dites-nous vos critères et recevez un email dès qu’un bien y
          correspond, sans compte à créer.
        </p>
        <a class="btn btn-navy" href="/alerte/">Créer une alerte</a>
      </div>
      <div class="box">
        <span class="icon-pill icon-pill-navy"><Icon name="key" /></span>
        <h2>Vous êtes propriétaire ?</h2>
        <p>
          Recherche du locataire, bail, états des lieux, loyers encaissés et travaux suivis : notre
          gestionnaire s’occupe de tout, avec un seul interlocuteur.
        </p>
        <a class="btn btn-outline" href="/gestion-locative/">Découvrir la gestion locative</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Une question sur une location ?"
    text="Un conseiller vous répond sous 24 h ouvrées : disponibilité, pièces à fournir, visite."
    primaryHref="/contact/"
    primaryLabel="Nous écrire"
    secondaryHref="/gestion-locative/"
    secondaryLabel="Confier mon bien"
  />
</Base>

<style>
  .two {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 48rem) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-m) var(--space-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .box h2 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    margin: var(--space-s) 0 0.35rem;
  }

  .box p {
    color: var(--ink-soft);
    margin-bottom: var(--space-m);
  }

  .box .btn {
    margin-top: auto;
  }
</style>
