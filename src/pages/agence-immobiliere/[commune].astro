---
/**
 * Page commune — « agence immobilière à [Commune] ».
 *
 * Regle anti doorway page du brief (§8) : cette page n'existe QUE si l'agence a
 * une presence reelle dans la commune — au moins un bien actif, ou au moins
 * deux ventes realisees. Le filtre est applique par `communesWithPage()`.
 *
 * Chaque page est reellement unique : le contenu est construit a partir des
 * biens, des ventes et du conseiller referent propres a la commune. Ce qui
 * n'est pas connu (prix DVF, quartiers) n'est pas affiche.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ListingResults from '~/components/ListingResults.astro';
import Faq, { type FaqItem } from '~/components/Faq.astro';
import AgentCard from '~/components/AgentCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import {
  agentBySlug,
  archivedByCommune,
  communesWithPage,
  listingsByCommune,
  typeCommunePagesFor,
} from '~/lib/catalog';
import { area, composeDescription, composeTitle, plural, propertyTypeLabel } from '~/lib/format';
import { faqSchema } from '~/lib/schema';
import { agency } from '~/lib/content';
import type { Commune } from '~/lib/types';

export function getStaticPaths() {
  return communesWithPage().map((commune) => ({
    params: { commune: commune.slug },
    props: { commune },
  }));
}

interface Props {
  commune: Commune;
}
const { commune } = Astro.props;
const contact = agency();

const listings = listingsByCommune(commune.slug);
const active = listings.filter((l) => l.status === 'published' || l.status === 'under_offer');
const soldHere = listings.filter((l) => l.status === 'sold' || l.status === 'rented');
const archived = archivedByCommune(commune.name);
const totalSold = soldHere.length + archived.length;

// Conseiller referent : celui qui a traite le plus de biens dans la commune
const agentCounts = new Map<string, number>();
for (const l of listings) {
  if (l.agentSlug) agentCounts.set(l.agentSlug, (agentCounts.get(l.agentSlug) ?? 0) + 1);
}
const refSlug = [...agentCounts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
const referent = refSlug ? agentBySlug(refSlug) : undefined;

// Typologie reellement traitee dans la commune, pour un contenu non generique
const typeCounts = new Map<string, number>();
for (const l of [...listings, ...archived]) {
  typeCounts.set(l.propertyType, (typeCounts.get(l.propertyType) ?? 0) + 1);
}
const typology = [...typeCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([t, n]) => `${n} ${propertyTypeLabel(t as never).toLowerCase()}${n > 1 ? 's' : ''}`);

const areas = [...listings, ...archived]
  .map((l) => ('livingArea' in l ? l.livingArea : l.area))
  .filter((v): v is number => typeof v === 'number' && v > 0);
const medianArea = areas.length ? [...areas].sort((a, b) => a - b)[Math.floor(areas.length / 2)] : null;

const typePages = typeCommunePagesFor(commune.slug);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Nos communes', href: '/plan-du-site/' },
  { label: commune.name },
];

const faq: FaqItem[] = [
  {
    question: `AUREA Immobilier intervient-elle à ${commune.name} ?`,
    answer: `Oui. Notre agence, installée à Mantes-la-Jolie, a accompagné ${plural(totalSold, 'transaction')} à ${commune.name}${active.length ? ` et y propose actuellement ${plural(active.length, 'bien')}` : ''}. ${referent ? `${referent.name} suit ce secteur.` : ''}`,
  },
  {
    question: `Quel est le prix au m² à ${commune.name} ?`,
    answer:
      'Les prix de marché fiables sont ceux des ventes réellement enregistrées par l’administration fiscale, publiés dans la base DVF. Un conseiller vous donne, sur rendez-vous, les ventes comparables récentes du secteur pour situer votre bien.',
    details: [
      'Une estimation fiable ne se déduit pas d’un prix moyen : elle tient compte de l’état, de l’étage, de l’exposition et du DPE.',
    ],
  },
  {
    question: `Comment faire estimer un bien à ${commune.name} ?`,
    answer: `Demandez une estimation depuis le site ou appelez le ${contact.phone}. Un conseiller se déplace, relève les caractéristiques du bien, croise quatre méthodes de valorisation et vous remet un avis de valeur écrit, gratuit et sans engagement.`,
  },
];

const title = `Agence immobilière à ${commune.name}${commune.postalCode ? ` (${commune.postalCode})` : ''}`;
const pageTitle =
  composeTitle(title).length <= 65 ? composeTitle(title) : composeTitle(`Agence immobilière à ${commune.name}`);
const description = composeDescription([
  `Vendre, acheter ou louer à ${commune.name} avec AUREA Immobilier, agence installée à Mantes-la-Jolie.`,
  `${totalSold} transaction${totalSold > 1 ? 's' : ''} déjà réalisée${totalSold > 1 ? 's' : ''} dans la commune.`,
  active.length > 0 ? `${active.length} bien${active.length > 1 ? 's' : ''} disponible${active.length > 1 ? 's' : ''}.` : null,
  'Estimation gratuite.',
  'Conseiller dédié au secteur.',
]);

const lede =
  `AUREA Immobilier accompagne vendeurs, acquéreurs et bailleurs à ${commune.name}. Depuis la création de l’agence, nous y avons mené ${plural(totalSold, 'transaction')}` +
  (typology.length > 0 ? ` (${typology.slice(0, 3).join(', ')})` : '') +
  '.' +
  (active.length > 0
    ? ` ${plural(active.length, 'bien est', 'biens sont')} actuellement disponible${active.length > 1 ? 's' : ''}.`
    : ' Aucun bien n’est disponible dans cette commune en ce moment : créez une alerte pour être prévenu.');
---

<Base
  title={pageTitle}
  brand={false}
  description={description}
  path={`/agence-immobiliere/${commune.slug}/`}
  crumbs={crumbs}
  schemas={[faqSchema(faq.map((f) => ({ question: f.question, answer: f.answer })))]}
>
  <PageHeader title={title} lede={lede} crumbs={crumbs} kicker="Notre secteur">
    <p class="cluster">
      <a class="btn" href="/estimation/">Estimer mon bien à {commune.name}</a>
      {active.length === 0 && <a class="btn btn-outline" href="/alerte/">Créer une alerte</a>}
    </p>
  </PageHeader>

  {
    active.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">Disponibles</p>
              <h2>Nos biens à {commune.name}</h2>
            </div>
          </div>
          <ListingResults listings={active} showFilters={false} />
          {typePages.length > 0 && (
            <p class="type-links">
              Voir aussi :{' '}
              {typePages.map((p, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={`/acheter/${p.type}-${p.commune.slug}/`}>
                    {p.type === 'maison' ? 'Maisons' : 'Appartements'} à vendre à {commune.name}
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      </section>
    )
  }

  <section class="section section-alt">
    <div class="wrap market">
      <div>
        <p class="kicker">Notre activité</p>
        <h2>AUREA à {commune.name}, en chiffres</h2>
        <dl class="stats">
          <div>
            <dd>{totalSold}</dd>
            <dt>transactions réalisées par AUREA</dt>
          </div>
          <div>
            <dd>{active.length}</dd>
            <dt>bien{active.length > 1 ? 's' : ''} actuellement proposé{active.length > 1 ? 's' : ''}</dt>
          </div>
          {
            medianArea && (
              <div>
                <dd>{area(medianArea)}</dd>
                <dt>surface médiane des biens traités</dt>
              </div>
            )
          }
        </dl>
        <p class="small muted">
          Pour les prix de marché de la commune, nous nous appuyons sur les ventes réellement
          enregistrées (base DVF, direction générale des finances publiques), consultables sur{' '}
          <a href="https://app.dvf.etalab.gouv.fr/" rel="noopener">app.dvf.etalab.gouv.fr</a>. Nous ne
          publions aucun prix que nous ne pouvons pas sourcer.
        </p>
      </div>

      {
        referent && (
          <div class="referent">
            <p class="kicker">Votre conseiller sur le secteur</p>
            <AgentCard agent={referent} variant="row" sizes="120px" />
            <p class="small muted">
              {plural(agentCounts.get(referent.slug) ?? 0, 'bien suivi', 'biens suivis')} à {commune.name}.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    totalSold > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">Réussites</p>
              <h2>Vendu ou loué à {commune.name}</h2>
            </div>
            <p>
              <a class="link-arrow" href="/biens-vendus/">
                Toutes nos réussites
              </a>
            </p>
          </div>
          <ul class="sold">
            {[...soldHere, ...archived].slice(0, 12).map((l) => (
              <li>
                <span class="badge badge-sold">{l.status === 'sold' ? 'Vendu' : 'Loué'}</span>
                <span class="sold-title">
                  {'slug' in l ? <a href={`/bien/${l.slug}/`}>{l.title}</a> : l.title}
                </span>
                {'area' in l && l.area ? (
                  <span class="small muted">
                    <Icon name="ruler" size={14} /> {area(l.area)}
                  </span>
                ) : null}
                {'livingArea' in l && l.livingArea ? (
                  <span class="small muted">
                    <Icon name="ruler" size={14} /> {area(l.livingArea)}
                  </span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section-alt">
    <div class="wrap">
      <Faq items={faq} title={`Immobilier à ${commune.name} : vos questions`} />
    </div>
  </section>

  <CtaBand
    title={`Un projet à ${commune.name} ?`}
    text="Estimation gratuite, recherche personnalisée ou mise en gestion : un conseiller qui connaît le secteur vous répond sous 24 h ouvrées."
  />
</Base>

<style>
  .type-links {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }

  .market {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .market {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .market .stats {
    margin: var(--space-m) 0;
  }

  .referent :global(.agent-card) {
    margin-bottom: var(--space-s);
  }

  .sold {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .sold li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.8rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }

  .sold-title {
    flex: 1 1 14rem;
  }

  .sold .small {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
