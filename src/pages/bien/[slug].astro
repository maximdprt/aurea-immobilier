---
/**
 * Fiche bien.
 *
 * Applique le §8 du brief : un seul H1 (type + pieces + surface + commune),
 * resume factuel en haut (c'est ce que les moteurs generatifs extraient),
 * DPE/GES avec depenses energetiques, mention ERP + Georisques, honoraires et
 * leur charge, bloc quartier, conseiller, biens similaires.
 *
 * Cycle de vie : un bien vendu reste en ligne avec le statut « Vendu » — il
 * conserve ses liens entrants et sert de preuve sociale — mais passe en
 * `noindex`. Jamais de 404 en masse.
 */
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Gallery from '~/components/Gallery.astro';
import Picture from '~/components/Picture.astro';
import Icon from '~/components/Icon.astro';
import type { IconName } from '~/components/Icon.astro';
import EnergyLabel from '~/components/EnergyLabel.astro';
import ListingCard from '~/components/ListingCard.astro';
import LeadForm from '~/components/LeadForm.astro';
import CtaBand from '~/components/CtaBand.astro';
import {
  allListings,
  listingMedia,
  agentBySlug,
  agentMedia,
  communeBySlug,
  hasCommunePage,
  similarListings,
} from '~/lib/catalog';
import {
  area,
  clampDescription,
  composeTitle,
  descriptionBlocks,
  feesPayerLabel,
  frDate,
  isEnergySieve,
  listingHeading,
  money,
  plural,
  priceLine,
  pricePerSqm,
  propertyTypeLabel,
  statusLabel,
  stripContacts,
  toE164,
} from '~/lib/format';
import { listingSchema } from '~/lib/schema';
import { agency } from '~/lib/content';
import type { Listing } from '~/lib/types';

export function getStaticPaths() {
  return allListings().map((listing) => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
}

interface Props {
  listing: Listing;
}
const { listing } = Astro.props;

const contact = agency();
const media = listingMedia(listing.reference);
const agent = listing.agentSlug ? agentBySlug(listing.agentSlug) : undefined;
const agentTel = toE164(agent?.phone);
const commune = listing.communeSlug ? communeBySlug(listing.communeSlug) : undefined;
const communeHasPage = hasCommunePage(listing.communeSlug);
const similar = similarListings(listing);
const heading = listingHeading(listing);
const archived = listing.status === 'sold' || listing.status === 'rented';
const description = stripContacts(listing.description);
const blocks = descriptionBlocks(description);
const sqm = pricePerSqm(listing);

const crumbs = [
  { label: 'Accueil', href: '/' },
  listing.transaction === 'location'
    ? { label: 'Louer', href: '/louer/' }
    : { label: 'Acheter', href: '/acheter/' },
  ...(commune
    ? [
        {
          label: commune.name,
          href: communeHasPage ? `/agence-immobiliere/${commune.slug}/` : undefined,
        },
      ]
    : []),
  { label: `Réf. ${listing.reference}` },
];

/** Faits structures avec icone : c'est ce bloc que les IA extraient en priorite (§8). */
type Fact = { icon: IconName; label: string; value: string };
const facts: Fact[] = [];
const add = (icon: IconName, label: string, value: string | null | undefined) => {
  if (value) facts.push({ icon, label, value });
};
add('home', 'Type', propertyTypeLabel(listing.propertyType));
add('ruler', 'Surface habitable', listing.livingArea ? area(listing.livingArea) : null);
add('garden', 'Terrain', listing.landArea ? area(listing.landArea) : null);
add('door', 'Pièces', listing.rooms ? String(listing.rooms) : null);
add('bed', 'Chambres', listing.bedrooms ? String(listing.bedrooms) : null);
add('layers', 'Salles d’eau', listing.bathrooms ? String(listing.bathrooms) : null);
add(
  'building',
  'Étage',
  listing.floor != null
    ? listing.floor === 0
      ? 'Rez-de-chaussée'
      : `${listing.floor}${listing.floors ? ` sur ${listing.floors}` : ''}`
    : null
);
add('calendar', 'Année de construction', listing.yearBuilt ? String(listing.yearBuilt) : null);
add('sun', 'Exposition', listing.exposure);
add('leaf', 'Chauffage', listing.heating);
add('sparkle', 'État général', listing.condition);
add('elevator', 'Ascenseur', listing.hasElevator ? 'Oui' : null);
add('garden', 'Jardin', listing.hasGarden && !listing.landArea ? 'Oui' : null);
add('key', 'Cave', listing.cellars ? plural(listing.cellars, 'cave') : null);
add('train', 'Transports', listing.transitAccess);
add('euro', 'Taxe foncière', listing.propertyTax ? `${money(listing.propertyTax)} / an` : null);
add(
  'building',
  'Copropriété',
  listing.isCondo && listing.condoLots ? plural(listing.condoLots, 'lot') : listing.isCondo ? 'Oui' : null
);
add(
  'euro',
  'Charges de copropriété',
  listing.condoAnnualCharges ? `${money(listing.condoAnnualCharges)} / an` : null
);
add('chart', 'Prix au m²', sqm ? `${money(sqm)} / m²` : null);

const title = `${heading}${archived ? ` — ${statusLabel(listing)}` : ''}`;
const metaDescription = clampDescription(
  `${heading}. ${listing.price ? priceLine(listing) + '. ' : ''}${description.replace(/\n/g, ' ')}`
);
const fees = feesPayerLabel(listing.feesPayer);
---

<Base
  title={composeTitle(heading)}
  brand={false}
  description={metaDescription}
  path={`/bien/${listing.slug}/`}
  crumbs={crumbs}
  image={media?.og ?? null}
  noindex={archived}
  ogType="article"
  schemas={[listingSchema(listing, media?.og ?? null)]}
>
  <article class="listing">
    <div class="wrap">
      <Breadcrumb crumbs={crumbs} />

      {
        archived && (
          <p class="archived-note">
            <Icon name="check" size={18} />
            <span>
              Ce bien a été {listing.status === 'sold' ? 'vendu' : 'loué'} par AUREA Immobilier. La
              page reste en ligne à titre de référence.{' '}
              <a href={listing.transaction === 'location' ? '/louer/' : '/acheter/'}>
                Voir les biens disponibles
              </a>
              .
            </span>
          </p>
        )
      }

      <header class="head">
        <div class="head-text">
          <p class="cluster badges">
            <span class:list={['badge', archived ? 'badge-sold' : 'badge-navy']}>{statusLabel(listing)}</span>
            {listing.isExclusive && !archived && <span class="badge badge-gold">Exclusivité</span>}
            <span class="small muted">Réf. {listing.reference}</span>
          </p>
          <h1>{title}</h1>
          {
            commune && (
              <p class="place">
                <Icon name="pin" size={17} />
                {commune.name}
                {commune.postalCode && ` (${commune.postalCode})`}
              </p>
            )
          }
        </div>
        <div class="head-price">
          <p class="price tnum">{priceLine(listing)}</p>
          {
            fees && (
              <p class="small muted fees">
                {fees}
                {listing.transaction === 'vente' && ', prix affiché honoraires inclus'}.{' '}
                <a href="/honoraires/">Voir le barème</a>
              </p>
            )
          }
        </div>
      </header>

      <Gallery media={media} heading={heading} />

      <div class="columns">
        <div class="main">
          <section class="facts-block" aria-labelledby="caracteristiques">
            <h2 id="caracteristiques">Caractéristiques</h2>
            <ul class="facts-grid">
              {
                facts.map((f) => (
                  <li>
                    <span class="icon-pill icon-pill-navy"><Icon name={f.icon} size={20} /></span>
                    <span class="f-label">{f.label}</span>
                    <span class="f-value">{f.value}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          {
            listing.transaction === 'location' && (
              <section class="rent" aria-labelledby="loyer">
                <h2 id="loyer">Détail du loyer</h2>
                <div class="table-wrap">
                  <table>
                    <tbody>
                      {listing.rentBase && (
                        <tr>
                          <th scope="row">Loyer hors charges</th>
                          <td>{money(listing.rentBase)} / mois</td>
                        </tr>
                      )}
                      {listing.rentCharges && (
                        <tr>
                          <th scope="row">Provision sur charges</th>
                          <td>{money(listing.rentCharges)} / mois</td>
                        </tr>
                      )}
                      {listing.rentTotal && (
                        <tr>
                          <th scope="row">Loyer charges comprises</th>
                          <td>
                            <strong>{money(listing.rentTotal)} / mois</strong>
                          </td>
                        </tr>
                      )}
                      {listing.tenantFees && (
                        <tr>
                          <th scope="row">Honoraires à la charge du locataire</th>
                          <td>{money(listing.tenantFees)}</td>
                        </tr>
                      )}
                      {/* La loi ALUR impose d'afficher la part « etat des lieux » separement. */}
                      {listing.inventoryFees && (
                        <tr>
                          <th scope="row">dont établissement de l’état des lieux</th>
                          <td>{money(listing.inventoryFees)}</td>
                        </tr>
                      )}
                      {listing.deposit && (
                        <tr>
                          <th scope="row">Dépôt de garantie</th>
                          <td>{money(listing.deposit)}</td>
                        </tr>
                      )}
                      <tr>
                        <th scope="row">Encadrement des loyers</th>
                        <td>{listing.rentControlled ? 'Oui' : 'Non'}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>
            )
          }

          {
            blocks.length > 0 && (
              <section class="description" aria-labelledby="description">
                <h2 id="description">Description</h2>
                <div class="prose">
                  {blocks.map((b) =>
                    b.type === 'heading' ? (
                      <h3>{b.text}</h3>
                    ) : b.type === 'list' ? (
                      <ul>{b.items?.map((i) => <li>{i}</li>)}</ul>
                    ) : (
                      <p>{b.text}</p>
                    )
                  )}
                </div>
              </section>
            )
          }

          <section class="diagnostics" aria-labelledby="diagnostics">
            <h2 id="diagnostics">Diagnostics énergétiques</h2>
            <div class="energy-grid">
              <EnergyLabel kind="dpe" value={listing.dpeClass} amount={listing.dpeValue} unit="kWh/m²/an" />
              <EnergyLabel kind="ges" value={listing.gesClass} amount={listing.gesValue} unit="kg CO₂/m²/an" />
            </div>

            {
              listing.energyCostMin && listing.energyCostMax && (
                <p class="energy-cost">
                  <strong>Dépenses annuelles d’énergie estimées :</strong> entre{' '}
                  {money(listing.energyCostMin)} et {money(listing.energyCostMax)} par an pour un
                  usage standard, abonnement compris, prix indexés sur les années 2021, 2022 et 2023.
                </p>
              )
            }

            {
              isEnergySieve(listing.dpeClass) && (
                <p class="notice">
                  Logement classé {listing.dpeClass}. La loi encadre la mise en location des
                  logements les plus énergivores selon un calendrier progressif :{' '}
                  <a href="/guides/dpe-location-obligations-proprietaires/">voir le calendrier applicable</a>.
                </p>
              )
            }

            <p class="small muted diag-meta">
              {listing.dpeDate && <span>Diagnostic établi le {frDate(listing.dpeDate)}. </span>}
              {
                listing.erp && (
                  <span>
                    Bien soumis à un état des risques et pollutions (ERP)
                    {listing.erpDate && ` établi le ${frDate(listing.erpDate)}`}. Informations sur{' '}
                    <a href="https://www.georisques.gouv.fr/" rel="noopener">georisques.gouv.fr</a>.
                  </span>
                )
              }
            </p>
          </section>

          {
            commune && (
              <section class="quartier" aria-labelledby="quartier">
                <h2 id="quartier">Le secteur</h2>
                <p>
                  Ce bien se situe à {commune.name}
                  {commune.postalCode && ` (${commune.postalCode})`}
                  {listing.transitAccess && `, ${listing.transitAccess.toLowerCase()}`}. AUREA
                  Immobilier y a déjà accompagné {plural(commune.soldCount, 'transaction')}.
                </p>
                {communeHasPage && (
                  <p>
                    <a class="link-arrow" href={`/agence-immobiliere/${commune.slug}/`}>
                      Notre page sur {commune.name}
                    </a>
                  </p>
                )}
              </section>
            )
          }
        </div>

        <aside class="side">
          <div class="side-inner">
            <section class="contact-card">
              {
                agent && (
                  <div class="advisor">
                    <Picture
                      media={agentMedia(agent.slug)}
                      alt={`Portrait de ${agent.name}`}
                      sizes="72px"
                      aspect="1"
                      class="advisor-photo"
                    />
                    <div>
                      <p class="advisor-kicker">Votre conseiller</p>
                      <p class="advisor-name">
                        <a href={`/equipe/${agent.slug}/`}>{agent.name}</a>
                      </p>
                      <p class="small muted">{agent.role}</p>
                    </div>
                  </div>
                )
              }
              <div class="contact-actions">
                <a href="#contact" class="btn btn-navy">
                  <Icon name="mail" size={18} /> {archived ? 'Nous écrire' : 'Demander une visite'}
                </a>
                <button type="button" class="btn btn-outline" data-reveal-phone={agentTel ?? contact.phoneE164}>
                  <Icon name="phone" size={18} /> Voir le numéro
                </button>
              </div>
              <p class="agency small muted">
                <Icon name="pin" size={15} />
                <span>
                  AUREA Immobilier · {contact.street}, {contact.postalCode} {contact.city}
                </span>
              </p>
            </section>

            <LeadForm
              type="visite"
              reference={listing.reference}
              title={archived ? 'Un bien similaire ?' : 'Demander une visite'}
              intro={
                archived
                  ? 'Dites-nous ce que vous cherchez : nous vous proposons les biens comparables du moment.'
                  : `Votre message part directement au conseiller en charge de la référence ${listing.reference}.`
              }
              message={archived ? '' : `Bonjour, je souhaite visiter le bien réf. ${listing.reference}.`}
              compact
            />
          </div>
        </aside>
      </div>

      {
        similar.length > 0 && (
          <section class="similar">
            <div class="section-head">
              <div>
                <p class="kicker">À voir aussi</p>
                <h2>Biens similaires</h2>
              </div>
              <p>
                <a class="link-arrow" href={listing.transaction === 'location' ? '/louer/' : '/acheter/'}>
                  Tous les biens
                </a>
              </p>
            </div>
            <div class="grid-cards">
              {similar.map((l) => (
                <ListingCard listing={l} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <CtaBand
    title="Vous avez un bien à vendre dans ce secteur ?"
    text="Nos acquéreurs cherchent activement. Une estimation gratuite et argumentée sous 48 h."
  />
</Base>

<style>
  .listing {
    padding-block: var(--space-m) var(--space-xl);
  }

  .archived-note {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: var(--space-s) 0 0;
    padding: var(--space-s) var(--space-m);
    background: var(--sand-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    font-size: var(--step--1);
  }

  .archived-note svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--gold-700);
  }

  .head {
    display: grid;
    gap: var(--space-s) var(--space-l);
    align-items: end;
    margin: var(--space-m) 0;
  }

  @media (min-width: 48rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .head-price {
      text-align: right;
    }
  }

  .badges {
    margin-bottom: var(--space-2xs);
  }

  .head h1 {
    font-size: var(--step-3);
    margin-bottom: var(--space-2xs);
  }

  .place {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .place svg {
    color: var(--gold-600);
  }

  .price {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    color: var(--navy-900);
    margin: 0 0 var(--space-3xs);
  }

  .fees {
    margin: 0;
    max-width: 24rem;
  }

  @media (min-width: 48rem) {
    .fees {
      margin-left: auto;
    }
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-l);
  }

  .main > section + section {
    margin-top: var(--space-xl);
  }

  .main h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-m);
  }

  /* --- Faits cles ---------------------------------------------------------- */
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .facts-grid li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--sand-50);
    border: 1px solid var(--sand-100);
    border-radius: var(--radius-m);
  }

  .facts-grid .icon-pill {
    grid-row: 1 / span 2;
    width: 2.5rem;
    height: 2.5rem;
  }

  .f-label {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .f-value {
    font-weight: 600;
    color: var(--navy-900);
    font-size: var(--step--1);
  }

  /* --- Diagnostics ----------------------------------------------------------- */
  .energy-grid {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-s);
  }

  .energy-cost {
    padding: var(--space-s) var(--space-m);
    background: var(--sand-50);
    border-radius: var(--radius-s);
    font-size: var(--step--1);
  }

  .diag-meta {
    margin: var(--space-s) 0 0;
  }

  .diag-meta:empty {
    display: none;
  }

  /* --- Colonne laterale ------------------------------------------------------- */
  .contact-card {
    padding: var(--space-m);
    margin-bottom: var(--space-m);
    background: var(--navy-900);
    color: #fff;
    border-radius: var(--radius-m);
  }

  .advisor {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: var(--space-m);
  }

  .advisor :global(.advisor-photo img) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: center top;
    border: 2px solid var(--gold-400);
  }

  .advisor p {
    margin: 0;
  }

  .advisor-kicker {
    font-size: 0.78rem;
    color: var(--gold-300);
    font-weight: 600;
  }

  .advisor-name {
    font-weight: 600;
    font-size: var(--step-1);
  }

  .advisor-name a {
    color: #fff;
    text-decoration: none;
  }

  .advisor-name a:hover {
    text-decoration: underline;
  }

  .advisor .muted {
    color: rgb(255 255 255 / 0.7);
  }

  .contact-actions {
    display: grid;
    gap: 0.5rem;
  }

  .contact-actions .btn-outline {
    --btn-fg: #fff;
    --btn-border: rgb(255 255 255 / 0.45);
  }

  .contact-actions .btn-outline:hover,
  .contact-actions .btn-outline:focus-visible {
    --btn-bg: rgb(255 255 255 / 0.1);
    --btn-border: #fff;
  }

  .contact-actions .btn-navy {
    --btn-bg: var(--gold-400);
    --btn-fg: var(--navy-900);
    --btn-border: var(--gold-400);
  }

  .contact-actions .btn-navy:hover,
  .contact-actions .btn-navy:focus-visible {
    --btn-bg: var(--gold-500);
    --btn-border: var(--gold-500);
  }

  .agency {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    margin: var(--space-s) 0 0;
    color: rgb(255 255 255 / 0.7) !important;
  }

  .agency svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--gold-300);
  }

  .similar {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr) 24rem;
    }

    .side-inner {
      position: sticky;
      top: calc(var(--header-height) + 1rem);
    }

    .energy-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  /* « Voir le numero » : le numero n'apparait qu'au clic, puis le bouton
     devient un lien d'appel. */
  document.querySelectorAll<HTMLButtonElement>('[data-reveal-phone]').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const tel = btn.dataset.revealPhone ?? '';
        const a = document.createElement('a');
        a.className = btn.className;
        a.href = `tel:${tel}`;
        a.textContent = tel.replace(/^\+33/, '0').replace(/(\d{2})(?=\d)/g, '$1 ').trim();
        btn.replaceWith(a);
        a.focus();
      },
      { once: true }
    );
  });
</script>
