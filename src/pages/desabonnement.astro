---
/**
 * Page de désinscription, ouverte depuis le lien d'un email d'alerte.
 *
 * Elle n'agit PAS au chargement. Les messageries visitent les liens qu'elles
 * reçoivent pour les inspecter ; une désinscription déclenchée par un simple
 * GET partirait donc toute seule, sans clic de personne. La page affiche un
 * bouton, et c'est lui qui appelle /api/alerte-desabonnement/.
 *
 * Deux états : le formulaire (jeton en main), puis le résultat (`?etat=`),
 * après la redirection de la route.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';
import { agency } from '~/lib/content';

export const prerender = false;

const contact = agency();
const params = Astro.url.searchParams;
const state = params.get('etat');
const token = params.get('jeton') ?? '';

/** `formulaire` tant qu'aucune action n'a eu lieu. */
const view =
  state === 'ok' || state === 'panne' || state === 'invalide'
    ? state
    : token && token.length <= 64
      ? 'formulaire'
      : 'invalide';

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Désinscription' },
];

const TITLES: Record<string, string> = {
  formulaire: 'Ne plus recevoir nos alertes',
  ok: 'Vous êtes désinscrit',
  invalide: 'Ce lien n’est plus valable',
  panne: 'Désinscription impossible pour le moment',
};
---

<Base
  title="Désinscription des alertes"
  description="Ne plus recevoir les alertes nouveautés d’AUREA Immobilier."
  path="/desabonnement/"
  crumbs={crumbs}
  noindex
  noActionBar
>
  <PageHeader title={TITLES[view]} crumbs={crumbs} kicker="Alerte nouveautés" width="narrow" />

  <div class="wrap-narrow section">
    <div class="result">
      <span class:list={['mark', view === 'ok' && 'is-ok']}>
        <Icon name={view === 'ok' ? 'check' : view === 'formulaire' ? 'bell' : 'info'} size={26} />
      </span>

      {
        view === 'formulaire' && (
          <>
            <p class="lede">
              Un clic sur ce bouton et nous cessons de vous écrire. Votre adresse et vos critères
              sont effacés de nos serveurs, pas seulement désactivés.
            </p>
            <form method="post" action="/api/alerte-desabonnement/">
              <input type="hidden" name="jeton" value={token} />
              <p class="cluster">
                <button class="btn btn-navy" type="submit">Confirmer ma désinscription</button>
                <a class="btn btn-outline" href="/">Annuler</a>
              </p>
            </form>
          </>
        )
      }

      {
        view === 'ok' && (
          <>
            <p class="lede">C’est fait. Vous ne recevrez plus d’alerte, et votre adresse a été effacée.</p>
            <p>
              Vous pourrez toujours revenir : la page d’alerte reste ouverte, et nos biens disponibles
              sont consultables sans inscription.
            </p>
            <p class="cluster">
              <a class="btn" href="/acheter/">Voir les biens disponibles</a>
              <a class="btn btn-outline" href="/">Retour à l’accueil</a>
            </p>
          </>
        )
      }

      {
        view === 'invalide' && (
          <>
            <p class="lede">Ce lien de désinscription est incomplet ou n’est plus valable.</p>
            <p>
              Si vous vous êtes déjà désinscrit, il n’y a rien à faire : nous ne vous écrivons plus.
              Sinon, utilisez le lien présent au bas du dernier email reçu, ou écrivez-nous à{' '}
              <a href={`mailto:${contact.email}`}>{contact.email}</a> et nous nous en chargeons.
            </p>
            <p class="cluster">
              <a class="btn btn-outline" href="/">Retour à l’accueil</a>
            </p>
          </>
        )
      }

      {
        view === 'panne' && (
          <>
            <p class="lede">Nous ne parvenons pas à traiter votre désinscription pour le moment.</p>
            <p>
              Réessayez dans quelques minutes. Si cela persiste, écrivez-nous à{' '}
              <a href={`mailto:${contact.email}`}>{contact.email}</a> ou appelez le{' '}
              <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a> : nous
              supprimerons votre inscription nous-mêmes.
            </p>
          </>
        )
      }
    </div>
  </div>
</Base>

<style>
  .result {
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .mark {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--space-s);
    border-radius: var(--radius-pill);
    background: var(--gold-100);
    color: var(--gold-700);
  }

  .mark.is-ok {
    background: var(--ok-bg);
    color: var(--ok);
  }

  .cluster {
    margin-top: var(--space-m);
    margin-bottom: 0;
  }
</style>
