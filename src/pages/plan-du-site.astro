---
/**
 * Plan du site : toutes les pages publiées, par rubrique.
 *
 * L'inventaire de recette (état de la reprise, informations manquantes) qui
 * vivait ici a migré dans le tableau de bord du back-office : un visiteur n'a
 * pas à le voir.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { activeListings, allAgents, communesWithPage } from '~/lib/catalog';
import { NAV, FOOTER_LEGAL, FOOTER_SERVICES } from '~/lib/site';
import { allNews } from '~/lib/news';
import { listingHeading } from '~/lib/format';

const communes = communesWithPage();
const agents = allAgents();
const guides = await getCollection('guides', ({ data }) => !data.draft);
const news = allNews();

const main = NAV.flatMap((n) => (n.children ? n.children.map((c) => ({ href: c.href, label: c.label })) : [n]));
const seen = new Set<string>();
const mainLinks = [...main, ...FOOTER_SERVICES, { href: '/contact/', label: 'Contact' }].filter((l) => {
  if (seen.has(l.href)) return false;
  seen.add(l.href);
  return true;
});

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Plan du site' },
];
---

<Base
  title="Plan du site – AUREA Immobilier"
  description="Toutes les pages du site AUREA Immobilier : biens à vendre et à louer, communes couvertes, équipe, guides, barème des honoraires et informations légales."
  path="/plan-du-site/"
  crumbs={crumbs}
>
  <PageHeader
    title="Plan du site"
    lede="L’ensemble des pages publiées, rubrique par rubrique."
    crumbs={crumbs}
  />

  <div class="wrap section">
    <div class="cols">
      <section>
        <h2>Le site</h2>
        <ul>
          <li><a href="/">Accueil</a></li>
          {mainLinks.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/selection/">Ma sélection</a></li>
        </ul>
      </section>

      <section>
        <h2>Nos communes</h2>
        <ul class="two-col">
          {
            communes.map((c) => (
              <li>
                <a href={`/agence-immobiliere/${c.slug}/`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>L’équipe</h2>
        <ul>
          {agents.map((a) => <li><a href={`/equipe/${a.slug}/`}>{a.name}</a></li>)}
        </ul>
      </section>

      <section>
        <h2>Biens à vendre</h2>
        <ul>
          {
            activeListings('vente').map((l) => (
              <li>
                <a href={`/bien/${l.slug}/`}>{listingHeading(l)}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Biens à louer</h2>
        {
          activeListings('location').length > 0 ? (
            <ul>
              {activeListings('location').map((l) => (
                <li>
                  <a href={`/bien/${l.slug}/`}>{listingHeading(l)}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="small muted">Aucun bien à louer pour le moment.</p>
          )
        }
      </section>

      <section>
        <h2>Guides</h2>
        <ul>
          {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
        </ul>
      </section>

      {
        news.length > 0 && (
          <section>
            <h2>Actualités</h2>
            <ul>
              {news.map((n) => (
                <li>
                  <a href={`/actualites/${n.slug}/`}>{n.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2>Informations légales</h2>
        <ul>
          {FOOTER_LEGAL.filter((l) => l.href !== '/plan-du-site/').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .cols {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .cols h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--gold-300);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  .cols li + li {
    margin-top: 0.35rem;
  }

  .cols a {
    text-decoration: none;
  }

  .cols a:hover {
    text-decoration: underline;
  }

  .two-col {
    columns: 2;
    column-gap: var(--space-s);
  }
</style>
