---
/**
 * Plan du site.
 *
 * Sert aussi de tableau de bord de recette : il expose l'inventaire réel du
 * catalogue, l'état de la reprise du scraping, et la liste des informations
 * qui manquent encore (§19). Rien n'est caché à l'agence.
 */
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import {
  activeListings,
  allAgents,
  allCommunes,
  catalogStats,
  communesWithPage,
  findDuplicates,
} from '~/lib/catalog';
import { MISSING_INFO, NAV, FOOTER_LEGAL } from '~/lib/site';
import report from '~/data/scraping-report.json';
import redirects from '~/data/redirects.json';

const stats = catalogStats();
const communes = communesWithPage();
const agents = allAgents();
const guides = await getCollection('guides', ({ data }) => !data.draft);
const duplicates = findDuplicates();

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Plan du site' },
];
---

<Base
  title="Plan du site – AUREA Immobilier"
  description="Toutes les pages du site AUREA Immobilier : biens à vendre et à louer, communes couvertes, équipe, guides, barème des honoraires et informations légales."
  path="/plan-du-site/"
  crumbs={crumbs}
>
  <Breadcrumb crumbs={crumbs} />

  <div class="wrap section">
    <header class="head">
      <h1>Plan du site</h1>
      <p class="lede">L’ensemble des pages publiées, et l’état de la reprise des données.</p>
    </header>

    <div class="cols">
      <section>
        <h2>Nos services</h2>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/biens-vendus/">Nos réussites</a></li>
          <li><a href="/avis/">Avis clients</a></li>
          <li><a href="/prix-immobilier-mantes-la-jolie/">Prix immobilier à Mantes-la-Jolie</a></li>
          <li><a href="/equipe/">L’équipe</a></li>
          <li><a href="/guides/">Guides</a></li>
        </ul>
      </section>

      <section>
        <h2>Nos communes</h2>
        <ul class="two-col">
          {
            communes.map((c) => (
              <li>
                <a href={`/agence-immobiliere/${c.slug}/`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>L’équipe</h2>
        <ul>
          {agents.map((a) => <li><a href={`/equipe/${a.slug}/`}>{a.name}</a></li>)}
        </ul>
      </section>

      <section>
        <h2>Guides</h2>
        <ul>
          {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
        </ul>
      </section>

      <section>
        <h2>Biens à vendre</h2>
        <ul>
          {
            activeListings('vente').map((l) => (
              <li>
                <a href={`/bien/${l.slug}/`}>{l.title}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Biens à louer</h2>
        <ul>
          {
            activeListings('location').map((l) => (
              <li>
                <a href={`/bien/${l.slug}/`}>{l.title}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Informations légales</h2>
        <ul>
          {FOOTER_LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </section>
    </div>

    <hr />

    <section class="recette">
      <h2>État de la reprise des données</h2>
      <p class="small muted">
        Section destinée à l’agence pendant la recette. Elle sera retirée à la mise en ligne
        définitive.
      </p>

      <dl class="facts">
        <div><dt>Biens actifs</dt><dd>{stats.active}</dd></div>
        <div><dt>Dont à vendre</dt><dd>{stats.forSale}</dd></div>
        <div><dt>Dont à louer</dt><dd>{stats.forRent}</dd></div>
        <div><dt>Fiches complètes reprises</dt><dd>{report.listings}</dd></div>
        <div><dt>Biens archivés reconstitués</dt><dd>{stats.archivedKnown}</dd></div>
        <div><dt>Portefeuille archivé annoncé</dt><dd>{stats.archivedTotal}</dd></div>
        <div><dt>Communes avec page dédiée</dt><dd>{communes.length} sur {allCommunes().length}</dd></div>
        <div><dt>Photos rattachées</dt><dd>{report.photos}</dd></div>
        <div><dt>Redirections 301 en place</dt><dd>{redirects.length}</dd></div>
        <div><dt>Doublons détectés</dt><dd>{duplicates.length}</dd></div>
      </dl>

      <h3>Limites connues du corpus repris</h3>
      <ul>
        {report.gaps.map((gap) => <li>{gap}</li>)}
      </ul>

      {
        duplicates.length > 0 && (
          <>
            <h3>Doublons probables à arbitrer</h3>
            <ul>
              {duplicates.map((group) => (
                <li>
                  {group.map((l) => `réf. ${l.reference}`).join(' et ')} — même commune, même type,
                  surface et prix quasi identiques
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h3>Informations à fournir avant la mise en ligne</h3>
      {
        Object.entries(MISSING_INFO).map(([section, items]) => (
          <>
            <h4>{section}</h4>
            <ul>
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .head {
    margin-bottom: var(--space-l);
  }

  .cols {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .cols h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 650;
    padding-bottom: var(--space-3xs);
    border-bottom: 2px solid var(--gold-200);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  .cols li + li {
    margin-top: 0.3rem;
  }

  .two-col {
    columns: 2;
    column-gap: var(--space-s);
  }

  .recette {
    background: var(--canvas-alt);
    padding: var(--space-m);
    border-radius: var(--radius-m);
  }

  .recette h2 {
    font-size: var(--step-2);
  }

  .recette h3 {
    margin-top: var(--space-m);
  }

  .recette h4 {
    margin-top: var(--space-s);
    color: var(--ink-muted);
  }

  .recette ul {
    padding-left: 1.1rem;
    list-style: disc;
  }

  .recette li {
    margin-bottom: 0.2rem;
  }

  .facts {
    margin-bottom: var(--space-m);
  }
</style>
