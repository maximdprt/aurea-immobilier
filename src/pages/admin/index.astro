---
/**
 * Vue d'ensemble du back-office : les rubriques, l'état de la mise en ligne,
 * et ce qui manque encore — côté contenu (à faire ici) et côté configuration
 * (à transmettre à la personne qui déploie).
 */
import AdminContenu from '~/layouts/AdminContenu.astro';
import { hasAdminSession } from '~/lib/server/admin-code';
import { AdminDataError, adminDataReady, countDocs, readAgents, readListings } from '~/lib/server/admin-data';
import { readNews } from '~/lib/server/admin-news';
import { readReviews } from '~/lib/server/admin-reviews';
import { readAssets } from '~/lib/server/admin-media';
import { configChecklist, contentChecklist } from '~/lib/server/admin-checklist';
import { deployConfigured, publishMessage, type PublishResult } from '~/lib/server/publish';
import { MISSING_INFO } from '~/lib/site';

export const prerender = false;

if (!(await hasAdminSession(Astro.cookies))) {
  return Astro.redirect('/admin/code/', 302);
}

const publication = Astro.url.searchParams.get('publication') as PublishResult | null;

let counts = { agents: 0, listings: 0, blocs: 0, news: 0, reviews: 0, medias: 0 };
let dataError: string | null = null;
let checklist: Awaited<ReturnType<typeof contentChecklist>> = [];

if (adminDataReady()) {
  try {
    const [a, l, n, news, reviews, assets, check] = await Promise.all([
      readAgents(),
      readListings(),
      countDocs(),
      readNews(),
      readReviews(),
      readAssets(),
      contentChecklist(),
    ]);
    counts = { agents: a.length, listings: l.length, blocs: n, news: news.length, reviews: reviews.length, medias: assets.size };
    checklist = check;
  } catch (error) {
    dataError = error instanceof AdminDataError ? error.message : 'Lecture impossible.';
    if (error instanceof AdminDataError && error.internal) console.warn('[admin]', error.internal);
  }
} else {
  dataError =
    'La base n’est pas configurée : renseignez SUPABASE_SECRET_KEY_CONTENT pour lire et modifier le contenu.';
}

const config = configChecklist();

const TILES = [
  { href: '/admin/accueil/', name: 'Page d’accueil', body: 'Titre du bandeau, trois entrées, arguments, étapes, bandeau final.', count: 'Textes' },
  { href: '/admin/textes/', name: 'Textes des pages', body: 'Agence, vendre, estimation, gestion, contact, alerte, réussites…', count: `${counts.blocs} bloc${counts.blocs > 1 ? 's' : ''} personnalisé${counts.blocs > 1 ? 's' : ''}` },
  { href: '/admin/medias/', name: 'Photos & visuels', body: 'Grande photo d’accueil, photos de l’agence, portraits, photos des biens.', count: `${counts.medias} visuel${counts.medias > 1 ? 's' : ''} importé${counts.medias > 1 ? 's' : ''}` },
  { href: '/admin/actualites/', name: 'Actualités', body: 'Rédigez et publiez les nouvelles de l’agence.', count: `${counts.news} article${counts.news > 1 ? 's' : ''}` },
  { href: '/admin/equipe/', name: 'Équipe', body: 'Rôle, ligne directe, email, présentation et ordre d’affichage.', count: `${counts.agents} fiche${counts.agents > 1 ? 's' : ''}` },
  { href: '/admin/biens/', name: 'Biens', body: 'Titre, prix, description et statut des annonces.', count: `${counts.listings} annonce${counts.listings > 1 ? 's' : ''}` },
  { href: '/admin/avis/', name: 'Avis clients', body: 'Note Google et avis copiés depuis votre fiche.', count: `${counts.reviews} avis` },
  { href: '/admin/coordonnees/', name: 'Coordonnées & horaires', body: 'Téléphone, adresse, email et horaires d’ouverture.', count: 'NAP' },
  { href: '/admin/honoraires/', name: 'Honoraires', body: 'Le barème affiché : vente, location et gestion.', count: 'Barème' },
];
---

<AdminContenu
  title="Vue d’ensemble"
  section="tableau"
  heading="Le contenu du site"
  intro="Chaque rubrique correspond à une partie du site public. Une modification enregistrée part en ligne en une à deux minutes, le temps que le site se reconstruise — sans toucher au code."
>
  {publication && <p class:list={['bo-notice', publication === 'lance' ? 'ok' : 'warn']} role="status">{publishMessage(publication).replace('Enregistré. ', '')}</p>}
  <p class:list={['bo-notice', deployConfigured() ? 'ok' : 'warn']}>
    {
      deployConfigured()
        ? 'Mise en ligne automatique active : chaque enregistrement relance la publication du site.'
        : 'Mise en ligne automatique inactive (VERCEL_DEPLOY_HOOK_URL absente). Vos modifications sont enregistrées, mais n’apparaîtront en ligne qu’au prochain déploiement.'
    }
  </p>
  {dataError && <p class="bo-notice ko">{dataError}</p>}

  <ul class="bo-cards">
    {
      TILES.map((t) => (
        <li class="bo-tile">
          <h3><a href={t.href}>{t.name}</a></h3>
          <p>{t.body}</p>
          <p class="foot"><span>{t.count}</span><span class="go">Modifier →</span></p>
        </li>
      ))
    }
  </ul>

  <div class="two">
    <section class="bo-card">
      <div class="bo-card-head"><h2>À compléter dans ce back-office</h2></div>
      {
        checklist.length ? (
          <ul class="bo-check-list">
            {checklist.map((c) => (
              <li>
                <span class:list={['mark', c.done && 'done']}>{c.done ? '✓' : '!'}</span>
                <div>
                  <strong>{c.href && !c.done ? <a href={c.href}>{c.label}</a> : c.label}</strong>
                  <span>{c.detail}</span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="bo-hint">Liste indisponible tant que la base n’est pas configurée.</p>
        )
      }
    </section>

    <section class="bo-card">
      <div class="bo-card-head"><h2>Configuration technique</h2></div>
      <p class="bo-card-intro">
        À transmettre à la personne qui gère l’hébergement (Vercel). Chaque variable manquante
        désactive la fonction indiquée, sans casser le reste du site.
      </p>
      <ul class="bo-check-list">
        {
          config.map((c) => (
            <li>
              <span class:list={['mark', c.done && 'done']}>{c.done ? '✓' : '!'}</span>
              <div>
                <strong>{c.label}</strong>
                <span>{c.detail}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="bo-card">
    <div class="bo-card-head"><h2>Informations à fournir avant la mise en ligne définitive</h2></div>
    <p class="bo-card-intro">
      Ces éléments ne figuraient pas sur l’ancien site et ne peuvent pas être inventés. Le site
      public n’affiche rien à leur place ; ils apparaîtront dès qu’ils seront communiqués.
    </p>
    <div class="missing">
      {
        Object.entries(MISSING_INFO).map(([section, items]) => (
          <div>
            <h3>{section}</h3>
            <ul>
              {items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</AdminContenu>

<style>
  .two {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: start;
  }

  .missing {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .missing h3 {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    color: #475569;
  }

  .missing ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 13.5px;
    color: #334155;
  }

  .missing li {
    margin-bottom: 4px;
  }
</style>
