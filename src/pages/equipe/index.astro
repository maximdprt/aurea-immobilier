---
import { toE164 } from '~/lib/format';
/**
 * L'equipe. Principal levier E-E-A-T du site (§8) : des personnes reelles,
 * nommees, avec une page dediee et un rattachement `Person -> worksFor`.
 */
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Picture from '~/components/Picture.astro';
import Todo from '~/components/Todo.astro';
import { allAgents, agentMedia, listingsByAgent } from '~/lib/catalog';

const agents = allAgents();
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'L’équipe' },
];
---

<Base
  title="L’équipe d’AUREA Immobilier à Mantes-la-Jolie"
  description="Les conseillers AUREA Immobilier : direction, négociateurs et gestion locative. Un interlocuteur identifié du premier contact à la signature."
  path="/equipe/"
  crumbs={crumbs}
>
  <div class="page-band">
    <div class="wrap">
      <Breadcrumb crumbs={crumbs} />
      <h1>L’équipe AUREA Immobilier</h1>
    </div>
  </div>
  <div class="border-header" aria-hidden="true"></div>

  <div class="wrap section">
    <header class="head">
      <p class="lede">
        Neuf professionnels, un bureau au 44 rue Nationale à Mantes-la-Jolie, et un principe
        simple : vous avez un interlocuteur, il connaît votre dossier.
      </p>
    </header>

    <ul class="team">
      {
        agents.map((a) => {
          const count = listingsByAgent(a.slug).length;
          return (
            <li class="card">
              <a class="photo" href={`/equipe/${a.slug}/`} tabindex="-1" aria-hidden="true">
                <Picture
                  media={agentMedia(a.slug)}
                  alt=""
                  sizes="(min-width: 48rem) 14rem, 45vw"
                  aspect="1"
                />
              </a>
              <div class="body">
                <h2><a href={`/equipe/${a.slug}/`}>{a.name}</a></h2>
                <p class="role small muted">{a.role}</p>
                {
                  toE164(a.phone) && (
                    <p class="small">
                      <a class="tel" href={`tel:${toE164(a.phone)}`}>{a.phone}</a>
                    </p>
                  )
                }
                {count > 0 && (
                  <p class="small muted">{count} bien{count > 1 ? 's' : ''} suivi{count > 1 ? 's' : ''}</p>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="note small muted">
      Zachary Denat apparaît dans la description d’un bien sans page dédiée sur l’ancien site :
      son rôle reste à confirmer (<Todo label="rôle exact de Zachary Denat" />).
    </p>
  </div>
</Base>

<style>
  .head {
    margin-bottom: var(--space-l);
  }

  .team {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .photo :global(img) {
    border-radius: var(--radius-m) var(--radius-m) 0 0;
  }

  .body {
    padding: var(--space-s);
  }

  .body h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 650;
    margin-bottom: 0.1rem;
  }

  .body h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .body h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .body p {
    margin: 0;
  }

  .note {
    margin-top: var(--space-l);
  }

  .tel {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Cartes de l'equipe, style .membre_equipe du site d'origine. */
  .card {
    background-color: #ffffff;
    box-shadow: 0 3px 15px rgb(0 0 0 / 16%);
    padding: 20px;
    text-align: center;
  }

  .card h2 {
    color: var(--color-1);
    font-weight: 700;
    font-size: 22px;
  }

  .card h2 a {
    text-decoration: none;
  }

  .card .role {
    color: var(--color-2-darken);
    font-weight: 700;
    font-size: 18px;
  }
</style>
