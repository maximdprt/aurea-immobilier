---
/**
 * L'equipe. Principal levier E-E-A-T du site (§8) : des personnes reelles,
 * nommees, avec une page dediee.
 *
 * Deux formats : les personnes qui ont ecrit une presentation ont une carte
 * large avec son debut ; les autres une carte courte. Quand la presentation
 * manque, on n'affiche RIEN a la place : le format court est la reponse au
 * manque, pas un texte de remplacement.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import AgentCard from '~/components/AgentCard.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import { allAgents } from '~/lib/catalog';
import { agency, field } from '~/lib/content';

const agents = allAgents();
/* L'ordre du catalogue est conserve dans chaque groupe : direction d'abord. */
const avecBio = agents.filter((a) => a.bio);
const sansBio = agents.filter((a) => !a.bio);
const contact = agency();

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'L’équipe' },
];
---

<Base
  title="L’équipe d’AUREA Immobilier à Mantes-la-Jolie"
  description="Les conseillers AUREA Immobilier : direction, négociateurs et gestion locative. Un interlocuteur identifié, joignable en direct, du premier contact à la signature."
  path="/equipe/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.equipe', 'titre')}
    crumbs={crumbs}
    kicker="L’équipe"
    lede={field('page.equipe', 'chapo')}
  >
    <p class="cluster">
      <a class="btn btn-navy" href={`tel:${contact.phoneE164}`}>
        <Icon name="phone" size={18} /> {contact.phone}
      </a>
      <a class="btn btn-outline" href="/contact/">Écrire à l’agence</a>
    </p>
  </PageHeader>

  {
    avecBio.length > 0 && (
      <section class="section">
        <div class="wrap">
          <p class="kicker">La direction</p>
          <h2>Ceux qui ont fondé l’agence</h2>
          <ul class="team-large">
            {avecBio.map((a) => (
              <li>
                <AgentCard agent={a} withBio sizes="(min-width: 64rem) 22rem, 92vw" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    sansBio.length > 0 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">Les conseillers</p>
              <h2>Une ligne directe pour chaque dossier</h2>
              <p class="lede">
                Vous parlez à la personne qui suit votre projet, pas à un standard. Chaque
                conseiller connaît le secteur, ses biens et vos échanges précédents.
              </p>
            </div>
          </div>
          <ul class="team-small">
            {sansBio.map((a) => (
              <li>
                <AgentCard agent={a} sizes="(min-width: 64rem) 16rem, 45vw" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Un projet, une question ?"
    text="Appelez directement le conseiller de votre choix, ou écrivez à l’agence : nous vous répondons sous 24 h ouvrées."
    primaryHref="/contact/"
    primaryLabel="Écrire à l’agence"
    secondaryHref="/estimation/"
    secondaryLabel="Demander une estimation"
  />
</Base>

<style>
  .team-large,
  .team-small {
    display: grid;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team-large {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .team-small {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
</style>
