---
/**
 * Avis clients.
 *
 * Les avis sont saisis dans le back-office, copies mot pour mot depuis Google
 * (§13), et la note Google n'est affichee que si l'agence l'a renseignee. Sans
 * donnees, la page le dit honnetement au lieu d'afficher des cases vides.
 *
 * Aucun balisage Review / AggregateRating : consigne explicite du §12.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Reviews from '~/components/Reviews.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import { allReviews, googleRating } from '~/lib/reviews';
import { field } from '~/lib/content';

const reviews = allReviews();
const rating = googleRating();
const hasContent = reviews.length > 0 || rating !== null;
/* Le lien vers la fiche peut exister meme sans note saisie. */
const rawUrl = field('agence.avis', 'url_fiche');
const googleUrl = /^https?:\/\//.test(rawUrl) ? rawUrl : null;

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Avis clients' },
];
---

<Base
  title="Avis clients sur AUREA Immobilier à Mantes-la-Jolie"
  description="Ce que disent les vendeurs, acquéreurs et locataires accompagnés par AUREA Immobilier. Avis publiés sur Google et reproduits sans modification."
  path="/avis/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.avis', 'titre')}
    crumbs={crumbs}
    kicker="Avis clients"
    lede={field('page.avis', 'chapo')}
  />

  <section class="section">
    <div class="wrap">
      {
        hasContent ? (
          <Reviews title="Les avis de nos clients" />
        ) : (
          <div class="empty">
            <span class="icon-pill"><Icon name="star" /></span>
            <h2>Les avis Google seront affichés ici prochainement</h2>
            <p>
              Nous reprendrons ici, mot pour mot, les avis publiés sur notre fiche Google. En
              attendant, vous pouvez les consulter directement sur Google, ou nous demander les
              coordonnées de clients accompagnés récemment.
            </p>
            <p class="cluster">
              {googleUrl && (
                <a class="btn btn-navy" href={googleUrl} rel="noopener" target="_blank">
                  Voir notre fiche Google <span class="visually-hidden">(nouvel onglet)</span>
                </a>
              )}
              <a class="btn btn-outline" href="/biens-vendus/">Voir nos réussites</a>
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-narrow prose">
      <p class="kicker">Transparence</p>
      <h2>Pourquoi ces avis n’affichent pas d’étoiles dans Google</h2>
      <p>
        Les consignes de Google considèrent comme auto-promotionnels les avis qu’une entreprise
        affiche sur son propre site, y compris lorsqu’ils proviennent de sa fiche Google. Les
        baliser pour obtenir des étoiles dans les résultats de recherche expose à une sanction sur
        l’ensemble du domaine. Nous les publions donc en texte, sans balisage, et nous renvoyons
        vers la fiche Google pour la note officielle.
      </p>
      <p>
        Chaque avis est reproduit tel qu’il a été écrit, sans correction ni coupe, et mentionne
        le conseiller concerné quand l’auteur le cite.
      </p>
    </div>
  </section>

  <CtaBand
    title="Vous avez été accompagné par AUREA ?"
    text="Votre retour aide les prochains vendeurs et acquéreurs à choisir en confiance. Un avis prend deux minutes."
    primaryHref={rating?.reviewUrl ?? rating?.profileUrl ?? '/contact/'}
    primaryLabel={rating?.reviewUrl || rating?.profileUrl ? 'Laisser un avis sur Google' : 'Nous écrire'}
    secondaryHref="/estimation/"
    secondaryLabel="Demander une estimation"
  />
</Base>

<style>
  .empty {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-l);
    text-align: center;
    background: var(--sand-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
  }

  .empty .icon-pill {
    margin-bottom: var(--space-s);
  }

  .empty h2 {
    font-size: var(--step-2);
  }

  .empty p {
    color: var(--ink-soft);
  }

  .empty .cluster {
    justify-content: center;
    margin: var(--space-m) 0 0;
  }
</style>
