---
/**
 * Index des guides — le pilier GEO du site (§11).
 * L'ancien /catalog/news.php ne contenait que 212 mots : tout est neuf.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { agentBySlug } from '~/lib/catalog';
import { frDate } from '~/lib/format';
import { field } from '~/lib/content';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);

const CLUSTERS: Record<string, string> = {
  prix: 'Prix et estimation',
  vendre: 'Vendre',
  acheter: 'Acheter',
  louer: 'Louer',
  gestion: 'Gestion locative',
  'vivre-ici': 'Vivre dans le Mantois',
};

const byCluster = Object.entries(CLUSTERS)
  .map(([key, label]) => ({
    key,
    label,
    items: guides.filter((g) => g.data.cluster === key),
  }))
  .filter((c) => c.items.length > 0);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Guides' },
];
---

<Base
  title="Guides immobiliers pour le Mantois – AUREA Immobilier"
  description="Prix, estimation, mandat, frais de notaire, DPE, gestion locative : nos guides répondent aux questions réelles des vendeurs, acquéreurs et bailleurs du Mantois."
  path="/guides/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.guides', 'titre')}
    lede={field('page.guides', 'chapo')}
    kicker="Conseils"
    crumbs={crumbs}
  />

  <div class="wrap section">
    {
      byCluster.map((cluster) => (
        <section class="cluster-block">
          <div class="section-head">
            <div>
              <p class="kicker">{cluster.label}</p>
              <h2>{cluster.label}</h2>
            </div>
          </div>
          <ul class="guides grid-cards">
            {cluster.items.map((g) => {
              const author = agentBySlug(g.data.author);
              return (
                <li class="guide">
                  <p class="question">
                    <Icon name="quote" size={16} /> {g.data.question}
                  </p>
                  <h3>
                    <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                  </h3>
                  <p class="answer">{g.data.answer}</p>
                  <p class="meta small muted">
                    {author ? `Par ${author.name} · ` : ''}Mis à jour le {frDate(g.data.updated)}
                  </p>
                  <span class="link-arrow">Lire le guide</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>

  <CtaBand
    title="Une question sur votre situation ?"
    text="Un guide ne remplace pas un conseil sur votre dossier. Un conseiller vous répond sous 24 h ouvrées."
  />
</Base>

<style>
  .cluster-block + .cluster-block {
    margin-top: var(--space-xl);
  }

  .section-head .kicker {
    display: none;
  }

  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .guide {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .guide:hover {
    box-shadow: var(--shadow-l);
    transform: translateY(-3px);
  }

  .question {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 0.6rem;
    font-size: var(--step--1);
    color: var(--gold-700);
    font-style: italic;
  }

  .question svg {
    flex: none;
    margin-top: 0.2rem;
  }

  .guide h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .guide h3 a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .guide h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .answer {
    margin-bottom: 0.75rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .meta {
    margin: auto 0 0.6rem;
  }

  .guide .link-arrow {
    color: var(--gold-700);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .guide:hover {
      transform: none;
    }
  }
</style>
