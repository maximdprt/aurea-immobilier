---
/**
 * Page de guide.
 *
 * Structure imposee par le §11 : une vraie question en titre, une reponse
 * directe de 40 a 60 mots en premier paragraphe, puis le detail. L'auteur est
 * un membre identifie de l'equipe, les sources sont listees et liees, et la
 * date de mise a jour est visible.
 */
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import AgentCard from '~/components/AgentCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { agentBySlug, linkedCommune } from '~/lib/catalog';
import { frDate } from '~/lib/format';
import { articleSchema, faqSchema } from '~/lib/schema';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { Content } = await render(guide);

const author = agentBySlug(guide.data.author);
const path = `/guides/${guide.id}/`;

const related = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.id !== guide.id && g.data.cluster === guide.data.cluster)
  .slice(0, 3);

const CLUSTERS: Record<string, string> = {
  prix: 'Prix et estimation',
  vendre: 'Vendre',
  acheter: 'Acheter',
  louer: 'Louer',
  gestion: 'Gestion locative',
  'vivre-ici': 'Vivre dans le Mantois',
};

const communes = guide.data.communes
  .map((name) =>
    linkedCommune(
      name
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
    )
  )
  .filter((c): c is NonNullable<typeof c> => c !== null);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Guides', href: '/guides/' },
  { label: guide.data.title },
];
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  path={path}
  crumbs={crumbs}
  ogType="article"
  brand={false}
  schemas={[
    articleSchema({
      title: guide.data.title,
      description: guide.data.description,
      path,
      published: guide.data.published.toISOString(),
      modified: guide.data.updated.toISOString(),
      authorSlug: author?.slug ?? null,
    }),
    faqSchema([{ question: guide.data.question, answer: guide.data.answer }]),
  ]}
>
  <header class="head">
    <div class="wrap-narrow">
      <Breadcrumb crumbs={crumbs} />
      <p class="kicker">{CLUSTERS[guide.data.cluster] ?? 'Guide'}</p>
      <h1>{guide.data.title}</h1>
      <p class="updated">
        <Icon name="calendar" size={15} />
        Publié le {frDate(guide.data.published)} · mis à jour le {frDate(guide.data.updated)}
        {author && <> · par <a href={`/equipe/${author.slug}/`}>{author.name}</a></>}
      </p>
    </div>
  </header>

  <article class="guide">
    <div class="wrap-narrow">
      {/* Reponse directe : c'est ce bloc que les moteurs generatifs extraient */}
      <div class="answer">
        <p class="answer-q">
          <Icon name="quote" size={18} /> {guide.data.question}
        </p>
        <p class="answer-a">{guide.data.answer}</p>
      </div>

      <div class="prose">
        <Content />
      </div>

      <section class="sources">
        <h2>Sources</h2>
        <ul>
          {
            guide.data.sources.map((s) => (
              <li>
                <Icon name="external" size={15} />
                <a href={s.url} rel="noopener">{s.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="small muted">
          Les informations réglementaires évoluent. Vérifiez la date de mise à jour de cette page
          et, en cas de doute, la source officielle.
        </p>
      </section>

      {
        author && (
          <section class="author">
            <h2>L’auteur</h2>
            <AgentCard agent={author} variant="row" sizes="120px" />
          </section>
        )
      }

      {
        communes.length > 0 && (
          <section class="communes">
            <h2>Communes concernées</h2>
            <ul class="cluster">
              {communes.map((commune) => (
                <li>
                  <a class="badge badge-outline" href={`/agence-immobiliere/${commune.slug}/`}>
                    <Icon name="pin" size={13} /> {commune.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="related">
            <h2>À lire aussi</h2>
            <ul>
              {related.map((g) => (
                <li>
                  <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  <CtaBand
    title="Une question sur votre situation ?"
    text="Ce guide donne le cadre général. Pour votre bien et votre projet, un conseiller vous répond sous 24 h ouvrées."
  />
</Base>

<style>
  .head {
    background: var(--sand-50);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .head :global(.breadcrumb) {
    margin-bottom: var(--space-s);
  }

  .head h1 {
    font-size: var(--step-3);
    margin-bottom: var(--space-xs);
  }

  .updated {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .guide {
    padding-block: var(--space-l) var(--space-xl);
  }

  .answer {
    padding: var(--space-m) var(--space-m);
    margin-bottom: var(--space-l);
    background: var(--gold-50);
    border: 1px solid var(--gold-200);
    border-left: 4px solid var(--gold-400);
    border-radius: var(--radius-m);
  }

  .answer-q {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 var(--space-2xs);
    font-weight: 600;
    color: var(--gold-700);
  }

  .answer-q svg {
    flex: none;
    margin-top: 0.15rem;
  }

  .answer-a {
    margin: 0;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--navy-900);
  }

  .prose :global(table) {
    margin-block: var(--space-m);
  }

  .prose :global(blockquote) {
    margin: var(--space-m) 0;
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--navy-700);
    background: var(--navy-50);
    border-radius: var(--radius-s);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .sources,
  .author,
  .communes,
  .related {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .sources h2,
  .author h2,
  .communes h2,
  .related h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: var(--space-s);
  }

  .sources ul,
  .related ul {
    list-style: none;
    margin: 0 0 var(--space-s);
    padding: 0;
  }

  .sources li,
  .related li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.35rem;
  }

  .sources svg {
    flex: none;
    color: var(--gold-600);
  }

  .communes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .communes .badge {
    text-decoration: none;
    color: var(--navy-900);
  }

  .communes .badge:hover {
    border-color: var(--gold-400);
    background: var(--gold-50);
  }

  .related a {
    font-weight: 500;
  }
</style>
