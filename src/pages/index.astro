---
/**
 * Accueil.
 *
 * Construit pour un visiteur qui arrive avec une intention et peu de temps :
 *  1. le hero dit ce que fait l'agence, ou, et propose la recherche ;
 *  2. trois entrees — acheter, vendre, louer/confier ;
 *  3. les biens du moment ;
 *  4. pourquoi cette agence (arguments concrets, pas de superlatifs) ;
 *  5. comment se passe une vente ;
 *  6. l'equipe, les avis, le secteur, les actualites ;
 *  7. un appel a l'action final.
 *
 * Tous les textes sont modifiables dans le back-office (registre `accueil.*`).
 */
import Base from '~/layouts/Base.astro';
import Picture from '~/components/Picture.astro';
import Icon from '~/components/Icon.astro';
import SearchBar from '~/components/SearchBar.astro';
import ListingCard from '~/components/ListingCard.astro';
import AgentCard from '~/components/AgentCard.astro';
import NewsCard from '~/components/NewsCard.astro';
import Reviews from '~/components/Reviews.astro';
import CtaBand from '~/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { activeListings, allAgents, catalogStats, communesWithPage, editorialMedia } from '~/lib/catalog';
import { CONTACT } from '~/lib/site';
import { field, fieldPairs } from '~/lib/content';
import { latestNews } from '~/lib/news';
import { googleRating } from '~/lib/reviews';
import { frDate } from '~/lib/format';

const featured = activeListings().slice(0, 6);
const hero = editorialMedia('hero-accueil');
const agencyPhoto = editorialMedia('agence');
const stats = catalogStats();
const agents = allAgents().slice(0, 5);
const communes = communesWithPage();
const news = latestNews(3);
const rating = googleRating();
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 3);

const ARG_ICONS = ['chart', 'camera', 'shield', 'phone'] as const;
const args = fieldPairs('accueil.pourquoi', 'arguments');
const steps = fieldPairs('accueil.etapes', 'etapes');
---

<Base
  title="Agence immobilière à Mantes-la-Jolie – AUREA Immobilier"
  description="AUREA Immobilier, agence indépendante à Mantes-la-Jolie : biens à vendre et à louer, estimation gratuite sous 48 h, gestion locative, conseiller joignable en direct."
  path="/"
  crumbs={[{ label: 'Accueil', href: '/' }]}
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <Picture media={hero} alt="" sizes="100vw" priority class="hero-img" />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="kicker rise">Agence immobilière indépendante · Mantes-la-Jolie</p>
        <h1 class="rise rise-2">{field('accueil.hero', 'titre')}</h1>
        <p class="hero-sub rise rise-3">{field('accueil.hero', 'sous_titre')}</p>
      </div>
      <div class="hero-search rise rise-3">
        <SearchBar onDark />
      </div>
    </div>
  </section>

  <!-- Chiffres -->
  <section class="proof">
    <dl class="wrap stats">
      <div>
        <dd>{stats.archivedTotal}</dd>
        <dt>biens vendus ou loués depuis 2024</dt>
      </div>
      <div>
        <dd>{stats.communes}</dd>
        <dt>communes où nous sommes présents</dt>
      </div>
      <div>
        <dd>{allAgents().length}</dd>
        <dt>conseillers, chacun avec sa ligne directe</dt>
      </div>
      {
        rating ? (
          <div>
            <dd>{rating.rating}<small>/5</small></dd>
            <dt>{rating.count} avis Google</dt>
          </div>
        ) : (
          <div>
            <dd>48 h</dd>
            <dt>pour une estimation argumentée, gratuite</dt>
          </div>
        )
      }
    </dl>
  </section>

  <!-- 2. Trois entrees -->
  <section class="section intents">
    <div class="wrap">
      <ul class="intent-grid">
        <li>
          <a href="/acheter/" class="intent">
            <span class="icon-pill"><Icon name="search" /></span>
            <h2>{field('accueil.intentions', 'acheter_titre')}</h2>
            <p>{field('accueil.intentions', 'acheter_texte')}</p>
            <span class="link-arrow">Voir les biens à vendre</span>
          </a>
        </li>
        <li>
          <a href="/estimation/" class="intent is-featured">
            <span class="icon-pill"><Icon name="chart" /></span>
            <h2>{field('accueil.intentions', 'vendre_titre')}</h2>
            <p>{field('accueil.intentions', 'vendre_texte')}</p>
            <span class="link-arrow">Estimer mon bien gratuitement</span>
          </a>
        </li>
        <li>
          <a href="/louer/" class="intent">
            <span class="icon-pill"><Icon name="key" /></span>
            <h2>{field('accueil.intentions', 'louer_titre')}</h2>
            <p>{field('accueil.intentions', 'louer_texte')}</p>
            <span class="link-arrow">Voir les locations et la gestion</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. Biens du moment -->
  {
    featured.length > 0 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">Nos biens</p>
              <h2>Les biens du moment</h2>
            </div>
            <p>
              <a class="link-arrow" href="/acheter/">
                Tous les biens ({stats.active})
              </a>
            </p>
          </div>
          <div class="grid-cards">
            {featured.map((l, i) => (
              <ListingCard listing={l} priority={i < 3} />
            ))}
          </div>
          <p class="center">
            <a class="btn btn-navy" href="/acheter/">Voir tous les biens à vendre</a>
            <a class="btn btn-outline" href="/louer/">Voir les locations</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- 4. Pourquoi AUREA -->
  <section class="section why">
    <div class="wrap why-inner">
      <div class="why-text">
        <p class="kicker">Notre méthode</p>
        <h2>{field('accueil.pourquoi', 'titre')}</h2>
        <p class="lede">{field('accueil.pourquoi', 'intro')}</p>
        <p class="cluster">
          <a class="btn btn-navy" href="/agence/">Découvrir l’agence</a>
          <a class="btn btn-outline" href="/equipe/">Rencontrer l’équipe</a>
        </p>
        {
          agencyPhoto && (
            <Picture
              media={agencyPhoto}
              alt="L’intérieur de l’agence AUREA Immobilier, 44 rue Nationale à Mantes-la-Jolie"
              sizes="(min-width: 64rem) 32rem, 92vw"
              aspect="4 / 3"
              class="why-photo"
            />
          )
        }
      </div>
      <ul class="args">
        {
          args.map(([title, text], i) => (
            <li>
              <span class="icon-pill icon-pill-navy">
                <Icon name={ARG_ICONS[i % ARG_ICONS.length]} />
              </span>
              <div>
                <h3>{title}</h3>
                {text && <p>{text}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Etapes -->
  <section class="section section-navy steps">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Vendre</p>
          <h2>{field('accueil.etapes', 'titre')}</h2>
          <p class="lede">{field('accueil.etapes', 'intro')}</p>
        </div>
        <p><a class="btn" href="/vendre/">Notre méthode de vente en détail</a></p>
      </div>
      <ol class="steps-list">
        {
          steps.map(([title, text], i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{title}</h3>
              {text && <p>{text}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Equipe -->
  <section class="section team">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">L’équipe</p>
          <h2>{field('accueil.equipe', 'titre')}</h2>
          <p class="lede">{field('accueil.equipe', 'texte')}</p>
        </div>
        <p><a class="link-arrow" href="/equipe/">Toute l’équipe</a></p>
      </div>
      <ul class="team-grid">
        {agents.map((a) => <li><AgentCard agent={a} sizes="(min-width: 64rem) 14rem, 45vw" /></li>)}
      </ul>
    </div>
  </section>

  <!-- 7. Avis -->
  <div class="wrap">
    <Reviews limit={3} linkAll />
  </div>

  <!-- 8. Secteur -->
  <section class="section section-alt area">
    <div class="wrap area-inner">
      <div>
        <p class="kicker">Notre secteur</p>
        <h2>Mantes-la-Jolie et le Mantois</h2>
        <p class="lede">
          Installés {CONTACT.street}, nous intervenons dans le Mantois, les Yvelines et jusqu’aux
          communes voisines du Val-d’Oise et de l’Eure. Une page par commune où nous avons
          réellement vendu ou loué.
        </p>
        <p class="cluster">
          <a class="btn btn-outline" href="/prix-immobilier-mantes-la-jolie/">
            <Icon name="chart" size={18} /> Prix immobilier à Mantes-la-Jolie
          </a>
        </p>
      </div>
      <ul class="communes">
        {
          communes.map((c) => (
            <li>
              <a href={`/agence-immobiliere/${c.slug}/`}>
                <Icon name="pin" size={14} /> {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. Actualites / guides -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{news.length ? 'Actualités' : 'Guides'}</p>
          <h2>{news.length ? 'La vie de l’agence' : 'Nos guides pour décider en connaissance de cause'}</h2>
        </div>
        <p>
          <a class="link-arrow" href={news.length ? '/actualites/' : '/guides/'}>
            {news.length ? 'Toutes les actualités' : 'Tous les guides'}
          </a>
        </p>
      </div>
      {
        news.length ? (
          <div class="grid-cards">
            {news.map((n) => (
              <NewsCard item={n} />
            ))}
          </div>
        ) : (
          <ul class="guides">
            {guides.map((g) => (
              <li>
                <a href={`/guides/${g.id}/`}>
                  <span class="guide-date">Mis à jour le {frDate(g.data.updated)}</span>
                  <h3>{g.data.title}</h3>
                  <p>{g.data.answer}</p>
                  <span class="link-arrow">Lire le guide</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------------------------------------------------------- Hero ------ */
  .hero {
    position: relative;
    min-height: min(92vh, 50rem);
    display: flex;
    align-items: flex-end;
    background: var(--navy-900);
    color: #fff;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-in 1.4s var(--ease-out) both;
  }

  @keyframes hero-in {
    from {
      transform: scale(1.05);
    }
    to {
      transform: none;
    }
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 19 42 / 0.15) 0%, rgb(0 19 42 / 0.55) 55%, rgb(0 19 42 / 0.85) 100%),
      linear-gradient(90deg, rgb(0 19 42 / 0.55) 0%, rgb(0 19 42 / 0.1) 70%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-l);
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero-text {
    max-width: 44rem;
  }

  .hero .kicker {
    color: var(--gold-300);
  }

  .hero .kicker::before {
    background: var(--gold-300);
  }

  .hero h1 {
    color: #fff;
    margin-bottom: var(--space-s);
    text-shadow: 0 2px 30px rgb(0 19 42 / 0.5);
  }

  .hero-sub {
    margin: 0;
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: rgb(255 255 255 / 0.88);
  }

  /* ------------------------------------------------------ Chiffres ------ */
  .proof {
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .proof .stats {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0;
  }

  .proof .stats > div {
    padding: var(--space-m) var(--space-s);
    text-align: center;
  }

  .proof .stats > div + div {
    border-left: 1px solid var(--line);
  }

  .proof dd small {
    font-size: 1rem;
    color: var(--ink-muted);
  }

  @media (max-width: 40rem) {
    .proof .stats {
      grid-template-columns: 1fr 1fr;
    }
    .proof .stats > div:nth-child(3) {
      border-left: 0;
    }
    .proof .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* ------------------------------------------------------- Intentions --- */
  .intent-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .intent {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .intent:hover {
    box-shadow: var(--shadow-l);
    transform: translateY(-3px);
    border-color: transparent;
    color: inherit;
  }

  .intent h2 {
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 1rem 0 0.4rem;
  }

  .intent p {
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .intent .link-arrow {
    margin-top: auto;
    color: var(--navy-900);
  }

  .intent.is-featured {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: #fff;
  }

  .intent.is-featured h2 {
    color: #fff;
  }

  .intent.is-featured p {
    color: rgb(255 255 255 / 0.8);
  }

  .intent.is-featured .link-arrow {
    color: var(--gold-300);
  }

  .intent.is-featured .icon-pill {
    background: var(--gold-400);
    color: var(--navy-900);
  }

  .center {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin: var(--space-l) 0 0;
  }

  /* ------------------------------------------------------- Pourquoi ----- */
  .why-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .why-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .why-text .cluster {
    margin-bottom: var(--space-l);
  }

  .why-text :global(.why-photo img) {
    border-radius: var(--radius-l);
  }

  .args {
    display: grid;
    gap: var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .args li {
    display: flex;
    gap: 1rem;
    padding: 1.2rem 1.3rem;
    background: var(--sand-50);
    border: 1px solid var(--sand-100);
    border-radius: var(--radius-m);
  }

  .args h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .args p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* --------------------------------------------------------- Etapes ----- */
  .steps .lede {
    color: rgb(255 255 255 / 0.8);
  }

  .steps-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .steps-list li {
    position: relative;
    padding: 1.4rem 1.3rem 1.3rem;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-m);
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-bottom: 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
    color: var(--navy-900);
    font-weight: 700;
  }

  .steps-list h3 {
    margin-bottom: 0.35rem;
    font-size: 1.05rem;
  }

  .steps-list p {
    margin: 0;
    color: rgb(255 255 255 / 0.78);
    font-size: var(--step--1);
  }

  /* --------------------------------------------------------- Equipe ----- */
  .team-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --------------------------------------------------------- Secteur ---- */
  .area-inner {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .area-inner {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .communes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .communes a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--navy-900);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }

  .communes a:hover {
    border-color: var(--gold-400);
    background: var(--gold-50);
  }

  .communes svg {
    color: var(--gold-600);
  }

  /* ---------------------------------------------------------- Guides ---- */
  .guides {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .guides a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .guides a:hover {
    box-shadow: var(--shadow-l);
    transform: translateY(-3px);
    color: inherit;
  }

  .guide-date {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: 0.4rem;
  }

  .guides h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .guides p {
    color: var(--ink-soft);
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }

  .guides .link-arrow {
    margin-top: auto;
    color: var(--gold-700);
  }
</style>
