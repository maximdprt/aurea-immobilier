---
/**
 * « Ma selection » — les biens mis de cote par le visiteur.
 *
 * Pas de compte client : la selection vit dans le `localStorage` du
 * navigateur, sous la cle `aurea-selection` qu'ecrit le cœur de `ListingCard`.
 * Rien n'est envoye au serveur, donc la page ne peut pas etre rendue a
 * l'avance pour un visiteur donne : elle rend TOUTES les fiches, masquees, et
 * ne revele au chargement que celles du stockage. Les images sont en lazy :
 * une carte masquee n'en telecharge aucune.
 *
 * `noindex` : la page n'a pas de contenu propre.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ListingCard from '~/components/ListingCard.astro';
import Icon from '~/components/Icon.astro';
import { allListings } from '~/lib/catalog';
import { agency } from '~/lib/content';

const contact = agency();
/* Toutes les fiches, y compris vendues et louees : un bien mis de cote depuis
   « Nos reussites » doit pouvoir se retrouver ici. */
const listings = allListings();

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Ma sélection' },
];
---

<Base
  title="Ma sélection de biens"
  description="Retrouvez les biens que vous avez mis de côté pendant votre recherche, comparez-les et transmettez leurs références à un conseiller AUREA Immobilier."
  path="/selection/"
  crumbs={crumbs}
  noindex
>
  <PageHeader
    title="Ma sélection"
    lede="Les biens que vous avez mis de côté avec le cœur affiché sur chaque annonce. Cette liste est conservée par votre navigateur, sur cet appareil : elle ne nous est pas transmise et ne demande aucun compte."
    crumbs={crumbs}
    kicker="Votre recherche"
  />

  <section class="section" data-selection>
    <div class="wrap">
      {/* Etat par defaut du document : c'est aussi ce que voit un visiteur sans
          JavaScript, pour qui la selection n'a jamais pu etre enregistree. */}
      <div class="empty" data-empty>
        <span class="icon-pill"><Icon name="heart" /></span>
        <h2>Votre sélection est vide pour le moment</h2>
        <p>
          Pendant votre recherche, le cœur affiché sur chaque annonce met le bien de côté. Vous le
          retrouvez ensuite ici, pour comparer à tête reposée et ne pas repartir de zéro.
        </p>
        <p class="cluster">
          <a class="btn btn-navy" href="/acheter/">Voir les biens à vendre</a>
          <a class="btn btn-outline" href="/louer/">Voir les locations</a>
        </p>
      </div>

      {/* Stockage inaccessible (navigation privee verrouillee, cookies bloques). */}
      <p class="notice" data-unavailable hidden>
        Votre navigateur n’autorise pas le stockage local : les biens mis de côté ne peuvent pas être
        conservés d’une page à l’autre. Vous pouvez relever leurs références et nous appeler au{' '}
        <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a>.
      </p>

      <div class="results" data-results hidden>
        <div class="toolbar">
          <p class="count" data-count></p>
          <button type="button" class="btn btn-ghost btn-sm" data-clear>
            <Icon name="close" size={16} /> Vider ma sélection
          </button>
        </div>

        <div class="grid">
          {
            listings.map((l) => (
              <div class="listing-item" data-item data-ref={l.reference} hidden>
                <ListingCard listing={l} />
              </div>
            ))
          }
        </div>

        <aside class="next">
          <div>
            <h2>Faire le point sur cette sélection</h2>
            <p>
              Un conseiller peut regrouper plusieurs de ces visites sur un même déplacement, et vous
              dire lesquelles valent vraiment le trajet.
            </p>
            <p class="refs small muted">
              Références retenues : <span data-refs class="tnum">—</span>. Indiquez-les dans votre
              message, nous préparerons le rendez-vous.
            </p>
          </div>
          <p class="cluster">
            <a class="btn" href="/contact/" data-contact-link>Nous transmettre ma sélection</a>
            <a class="phone" href={`tel:${contact.phoneE164}`}>
              <Icon name="phone" size={16} /> <span class="tnum">{contact.phone}</span>
            </a>
          </p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .empty {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-xl) var(--space-m);
    text-align: center;
  }

  .empty .icon-pill {
    margin-bottom: var(--space-s);
  }

  .empty h2 {
    margin-bottom: var(--space-2xs);
  }

  .empty p {
    color: var(--ink-soft);
  }

  .empty .cluster {
    justify-content: center;
    margin-top: var(--space-m);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .count {
    margin: 0;
    font-weight: 600;
    color: var(--navy-900);
  }

  .toolbar .btn-ghost {
    color: var(--ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: var(--space-m);
  }

  .listing-item[hidden] {
    display: none;
  }

  .next {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    margin-top: var(--space-xl);
    padding: var(--space-m) var(--space-l);
    background: var(--sand-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  @media (min-width: 64rem) {
    .next {
      grid-template-columns: 1fr auto;
    }
  }

  .next h2 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }

  .next p {
    margin-bottom: var(--space-2xs);
    color: var(--ink-soft);
  }

  .next .cluster {
    margin: 0;
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>

<script>
  /* Meme cle que le cœur de ListingCard. Les deux doivent rester identiques. */
  const KEY = 'aurea-selection';

  const root = document.querySelector<HTMLElement>('[data-selection]');
  if (root) {
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const unavailable = root.querySelector<HTMLElement>('[data-unavailable]');
    const results = root.querySelector<HTMLElement>('[data-results]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const refsOut = root.querySelector<HTMLElement>('[data-refs]');
    const contactLink = root.querySelector<HTMLAnchorElement>('[data-contact-link]');
    const clear = root.querySelector<HTMLButtonElement>('[data-clear]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];

    /** `null` signale un stockage inaccessible, a distinguer d'une selection vide. */
    const read = (): number[] | null => {
      let raw: string | null;
      try {
        raw = localStorage.getItem(KEY);
      } catch {
        return null;
      }
      try {
        const parsed: unknown = JSON.parse(raw ?? '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.map(Number).filter(Number.isFinite);
      } catch {
        return [];
      }
    };

    const render = () => {
      const refs = read();

      if (refs === null) {
        unavailable?.removeAttribute('hidden');
        return;
      }
      unavailable?.setAttribute('hidden', '');

      const wanted = new Set(refs);
      let shown = 0;
      for (const item of items) {
        const on = wanted.has(Number(item.dataset.ref));
        item.hidden = !on;
        if (on) shown++;
      }

      /* Une reference stockee dont la fiche a quitte le catalogue n'est pas
         comptee : on compte ce qui est reellement affiche. */
      if (count) count.textContent = `${shown} bien${shown > 1 ? 's' : ''} dans ma sélection`;
      const visibleRefs = items.filter((item) => !item.hidden).map((item) => item.dataset.ref);
      if (refsOut) refsOut.textContent = visibleRefs.join(', ') || '—';
      if (contactLink) {
        contactLink.href = `/contact/?refs=${encodeURIComponent(visibleRefs.join(','))}`;
      }

      const some = shown > 0;
      if (results) results.hidden = !some;
      if (empty) empty.hidden = some;
    };

    clear?.addEventListener('click', () => {
      try {
        localStorage.removeItem(KEY);
      } catch {
        /* stockage indisponible : il n'y avait rien a vider */
      }
      render();
    });

    /* Le cœur de chaque carte reste actif ici : le retirer doit faire sortir la
       carte de la liste. Le clic est ecoute sur le conteneur, donc APRES le
       gestionnaire porte par le bouton lui-meme. */
    root.addEventListener('click', (event) => {
      if ((event.target as HTMLElement | null)?.closest('[data-fav]')) render();
    });

    /* La selection peut changer dans un autre onglet : on se resynchronise. */
    window.addEventListener('storage', (event) => {
      if (event.key === null || event.key === KEY) render();
    });

    render();
  }
</script>
