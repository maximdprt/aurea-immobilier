---
/**
 * Vendre avec AUREA : methode, moyens, preuves, questions (§7).
 * Les textes viennent du registre `page.vendre` ; aucun chiffre de performance
 * n'est invente — les indicateurs non fournis sont simplement absents.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';
import Faq, { type FaqItem } from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import Reviews from '~/components/Reviews.astro';
import { catalogStats, editorialMedia } from '~/lib/catalog';
import { faqSchema } from '~/lib/schema';
import { field, fieldPairs, agency } from '~/lib/content';

const stats = catalogStats();
const visual = editorialMedia('services');
const contact = agency();

const steps = fieldPairs('page.vendre', 'etapes');
const means = fieldPairs('page.vendre', 'moyens');
const MEAN_ICONS = ['camera', 'compass', 'sparkle', 'handshake', 'shield', 'file'] as const;

const faq: FaqItem[] = [
  {
    question: 'Mandat simple ou mandat exclusif : que choisir ?',
    answer:
      'Le mandat exclusif confie la vente à une seule agence, qui engage alors tous ses moyens sur votre bien : reportage complet, diffusion prioritaire, compte rendu régulier. Le mandat simple permet de mandater plusieurs agences, mais dilue l’effort et affaiblit la cohérence du prix affiché.',
    details: [
      'Dans les deux cas, vous restez libre de vendre par vous-même selon les termes du mandat.',
    ],
  },
  {
    question: 'Quels diagnostics dois-je fournir pour vendre ?',
    answer:
      'Le dossier de diagnostic technique réunit notamment le DPE, l’amiante, le plomb, l’électricité, le gaz, l’état des risques et pollutions, le mesurage loi Carrez en copropriété et l’assainissement. La liste exacte dépend du bien, de son année de construction et de sa commune.',
    details: ['Nous travaillons avec des diagnostiqueurs du secteur et coordonnons les rendez-vous.'],
  },
  {
    question: 'Qui paie les honoraires d’agence ?',
    answer:
      'C’est fixé au mandat et indiqué sur chaque annonce : les honoraires sont à la charge du vendeur ou de l’acquéreur, et le prix affiché les inclut. Le barème complet est publié sur le site.',
  },
  {
    question: 'Combien de temps faut-il pour vendre ?',
    answer:
      'Le délai dépend du bien, de son prix et du marché local. Un bien estimé au juste prix, bien présenté et proposé à des acquéreurs déjà qualifiés se vend plus vite : c’est précisément l’objet de notre méthode.',
  },
];

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Vendre' },
];
---

<Base
  title="Vendre son bien à Mantes-la-Jolie avec AUREA Immobilier"
  description="Notre méthode de vente : estimation en 4 méthodes, reportage photo professionnel, visite virtuelle, acquéreurs qualifiés, accompagnement jusqu’à la signature."
  path="/vendre/"
  crumbs={crumbs}
  schemas={[faqSchema(faq.map((f) => ({ question: f.question, answer: f.answer })))]}
>
  <PageHeader
    title={field('page.vendre', 'titre')}
    lede={field('page.vendre', 'chapo')}
    crumbs={crumbs}
    kicker="Vendre"
    image={visual}
    imageAlt="Conseillers AUREA Immobilier en rendez-vous de présentation d’un bien"
  >
    <p class="cluster">
      <a class="btn" href="/estimation/">Demander une estimation gratuite</a>
      <a class="btn btn-outline" href="/biens-vendus/">Voir nos réussites</a>
    </p>
  </PageHeader>

  <!-- Chiffres -->
  <section class="proof">
    <dl class="wrap stats">
      <div>
        <dd>{stats.archivedTotal}</dd>
        <dt>biens vendus ou loués depuis août 2024</dt>
      </div>
      <div>
        <dd>{stats.communes}</dd>
        <dt>communes où nous avons conclu une transaction</dt>
      </div>
      <div>
        <dd>48 h</dd>
        <dt>pour obtenir un avis de valeur écrit, gratuit</dt>
      </div>
      <div>
        <dd>1</dd>
        <dt>interlocuteur, du premier appel à la signature</dt>
      </div>
    </dl>
  </section>

  <!-- Etapes -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">La méthode</p>
          <h2>Les étapes de votre vente</h2>
        </div>
        <p class="lede">Vous savez à chaque moment où en est votre vente, et ce qui vient ensuite.</p>
      </div>
      <ol class="steps">
        {
          steps.map(([title, body, delay], i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div class="step-body">
                <h3>{title}</h3>
                {body && <p>{body}</p>}
                {delay && (
                  <p class="delay">
                    <Icon name="clock" size={15} /> {delay}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Moyens -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Les moyens</p>
          <h2>Ce que nous mettons en œuvre pour votre bien</h2>
        </div>
      </div>
      <ul class="means">
        {
          means.map(([title, text], i) => (
            <li>
              <span class="icon-pill">
                <Icon name={MEAN_ICONS[i % MEAN_ICONS.length]} />
              </span>
              <div>
                <h3>{title}</h3>
                {text && <p>{text}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Estimation : passerelle -->
  <section class="section">
    <div class="wrap bridge">
      <div class="bridge-text">
        <p class="kicker">Première étape</p>
        <h2>Tout commence par une estimation argumentée</h2>
        <p class="lede">
          Un conseiller se déplace, relève les caractéristiques de votre bien et croise quatre
          méthodes de valorisation. Vous recevez un avis de valeur écrit, gratuit et sans
          engagement.
        </p>
        <p class="cluster">
          <a class="btn btn-navy" href="/estimation/">Estimer mon bien</a>
          <a class="btn btn-outline" href="/guides/estimation-immobiliere-4-methodes/">Comprendre les quatre méthodes</a>
        </p>
      </div>
      <ul class="bridge-list">
        <li><Icon name="check" size={18} /> Visite sur place sous 48 h</li>
        <li><Icon name="check" size={18} /> Avis de valeur écrit et expliqué</li>
        <li><Icon name="check" size={18} /> Sans engagement</li>
        <li><Icon name="check" size={18} /> Un conseiller joignable en direct au <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a></li>
      </ul>
    </div>
  </section>

  <div class="wrap">
    <Reviews limit={3} linkAll title="Ils ont vendu avec nous" />
  </div>

  <section class="section">
    <div class="wrap">
      <Faq items={faq} title="Vendre avec AUREA : vos questions" />
    </div>
  </section>

  <CtaBand
    title="Prêt à vendre ? Commençons par le juste prix."
    text="Demandez votre estimation gratuite : un conseiller vous rappelle sous 48 h ouvrées pour convenir d’une visite."
  />
</Base>

<style>
  .proof {
    border-bottom: 1px solid var(--line);
  }

  .proof .stats {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0;
  }

  .proof .stats > div {
    padding: var(--space-m) var(--space-s);
    text-align: center;
  }

  .proof .stats > div + div {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 40rem) {
    .proof .stats {
      grid-template-columns: 1fr 1fr;
    }
    .proof .stats > div:nth-child(3) {
      border-left: 0;
    }
    .proof .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* --- Etapes ------------------------------------------------------------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--space-m);
    padding-bottom: var(--space-l);
  }

  .steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: 0;
    width: 2px;
    background: var(--gold-200);
  }

  .num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
    color: var(--navy-900);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .step-body h3 {
    margin: 0.35rem 0 0.35rem;
  }

  .step-body p {
    margin-bottom: 0.4rem;
    color: var(--ink-soft);
  }

  .delay {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--gold-700);
    font-weight: 600;
  }

  /* --- Moyens ------------------------------------------------------------- */
  .means {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .means li {
    display: flex;
    gap: 1rem;
    padding: 1.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .means h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
  }

  .means p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* --- Passerelle estimation ---------------------------------------------- */
  .bridge {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .bridge {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .bridge-list {
    list-style: none;
    margin: 0;
    padding: 1.4rem 1.5rem;
    background: var(--navy-900);
    color: #fff;
    border-radius: var(--radius-m);
  }

  .bridge-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding-block: 0.55rem;
  }

  .bridge-list li + li {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .bridge-list svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--gold-300);
  }

  .bridge-list a {
    color: var(--gold-300);
  }
</style>
