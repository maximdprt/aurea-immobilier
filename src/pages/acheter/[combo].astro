---
/**
 * Page « type x commune » — ex. /acheter/maison-mantes-la-jolie/.
 *
 * Le brief n'autorise ces pages que la ou il y a un volume reel ET une presence
 * reelle (§5, §7). Le seuil est applique par `typeCommunePages()`.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ListingResults from '~/components/ListingResults.astro';
import CtaBand from '~/components/CtaBand.astro';
import { typeCommunePages } from '~/lib/catalog';
import { plural, propertyTypeLabel } from '~/lib/format';
import type { Commune, Listing, PropertyType } from '~/lib/types';

export function getStaticPaths() {
  return typeCommunePages().map(({ type, commune, listings, soldCount }) => ({
    params: { combo: `${type}-${commune.slug}` },
    props: { commune, type, listings, soldCount },
  }));
}

interface Props {
  commune: Commune;
  type: PropertyType;
  listings: Listing[];
  soldCount: number;
}
const { commune, type, listings, soldCount } = Astro.props;

const typeLabel = propertyTypeLabel(type);
const plural1 = type === 'maison' ? 'Maisons' : 'Appartements';
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Acheter', href: '/acheter/' },
  { label: `${plural1} à ${commune.name}` },
];

const lede =
  `${plural(listings.length, `${typeLabel.toLowerCase()} disponible`, `${typeLabel.toLowerCase()}s disponibles`)} à ${commune.name}` +
  (soldCount > 0
    ? `, après ${plural(soldCount, 'vente réalisée', 'ventes réalisées')} sur ce type de bien dans la commune.`
    : '.');
---

<Base
  title={`${plural1} à vendre à ${commune.name} – AUREA Immobilier`}
  description={`${listings.length} ${typeLabel.toLowerCase()}${listings.length > 1 ? 's' : ''} à vendre à ${commune.name}. Prix honoraires inclus, DPE affiché, visite avec un conseiller qui connaît le secteur.`}
  path={`/acheter/${type}-${commune.slug}/`}
  crumbs={crumbs}
>
  <PageHeader title={`${plural1} à vendre à ${commune.name}`} lede={lede} crumbs={crumbs} kicker="Acheter" />

  <section class="section">
    <div class="wrap">
      <ListingResults listings={listings} showFilters={false} />

      <p class="more">
        <a class="btn btn-outline" href={`/agence-immobiliere/${commune.slug}/`}>
          Tout l’immobilier à {commune.name}
        </a>
        <a class="btn btn-outline" href="/acheter/">Tous nos biens à vendre</a>
      </p>
    </div>
  </section>

  <CtaBand
    title={`Vous vendez une ${typeLabel.toLowerCase()} à ${commune.name} ?`}
    text="Nous connaissons les acquéreurs qui cherchent dans ce secteur. Une estimation gratuite et argumentée sous 48 h."
  />
</Base>

<style>
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-l) 0 0;
  }
</style>
