---
/**
 * Liste des biens a vendre. Mot-cle : « maison / appartement à vendre
 * Mantes-la-Jolie ». Les filtres ne creent aucune URL (voir ListingResults).
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ListingResults from '~/components/ListingResults.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { activeListings, communesWithPage, typeCommunePages } from '~/lib/catalog';
import { field } from '~/lib/content';

const listings = activeListings('vente');
const communes = communesWithPage().filter((c) => c.activeCount > 0);
const typePages = typeCommunePages();
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Acheter', href: '/acheter/' },
];
---

<Base
  title="Biens à vendre à Mantes-la-Jolie et Mantois"
  description="Tous nos biens à vendre dans le Mantois : maisons, appartements, immeubles. Prix honoraires inclus, DPE affiché, conseiller dédié pour chaque visite."
  path="/acheter/"
  crumbs={crumbs}
>
  <PageHeader
    title={field('page.acheter', 'titre')}
    lede={field('page.acheter', 'chapo')}
    crumbs={crumbs}
    kicker="Acheter"
  >
    <p class="cluster">
      <span class="badge badge-gold">
        {listings.length} bien{listings.length > 1 ? 's' : ''} disponible{listings.length > 1 ? 's' : ''}
      </span>
      <a class="btn btn-outline btn-sm" href="/louer/">Voir plutôt les locations</a>
    </p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <ListingResults listings={listings} />
    </div>
  </section>

  {
    (communes.length > 0 || typePages.length > 0) && (
      <section class="section-tight section-alt">
        <div class="wrap">
          <p class="kicker">Par commune</p>
          <h2>Acheter commune par commune</h2>
          <ul class="chips">
            {communes.map((c) => (
              <li>
                <a href={`/agence-immobiliere/${c.slug}/`}>
                  <Icon name="pin" size={14} /> Immobilier à {c.name}
                </a>
              </li>
            ))}
            {typePages.map((p) => (
              <li>
                <a href={`/acheter/${p.type}-${p.commune.slug}/`}>
                  <Icon name="home" size={14} />
                  {p.type === 'maison' ? 'Maisons' : 'Appartements'} à vendre à {p.commune.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="wrap alert-box">
      <span class="icon-pill"><Icon name="bell" /></span>
      <div>
        <h2>Le bien que vous cherchez n’est pas encore en ligne ?</h2>
        <p>
          Dites-nous vos critères : nous vous écrivons dès qu’un bien y correspond, et à ce moment-là
          seulement. Sans compte, désinscription en un clic.
        </p>
      </div>
      <a class="btn btn-navy" href="/alerte/">Créer une alerte</a>
    </div>
  </section>

  <CtaBand
    title="Vous vendez avant d’acheter ?"
    text="Une estimation gratuite et argumentée sous 48 h vous dit sur quel budget compter pour votre prochain achat."
  />
</Base>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--navy-900);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }

  .chips a:hover {
    border-color: var(--gold-400);
    background: var(--gold-50);
  }

  .chips svg {
    color: var(--gold-600);
  }

  .alert-box {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    padding: var(--space-m) var(--space-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .alert-box h2 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .alert-box p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (min-width: 48rem) {
    .alert-box {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>
