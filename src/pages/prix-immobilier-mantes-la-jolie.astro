---
/**
 * Page « Prix immobilier Mantes-la-Jolie ».
 *
 * Pensee pour etre citee par les moteurs generatifs (§8, §11) : tableaux HTML,
 * chiffres sources et dates, revision trimestrielle.
 *
 * Les prix de marche ne sont pas inventes. Ce que nous publions, ce sont NOS
 * chiffres : les biens que nous avons reellement traites, avec leurs surfaces
 * et leurs prix, et le renvoi vers la source publique (base DVF) pour les
 * medianes de marche.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Faq, { type FaqItem } from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { allListings, archivedByCommune } from '~/lib/catalog';
import { area, money, plural, propertyTypeLabel } from '~/lib/format';
import { faqSchema } from '~/lib/schema';
import DvfPanel from '~/components/DvfPanel.astro';
import { allDvf, dvfFor, dvfMeta, perSqm } from '~/lib/dvf';

const dvf = dvfFor('mantes-la-jolie');
const meta = dvfMeta();
const neighbours = allDvf();

const listings = allListings().filter((l) => l.communeSlug === 'mantes-la-jolie');
const archived = archivedByCommune('Mantes-la-Jolie');

/** Statistiques calculees sur NOS transactions : verifiables, donc publiables. */
const withPrice = listings
  .filter((l) => l.price && l.livingArea && l.transaction === 'vente')
  .map((l) => ({ listing: l, perSqm: Math.round((l.price ?? 0) / (l.livingArea ?? 1)) }));
const pricesPerSqm = withPrice.map((row) => row.perSqm).sort((a, b) => a - b);
const median = (arr: number[]) => (arr.length ? arr[Math.floor(arr.length / 2)] : null);

const ourMedian = median(pricesPerSqm);
const ourMin = pricesPerSqm[0] ?? null;
const ourMax = pricesPerSqm[pricesPerSqm.length - 1] ?? null;

const byType = (['maison', 'appartement'] as const)
  .map((type) => {
    const subset = withPrice.filter((row) => row.listing.propertyType === type);
    const values = subset.map((row) => row.perSqm).sort((a, b) => a - b);
    return { type, count: subset.length, median: median(values) };
  })
  .filter((r) => r.count > 0);

const totalTransactions = listings.filter((l) => l.status !== 'published').length + archived.length;

const faq: FaqItem[] = [
  {
    question: 'Quel est le prix au m² à Mantes-la-Jolie ?',
    answer: dvf
      ? `Sur les ventes enregistrées en ${meta.period.replace('-', ' et ')} (base DVF), le prix médian est de ${perSqm(dvf.maison.medianPerSqm)} pour une maison et de ${perSqm(dvf.appartement.medianPerSqm)} pour un appartement à Mantes-la-Jolie. Ce sont des médianes : l’état, l’étage, l’exposition et le DPE font varier la valeur d’un bien précis.`
      : 'Le prix de référence est la médiane des ventes réellement enregistrées par l’administration fiscale, publiée dans la base DVF et consultable gratuitement.',
  },
  {
    question: 'Pourquoi les prix d’annonce diffèrent-ils des prix de vente ?',
    answer:
      'Un prix d’annonce est une demande, un prix DVF est un accord. L’écart entre les deux mesure la négociation réelle du marché : il se creuse quand l’offre dépasse la demande, et se referme sur les biens rares ou bien préparés.',
  },
  {
    question: 'Le DPE influence-t-il le prix à Mantes-la-Jolie ?',
    answer:
      'Oui, et de plus en plus nettement. Un logement classé F ou G subit une décote à l’achat, parce que l’acquéreur intègre le coût des travaux et l’impossibilité prochaine de le louer. À l’inverse, un bien classé A à C se négocie moins.',
  },
];

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Prix immobilier à Mantes-la-Jolie' },
];
---

<Base
  title="Prix immobilier à Mantes-la-Jolie"
  description="Prix au m² à Mantes-la-Jolie : médianes des ventes réellement enregistrées (DVF), comparatif des communes voisines et prix constatés sur nos propres ventes."
  path="/prix-immobilier-mantes-la-jolie/"
  crumbs={crumbs}
  schemas={[faqSchema(faq.map((f) => ({ question: f.question, answer: f.answer })))]}
>
  <PageHeader
    title="Prix de l’immobilier à Mantes-la-Jolie"
    lede="Les prix de marché issus des ventes réellement enregistrées par l’administration fiscale, puis ceux que nous constatons sur les biens que nous commercialisons. Chaque chiffre est sourcé et daté."
    crumbs={crumbs}
    kicker="Données de marché"
  >
    <p class="updated">Dernière mise à jour : 23 septembre 2026 · Révision trimestrielle</p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <DvfPanel slug="mantes-la-jolie" title="Les prix du marché" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">Nos ventes</p>
      <h2>Ce que nous constatons sur nos propres ventes</h2>
      <p class="lede">
        Ces chiffres portent sur les {plural(listings.length, 'bien')} que nous avons commercialisés à
        Mantes-la-Jolie et dont nous connaissons à la fois le prix et la surface. L’échantillon est
        petit : il illustre, il ne mesure pas le marché.
      </p>
      <dl class="stats own">
        <div>
          <dd>{ourMedian ? `${money(ourMedian)}` : '—'}</dd>
          <dt>prix médian au m² constaté</dt>
        </div>
        <div>
          <dd class="range">{ourMin && ourMax ? `${money(ourMin)} – ${money(ourMax)}` : '—'}</dd>
          <dt>fourchette observée, au m²</dt>
        </div>
        <div>
          <dd>{withPrice.length}</dd>
          <dt>biens dans l’échantillon</dt>
        </div>
        <div>
          <dd>{totalTransactions}</dd>
          <dt>transactions réalisées dans la commune</dt>
        </div>
      </dl>

      {
        byType.length > 0 && (
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Prix médian au m² par type, sur notre portefeuille</caption>
              <thead>
                <tr>
                  <th scope="col">Type</th>
                  <th scope="col">Biens</th>
                  <th scope="col">Prix médian au m² constaté</th>
                </tr>
              </thead>
              <tbody>
                {byType.map((row) => (
                  <tr>
                    <th scope="row">{propertyTypeLabel(row.type)}</th>
                    <td>{row.count}</td>
                    <td>{row.median ? `${money(row.median)} / m²` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      {
        withPrice.length > 0 && (
          <>
            <h3>Les biens de l’échantillon</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Réf.</th>
                    <th scope="col">Bien</th>
                    <th scope="col">Surface</th>
                    <th scope="col">Prix</th>
                    <th scope="col">Prix au m²</th>
                    <th scope="col">DPE</th>
                  </tr>
                </thead>
                <tbody>
                  {withPrice.map(({ listing, perSqm }) => (
                    <tr>
                      <td class="tnum">{listing.reference}</td>
                      <td>
                        <a href={`/bien/${listing.slug}/`}>{listing.title}</a>
                      </td>
                      <td class="tnum">{area(listing.livingArea)}</td>
                      <td class="tnum">{money(listing.price)}</td>
                      <td class="tnum">{money(perSqm)}</td>
                      <td>{listing.dpeClass ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap dvf">
      <span class="icon-pill icon-pill-navy"><Icon name="chart" /></span>
      <div>
        <p class="kicker">Source de marché</p>
        <h2>Les communes de notre secteur</h2>
        <p>
          La base « Demandes de valeurs foncières » publie chaque vente enregistrée par
          l’administration fiscale : prix, surface, date et adresse. C’est la seule source qui mesure
          les prix réellement conclus, et non les prix demandés dans les annonces. Elle est
          consultable gratuitement, commune par commune et rue par rue.
        </p>
        <p class="cluster">
          <a class="btn btn-navy" href="https://app.dvf.etalab.gouv.fr/" rel="noopener" target="_blank">
            Consulter la base DVF <Icon name="external" size={16} />
            <span class="visually-hidden">(nouvel onglet)</span>
          </a>
          <a class="btn btn-outline" href="/guides/estimation-immobiliere-4-methodes/">Comprendre les méthodes d’estimation</a>
        </p>
        {neighbours.length > 1 && (
          <div class="table-wrap compare">
            <table>
              <caption class="visually-hidden">Prix médian au m² par commune, ventes {meta.period}</caption>
              <thead>
                <tr>
                  <th scope="col">Commune</th>
                  <th scope="col">Maisons</th>
                  <th scope="col">Appartements</th>
                </tr>
              </thead>
              <tbody>
                {neighbours.map(([slug, c]) => (
                  <tr>
                    <th scope="row">
                      <a href={`/agence-immobiliere/${slug}/`}>{c.name}</a>
                    </th>
                    <td class="tnum">{perSqm(c.maison.medianPerSqm)} <span class="muted">({c.maison.count})</span></td>
                    <td class="tnum">{perSqm(c.appartement.medianPerSqm)} <span class="muted">({c.appartement.count})</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="small muted">
          Entre parenthèses, le nombre de ventes sur {meta.period}. Un prix médian ne dit rien de votre logement : son étage, son exposition, son état et son
          DPE font varier la valeur de plusieurs dizaines de milliers d’euros à surface égale. Un
          conseiller vous donne, sur rendez-vous, les ventes comparables récentes de votre quartier.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Faq items={faq} title="Prix immobilier à Mantes-la-Jolie : vos questions" />
    </div>
  </section>

  <CtaBand
    title="Estimer votre bien précisément"
    text="Une estimation gratuite et argumentée sous 48 h, fondée sur les ventes comparables de votre secteur et l’état réel de votre bien."
  />
</Base>

<style>
  .updated {
    margin: var(--space-s) 0 0;
  }

  .own {
    margin: var(--space-m) 0 var(--space-l);
  }

  .range {
    font-size: var(--step-2);
  }

  h3 {
    margin-top: var(--space-l);
  }

  .table-wrap + h3 {
    margin-top: var(--space-l);
  }

  .dvf {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .dvf {
      grid-template-columns: auto 1fr;
    }
  }

  .compare {
    margin: var(--space-m) 0;
  }

  .dvf p {
    max-width: var(--measure);
  }
</style>
