---
/**
 * Pied de page : marine, quatre colonnes (marque et reseaux / services /
 * l'agence / coordonnees et horaires), puis une barre basse avec les mentions
 * legales. Les coordonnees viennent du back-office (coherence NAP).
 */
import Icon from '~/components/Icon.astro';
import { COMPANY, FOOTER_AGENCY, FOOTER_LEGAL, FOOTER_SERVICES, SOCIAL, REGULATED } from '~/lib/site';
import { logoMedia } from '~/lib/catalog';
import { agency, field } from '~/lib/content';

const logo = logoMedia();
const contact = agency();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap top">
    <section class="brand">
      {
        logo && (
          <a href="/" class="logo" aria-label={`${COMPANY.name} — accueil`}>
            <picture>
              <source type="image/avif" srcset={`${logo.base}-180.avif 180w, ${logo.base}-360.avif 360w`} sizes="150px" />
              <img
                src={`${logo.base}-360.png`}
                alt={COMPANY.legalName}
                width="150"
                height={Math.round(150 / logo.ratio)}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
        )
      }
      <p class="pitch">{field('site.identite', 'pied_de_page')}</p>
      <ul class="social">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                <Icon name={s.label === 'Instagram' ? 'instagram' : 'tiktok'} size={18} />
                {s.label}
                <span class="visually-hidden"> (nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Services</h2>
      <ul class="links">
        {FOOTER_SERVICES.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>

    <section>
      <h2>L’agence</h2>
      <ul class="links">
        {FOOTER_AGENCY.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>

    <section class="contact">
      <h2>Nous trouver</h2>
      <address>
        <p>
          <Icon name="pin" size={18} />
          <span>{contact.street}<br />{contact.postalCode} {contact.city}</span>
        </p>
        <p>
          <Icon name="phone" size={18} />
          <a href={`tel:${contact.phoneE164}`} class="tnum">{contact.phone}</a>
        </p>
        <p>
          <Icon name="mail" size={18} />
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </address>
      <ul class="hours">
        {contact.hours.map((h) => <li>{h}</li>)}
      </ul>
    </section>
  </div>

  <div class="bottom">
    <div class="wrap bottom-inner">
      <ul class="legal">
        {FOOTER_LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <p class="credits">
        © {year} {COMPANY.legalName} · {COMPANY.legalForm} · Carte professionnelle {REGULATED.cpiNumber}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.82);
    font-size: var(--step--1);
  }

  .top {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  @media (min-width: 40rem) {
    .top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .top {
      grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
      gap: var(--space-xl);
    }
  }

  h2 {
    margin: 0 0 var(--space-s);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
  }

  .logo {
    display: inline-block;
    padding: 10px 14px;
    background: #fff;
    border-radius: var(--radius-s);
    margin-bottom: var(--space-s);
  }

  .logo img {
    width: 150px;
    height: auto;
  }

  .pitch {
    max-width: 34ch;
    color: rgb(255 255 255 / 0.75);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li,
  .hours li {
    margin-bottom: 0.45rem;
  }

  .site-footer a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--gold-300);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .social {
    display: flex;
    gap: var(--space-s);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }

  address {
    font-style: normal;
    margin-bottom: var(--space-s);
  }

  address p {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 0.5rem;
  }

  address svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--gold-300);
  }

  .hours {
    padding-top: var(--space-s);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.7);
  }

  .bottom {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    padding-block: var(--space-s);
  }

  .bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
  }

  .credits {
    margin: 0;
    color: rgb(255 255 255 / 0.55);
  }
</style>
