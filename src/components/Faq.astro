---
/**
 * FAQ visible. Les titres sont de vraies questions et la reponse tient en
 * 40-60 mots dans le premier paragraphe : c'est la forme que les moteurs
 * generatifs extraient (prompt v3 §11.1). Le balisage FAQPage n'est emis par
 * la page appelante que si cette FAQ est bien rendue.
 */
export interface FaqItem {
  question: string;
  answer: string;
  /** Precisions facultatives, affichees apres la reponse directe. */
  details?: string[];
}

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}
const { items, title = 'Questions fréquentes', id = 'faq' } = Astro.props;
---

<section class="faq" id={id}>
  <h2>{title}</h2>
  <div class="list">
    {
      items.map((item) => (
        <details name="faq">
          <summary><h3>{item.question}</h3></summary>
          <div class="answer">
            <p>{item.answer}</p>
            {item.details?.map((d) => <p class="small muted">{d}</p>)}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    max-width: var(--measure);
  }

  .list {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-block: var(--space-s);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    margin-left: auto;
    font-size: 1.4em;
    line-height: 1;
    color: var(--gold-600);
    transition: transform var(--dur) var(--ease-out);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  summary h3 {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
  }

  .answer {
    padding-bottom: var(--space-s);
  }

  .answer p:last-child {
    margin-bottom: 0;
  }
</style>
