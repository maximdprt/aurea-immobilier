---
/**
 * FAQ visible. Les titres sont de vraies questions et la reponse tient en
 * 40-60 mots dans le premier paragraphe : c'est la forme que les moteurs
 * generatifs extraient (prompt v3 §11.1). Le balisage FAQPage n'est emis par
 * la page appelante que si cette FAQ est bien rendue.
 */
import Icon from '~/components/Icon.astro';

export interface FaqItem {
  question: string;
  answer: string;
  /** Precisions facultatives, affichees apres la reponse directe. */
  details?: string[];
}

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}
const { items, title = 'Questions fréquentes', id = 'faq' } = Astro.props;
---

<section class="faq" id={id}>
  <h2>{title}</h2>
  <div class="list">
    {
      items.map((item) => (
        <details name={id}>
          <summary>
            <h3>{item.question}</h3>
            <Icon name="chevron" size={20} class="chev" />
          </summary>
          <div class="answer">
            <p>{item.answer}</p>
            {item.details?.map((d) => <p class="small muted">{d}</p>)}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    max-width: var(--measure);
  }

  .faq h2 {
    margin-bottom: var(--space-m);
  }

  details {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    margin-bottom: 0.6rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  details[open] {
    border-color: var(--gold-300);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 1rem 1.2rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(.chev) {
    flex: none;
    color: var(--gold-700);
    transition: transform var(--dur) var(--ease-out);
  }

  details[open] summary :global(.chev) {
    transform: rotate(180deg);
  }

  summary h3 {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--navy-900);
  }

  .answer {
    padding: 0 1.2rem 1.1rem;
    color: var(--ink-soft);
  }

  .answer p:last-child {
    margin-bottom: 0;
  }
</style>
