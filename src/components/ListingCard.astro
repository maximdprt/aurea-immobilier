---
/**
 * Carte de bien.
 *
 * La photo est l'heroine : grande, arrondie, seconde photo revelee au survol.
 * Sous la photo : le prix en premier (c'est ce que l'on cherche du regard),
 * puis le titre factuel, la commune, trois faits (pieces, chambres, surface)
 * et le conseiller. Toute la carte est cliquable ; le cœur « ma selection »
 * reste un bouton independant.
 */
import Picture from '~/components/Picture.astro';
import Icon from '~/components/Icon.astro';
import { listingMedia, agentBySlug, agentMedia } from '~/lib/catalog';
import { listingHeading, priceLine, statusLabel, area } from '~/lib/format';
import type { Listing } from '~/lib/types';

interface Props {
  listing: Listing;
  priority?: boolean;
  sizes?: string;
  /** Carte plus compacte (pied de page, colonnes etroites). */
  compact?: boolean;
}
const {
  listing,
  priority = false,
  sizes = '(min-width: 64rem) 24rem, (min-width: 48rem) 45vw, 92vw',
  compact = false,
} = Astro.props;

const media = listingMedia(listing.reference);
const photo = media?.photos[0] ?? null;
const photo2 = media?.photos[1] ?? null;
const isArchived = listing.status === 'sold' || listing.status === 'rented';
const href = `/bien/${listing.slug}/`;
const agent = listing.agentSlug ? agentBySlug(listing.agentSlug) : null;
const agentPhoto = agent ? agentMedia(agent.slug) : null;
const heading = listingHeading(listing);
---

<article class:list={['card-listing', isArchived && 'is-archived', compact && 'is-compact']}>
  <div class="media">
    <Picture media={photo} alt="" aspect="4 / 3" sizes={sizes} priority={priority} class="photo" />
    {photo2 && <Picture media={photo2} alt="" aspect="4 / 3" sizes={sizes} class="photo photo-alt" />}

    <ul class="badges" aria-label="Statut">
      {isArchived && <li class="badge badge-sold">{statusLabel(listing)}</li>}
      {!isArchived && listing.status === 'under_offer' && <li class="badge badge-navy">Sous compromis</li>}
      {listing.isExclusive && !isArchived && <li class="badge badge-gold">Exclusivité</li>}
    </ul>

    <button
      type="button"
      class="fav"
      data-fav={listing.reference}
      aria-pressed="false"
      aria-label="Ajouter à ma sélection"
    >
      <Icon name="heart" size={18} />
    </button>
  </div>

  <div class="body">
    <p class="price tnum">{priceLine(listing)}</p>
    <h3 class="title">
      <a href={href}>{heading}</a>
    </h3>
    {
      listing.commune && (
        <p class="place">
          <Icon name="pin" size={15} />
          {listing.commune}
          {listing.postalCode && <span class="muted"> ({listing.postalCode})</span>}
        </p>
      )
    }
    <ul class="facts-row">
      {
        listing.rooms && (
          <li>
            <Icon name="door" size={16} />
            {listing.rooms} pièce{listing.rooms > 1 ? 's' : ''}
          </li>
        )
      }
      {
        listing.bedrooms && (
          <li>
            <Icon name="bed" size={16} />
            {listing.bedrooms} ch.
          </li>
        )
      }
      {
        listing.livingArea && (
          <li>
            <Icon name="ruler" size={16} />
            {area(Math.round(listing.livingArea))}
          </li>
        )
      }
    </ul>
    <div class="foot">
      {
        agent ? (
          <span class="agent">
            {agentPhoto && <Picture media={agentPhoto} alt="" sizes="28px" aspect="1" class="agent-photo" />}
            <span>{agent.name}</span>
          </span>
        ) : (
          <span class="agent muted">Réf. {listing.reference}</span>
        )
      }
      <span class="more">Voir le bien <Icon name="arrow" size={16} /></span>
    </div>
  </div>
</article>

<style>
  .card-listing {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .card-listing:hover,
  .card-listing:focus-within {
    box-shadow: var(--shadow-l);
    transform: translateY(-3px);
    border-color: transparent;
  }

  /* --- Photo --------------------------------------------------------------- */
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand-100);
  }

  .media :global(.photo),
  .media :global(.photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }

  .media :global(.photo-alt) {
    opacity: 0;
  }

  .card-listing:hover .media :global(.photo-alt) {
    opacity: 1;
  }

  .card-listing:hover .media :global(.photo img) {
    transform: scale(1.03);
  }

  .is-archived .media :global(.photo img) {
    filter: grayscale(0.5);
  }

  .media :global(.img-missing) {
    position: absolute;
    inset: 0;
    border: 0;
    border-radius: 0;
  }

  .badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badges .badge {
    box-shadow: var(--shadow-s);
  }

  .fav {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    color: var(--navy-900);
    box-shadow: var(--shadow-s);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }

  .fav:hover {
    transform: scale(1.08);
  }

  .fav[aria-pressed='true'] {
    background: var(--navy-900);
    color: var(--gold-300);
  }

  .fav[aria-pressed='true'] svg {
    fill: currentColor;
  }

  /* --- Texte ---------------------------------------------------------------- */
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.1rem 1rem;
  }

  .is-compact .body {
    padding: 0.8rem 0.9rem;
  }

  .price {
    margin: 0 0 0.15rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy-900);
    letter-spacing: -0.01em;
  }

  .is-archived .price {
    color: var(--ink-muted);
  }

  .title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
  }

  /* Toute la carte est cliquable, sans imbriquer de lien dans un lien. */
  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .place {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0 0 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .place svg {
    color: var(--gold-600);
  }

  .facts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .facts-row li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .facts-row svg {
    color: var(--ink-muted);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.8rem;
    margin-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .agent {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-soft);
  }

  .agent :global(.agent-photo img) {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
    color: var(--navy-900);
    transition: gap var(--dur-fast) var(--ease-out);
  }

  .card-listing:hover .more {
    gap: 0.5rem;
    color: var(--gold-700);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-listing:hover {
      transform: none;
    }
    .card-listing:hover .media :global(.photo img) {
      transform: none;
    }
  }
</style>

<script>
  /* « Ma selection » : conservee dans le navigateur. */
  const KEY = 'aurea-selection';
  const read = (): number[] => {
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem(KEY) ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.map(Number).filter(Number.isFinite);
    } catch {
      return [];
    }
  };
  const write = (v: number[]) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(v));
    } catch {
      /* stockage indisponible : le bouton reste purement visuel */
    }
  };
  const current = new Set(read());
  document.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((btn) => {
    const ref = Number(btn.dataset.fav);
    const paint = () => {
      const on = current.has(ref);
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Retirer de ma sélection' : 'Ajouter à ma sélection');
    };
    paint();
    btn.addEventListener('click', () => {
      current.has(ref) ? current.delete(ref) : current.add(ref);
      write([...current]);
      paint();
    });
  });
</script>
