---
import type { Crumb } from '~/lib/schema';

interface Props {
  crumbs: Crumb[];
  /** Sur fond marine (fiche bien, par exemple). */
  onDark?: boolean;
}
const { crumbs, onDark = false } = Astro.props;
---

<nav class:list={['breadcrumb', onDark && 'on-dark']} aria-label="Fil d'Ariane">
  <ol>
    {
      crumbs.map((c, i) => (
        <li>
          {c.href && i < crumbs.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  li + li::before {
    content: '/';
    margin-right: 0.35rem;
    color: var(--line-strong);
  }

  a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--navy-900);
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--ink-soft);
  }

  .on-dark ol,
  .on-dark a {
    color: rgb(255 255 255 / 0.75);
  }

  .on-dark a:hover,
  .on-dark [aria-current='page'] {
    color: #fff;
  }

  .on-dark li + li::before {
    color: rgb(255 255 255 / 0.4);
  }
</style>
