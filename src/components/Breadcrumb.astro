---
import type { Crumb } from '~/lib/schema';

interface Props {
  crumbs: Crumb[];
  /**
   * Fil d'Ariane pose sur le bandeau marine d'une page interne : fond
   * transparent, texte clair, et pas de conteneur propre — le bandeau fournit
   * deja sa largeur de page.
   */
  onDark?: boolean;
}
const { crumbs, onDark = false } = Astro.props;
---

<nav class:list={['breadcrumb', onDark && 'on-dark']} aria-label="Fil d'Ariane">
  <ol class:list={[!onDark && 'wrap']}>
    {
      crumbs.map((c, i) => (
        <li>
          {c.href && i < crumbs.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
    background: var(--canvas);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  li + li::before {
    content: '/';
    margin-right: 0.35rem;
    color: var(--line-strong);
  }

  a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-1);
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--ink-soft);
  }

  /* --- Sur le bandeau marine ---------------------------------------------- */
  .on-dark {
    padding: 0 0 6px;
    border-bottom: 0;
    background: transparent;
  }

  .on-dark ol {
    color: rgba(255, 255, 255, 0.75);
  }

  .on-dark a {
    color: rgba(255, 255, 255, 0.75);
  }

  .on-dark a:hover {
    color: #ffffff;
  }

  .on-dark li + li::before {
    color: rgba(255, 255, 255, 0.45);
  }

  .on-dark [aria-current='page'] {
    color: #ffffff;
  }
</style>
