---
/**
 * Galerie de fiche bien.
 *
 * Premiere image prioritaire (c'est le LCP), les suivantes en lazy.
 * Defilement tactile par scroll-snap natif : aucune librairie de carrousel,
 * aucune animation automatique (prompt v3 §14). Le seul JS est la
 * synchronisation des vignettes, et la galerie reste utilisable sans lui.
 */
import Picture from '~/components/Picture.astro';
import type { ListingMedia } from '~/lib/types';

interface Props {
  media: ListingMedia | null;
  heading: string;
}
const { media, heading } = Astro.props;
const photos = media?.photos ?? [];
---

{
  photos.length > 0 && (
    <figure class="gallery">
      <div class="track" id="galerie" tabindex="0" aria-label={`Photos — ${heading}`}>
        {photos.map((p, i) => (
          <div class="slide" id={`photo-${i}`}>
            <Picture
              media={p}
              alt={p.alt || `${heading} — photo ${i + 1} sur ${photos.length}`}
              sizes="(min-width: 64rem) 62rem, 100vw"
              priority={i === 0}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>

      {photos.length > 1 && (
        <figcaption>
          <ol class="thumbs" aria-label="Vignettes">
            {photos.map((p, i) => (
              <li>
                <a href={`#photo-${i}`} aria-label={`Voir la photo ${i + 1}`}>
                  <picture>
                    <source type="image/avif" srcset={`${p.base}-400.avif`} />
                    <img
                      src={`${p.base}-${p.fallbackWidth ?? 800}.webp`}
                      alt=""
                      width="96"
                      height="72"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
              </li>
            ))}
          </ol>
          <p class="count small muted">{photos.length} photos</p>
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .gallery {
    margin: 0;
  }

  .track {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: var(--radius-m);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .slide :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  .thumbs {
    display: flex;
    gap: var(--space-3xs);
    overflow-x: auto;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    scrollbar-width: thin;
  }

  .thumbs img {
    width: 5rem;
    height: 3.75rem;
    object-fit: cover;
    border-radius: var(--radius-xs);
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  .thumbs a:hover img,
  .thumbs a:focus-visible img,
  .thumbs li[aria-current='true'] img {
    opacity: 1;
  }

  .thumbs li[aria-current='true'] img {
    outline: 2px solid var(--gold-600);
    outline-offset: 1px;
  }

  .count {
    flex: none;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .slide {
      flex-basis: min(100%, 62rem);
    }
  }
</style>

<script>
  // Marque la vignette correspondant a la photo visible. Sans ce script la
  // galerie fonctionne toujours : les vignettes restent des ancres.
  const track = document.getElementById('galerie');
  const thumbs = Array.from(document.querySelectorAll<HTMLLIElement>('.thumbs li'));
  if (track && thumbs.length) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.slide'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = slides.indexOf(entry.target as HTMLElement);
          thumbs.forEach((t, i) =>
            i === index ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')
          );
        }
      },
      { root: track, threshold: 0.6 }
    );
    slides.forEach((s) => io.observe(s));
  }
</script>
