---
/**
 * En-tete du site : barre claire, collante, logo a gauche, menu par intention
 * au centre, telephone et appel a l'action a droite. Sous 1024 px, un
 * panneau plein ecran remplace le menu.
 *
 * Le menu « L'agence » deroule un panneau avec une ligne d'explication par
 * entree : un visiteur qui ne connait pas l'agence sait ou il va avant de
 * cliquer.
 */
import Icon from '~/components/Icon.astro';
import { NAV, COMPANY } from '~/lib/site';
import { logoMedia } from '~/lib/catalog';
import { agency } from '~/lib/content';

interface Props {
  path: string;
}
const { path } = Astro.props;
const logo = logoMedia();
const contact = agency();
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const isCurrentGroup = (item: (typeof NAV)[number]) =>
  isCurrent(item.href) || Boolean(item.children?.some((c) => isCurrent(c.href)));
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${COMPANY.name} — accueil`}>
      {
        logo && (
          <picture>
            <source type="image/avif" srcset={`${logo.base}-180.avif 180w, ${logo.base}-360.avif 360w`} sizes="128px" />
            <img
              src={`${logo.base}-360.png`}
              srcset={`${logo.base}-180.png 180w, ${logo.base}-360.png 360w`}
              sizes="128px"
              alt={COMPANY.legalName}
              width="128"
              height={Math.round(128 / logo.ratio)}
              fetchpriority="high"
              decoding="sync"
            />
          </picture>
        )
      }
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>
        {
          NAV.map((item) => (
            <li class:list={[item.children && 'has-sub']}>
              <a
                href={item.href}
                aria-current={isCurrentGroup(item) ? 'page' : undefined}
                aria-haspopup={item.children ? 'true' : undefined}
              >
                {item.label}
                {item.children && <Icon name="chevron" size={16} />}
              </a>
              {item.children && (
                <div class="sub">
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                          <span class="sub-label">{c.label}</span>
                          {c.hint && <span class="sub-hint">{c.hint}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="phone" href={`tel:${contact.phoneE164}`}>
        <Icon name="phone" size={18} />
        <span class="phone-number tnum">{contact.phone}</span>
        <span class="visually-hidden">Appeler l’agence</span>
      </a>
      <a class="fav" href="/selection/" title="Ma sélection">
        <Icon name="heart" size={20} />
        <span class="visually-hidden">Ma sélection</span>
        <span class="fav-count" data-fav-count hidden></span>
      </a>
      <a class="btn btn-sm cta" href="/contact/">Contact</a>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-burger
      >
        <Icon name="menu" size={24} class="i-open" />
        <Icon name="close" size={24} class="i-close" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" class="nav-mobile" aria-label="Navigation principale (mobile)" hidden>
    <div class="wrap">
      <ul class="mobile-list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <ul class="mobile-sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mobile-actions">
        <a class="btn" href="/estimation/">Estimer mon bien</a>
        <a class="btn btn-outline" href="/contact/">Nous contacter</a>
        <a class="mobile-phone" href={`tel:${contact.phoneE164}`}>
          <Icon name="phone" size={18} /> {contact.phone}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const mobile = document.getElementById('menu-mobile');

  if (header) {
    const update = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  if (burger && mobile) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      mobile.hidden = !open;
      document.body.classList.toggle('menu-open', open);
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobile.hidden) {
        setOpen(false);
        burger.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  /* Compteur de la selection, lu depuis le stockage local (cle de ListingCard). */
  const badge = document.querySelector<HTMLElement>('[data-fav-count]');
  const paintFav = () => {
    if (!badge) return;
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem('aurea-selection') ?? '[]');
      const n = Array.isArray(parsed) ? parsed.length : 0;
      badge.textContent = String(n);
      badge.hidden = n === 0;
    } catch {
      badge.hidden = true;
    }
  };
  paintFav();
  window.addEventListener('storage', paintFav);
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement | null)?.closest('[data-fav]')) setTimeout(paintFav, 0);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-stuck {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px rgb(0 31 65 / 0.06);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    height: var(--header-height);
  }

  .logo {
    flex: none;
    display: block;
  }

  .logo img {
    width: 104px;
    height: auto;
  }

  @media (min-width: 64rem) {
    .logo img {
      width: 128px;
    }
  }

  /* --- Menu desktop ------------------------------------------------------- */
  .nav-desktop {
    display: none;
  }

  .nav-desktop > ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop > ul > li {
    position: relative;
  }

  .nav-desktop > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-s);
    color: var(--navy-900);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .nav-desktop > ul > li > a:hover,
  .nav-desktop > ul > li > a:focus-visible {
    background: var(--sand-50);
  }

  .nav-desktop > ul > li > a[aria-current='page'] {
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--gold-400);
    border-radius: var(--radius-s) var(--radius-s) 0 0;
  }

  /* --- Sous-menu « L'agence » ---------------------------------------------- */
  .sub {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translate(-50%, 6px);
    min-width: 24rem;
    padding: 0.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-l);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility 0s linear var(--dur-fast);
  }

  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  .sub ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sub a {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-s);
    text-decoration: none;
    color: var(--navy-900);
  }

  .sub a:hover,
  .sub a:focus-visible,
  .sub a[aria-current='page'] {
    background: var(--sand-50);
  }

  .sub-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .sub-hint {
    font-size: 0.8rem;
    color: var(--ink-muted);
    line-height: 1.3;
  }

  /* --- Outils a droite ----------------------------------------------------- */
  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .phone,
  .fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.55rem;
    border-radius: var(--radius-s);
    color: var(--navy-900);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .phone:hover,
  .fav:hover {
    background: var(--sand-50);
    color: var(--navy-900);
  }

  .phone-number {
    display: none;
  }

  .fav {
    position: relative;
  }

  .fav-count {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
    color: var(--navy-900);
    font-size: 0.7rem;
    line-height: 1.1rem;
    text-align: center;
  }

  .cta {
    display: none;
  }

  .burger {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--navy-900);
    cursor: pointer;
  }

  .burger .i-close,
  .burger[aria-expanded='true'] .i-open {
    display: none;
  }

  .burger[aria-expanded='true'] .i-close {
    display: block;
  }

  /* --- Menu mobile --------------------------------------------------------- */
  .nav-mobile {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    overflow: auto;
    background: #fff;
    border-top: 1px solid var(--line);
    padding-block: var(--space-m) var(--space-2xl);
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  .mobile-list {
    list-style: none;
    margin: 0 0 var(--space-m);
    padding: 0;
  }

  .mobile-list > li > a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--navy-900);
    text-decoration: none;
  }

  .mobile-list > li > a[aria-current='page'] {
    color: var(--gold-700);
  }

  .mobile-sub {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-sub a {
    display: block;
    padding: 0.45rem 0 0.45rem 1rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .mobile-actions {
    display: grid;
    gap: var(--space-2xs);
  }

  .mobile-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .nav-desktop {
      display: block;
    }

    .burger,
    .nav-mobile {
      display: none !important;
    }

    .cta {
      display: inline-flex;
      margin-left: 0.35rem;
    }
  }

  @media (min-width: 75rem) {
    .phone-number {
      display: inline;
    }
  }
</style>
