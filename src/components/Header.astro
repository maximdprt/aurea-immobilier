---
/**
 * En-tête du site, sur le modèle de l'identité AUREA : bandeau marine plein,
 * grand logo doré à gauche, six rubriques en capitales (Notre agence, Nos
 * biens, Nos réussites, Gestion locative, Nos services, Nous contacter), puis
 * la sélection (cœur) et l'espace agence (compte).
 *
 * Les rubriques qui regroupent plusieurs pages (Notre agence, Nos biens, Nos
 * services) ouvrent un méga-menu : sous-rubriques avec une ligne
 * d'explication, et une carte mise en avant à droite.
 *
 * Sous 1216 px : tiroir latéral avec rubriques dépliables, gros boutons
 * d'estimation et d'appel, horaires.
 *
 * Accessibilité : les rubriques à sous-menu sont des boutons `aria-expanded` ;
 * Échap ferme et rend le focus ; sans JavaScript, les panneaux s'ouvrent au
 * survol et au focus clavier.
 */
import Icon, { type IconName } from '~/components/Icon.astro';
import Picture from '~/components/Picture.astro';
import { NAV, COMPANY, SOCIAL, type NavItem } from '~/lib/site';
import { activeListings, catalogStats, editorialMedia, listingMedia, logoMedia } from '~/lib/catalog';
import { agency } from '~/lib/content';
import { listingHeading, priceLine } from '~/lib/format';

interface Props {
  path: string;
}
const { path } = Astro.props;
const logo = logoMedia();
const contact = agency();
const stats = catalogStats();

const isCurrent = (href: string) => path === href.split('?')[0];
const isActive = (item: NavItem) =>
  path === item.href || Boolean(item.match?.some((m) => path.startsWith(m)));

/* Cartes mises en avant, calculées une fois au build. */
const latest = activeListings('vente')[0] ?? null;
const latestPhoto = latest ? (listingMedia(latest.reference)?.photos[0] ?? null) : null;
const agencePhoto = editorialMedia('agence');
const socialIcon = (label: string): IconName => (label === 'Instagram' ? 'instagram' : 'tiktok');
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="/" class="logo" aria-label={`${COMPANY.name} — accueil`}>
      {
        logo && (
          <picture>
            <source type="image/avif" srcset={`${logo.base}-180.avif 180w, ${logo.base}-360.avif 360w`} sizes="140px" />
            <img
              src={`${logo.base}-360.png`}
              srcset={`${logo.base}-180.png 180w, ${logo.base}-360.png 360w`}
              sizes="140px"
              alt={COMPANY.legalName}
              width="140"
              height={Math.round(140 / logo.ratio)}
              fetchpriority="high"
              decoding="sync"
            />
          </picture>
        )
      }
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {
          NAV.map((item, i) =>
            item.children ? (
              <li class="nav-item" data-nav-item>
                <button
                  type="button"
                  class:list={['nav-trigger', isActive(item) && 'is-active']}
                  aria-expanded="false"
                  aria-controls={`panel-${i}`}
                  data-nav-trigger
                >
                  {item.label}
                </button>

                <div class="panel" id={`panel-${i}`} data-nav-panel hidden>
                  <div class="wrap panel-inner">
                    <div class="panel-links">
                      <p class="panel-title">
                        <a href={item.href} class="link-arrow">
                          {item.label}
                        </a>
                      </p>
                      <ul>
                        {item.children.map((c) => (
                          <li>
                            <a href={c.href} class="panel-link" aria-current={isCurrent(c.href) ? 'page' : undefined}>
                              <span class="pl-icon">
                                <Icon name={(c.icon ?? 'arrow') as IconName} size={20} />
                              </span>
                              <span>
                                <span class="pl-label">{c.label}</span>
                                {c.hint && <span class="pl-hint">{c.hint}</span>}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <aside class="panel-feature">
                      {item.feature === 'achat' && latest && (
                        <a class="feat feat-photo" href={`/bien/${latest.slug}/`}>
                          <Picture media={latestPhoto} alt="" aspect="4 / 3" sizes="20rem" />
                          <span class="feat-body">
                            <span class="feat-kicker">Dernier bien en vente</span>
                            <span class="feat-price tnum">{priceLine(latest)}</span>
                            <span class="feat-title">{listingHeading(latest)}</span>
                          </span>
                        </a>
                      )}
                      {item.feature === 'achat' && (
                        <p class="feat-note">
                          <strong>{stats.forSale}</strong> biens à vendre et <strong>{stats.forRent}</strong> à
                          louer en ce moment.
                        </p>
                      )}

                      {item.feature === 'vente' && (
                        <div class="feat feat-navy">
                          <span class="feat-kicker">Vous vendez ?</span>
                          <span class="feat-big">Estimation gratuite sous 48 h</span>
                          <span class="feat-text">
                            Un conseiller se déplace, croise quatre méthodes et vous remet un avis de valeur
                            écrit. Sans engagement.
                          </span>
                          <a class="btn" href="/estimation/">Estimer mon bien</a>
                          <span class="feat-proof">
                            <Icon name="check" size={16} /> {stats.archivedTotal} biens vendus ou loués depuis 2024
                          </span>
                        </div>
                      )}

                      {item.feature === 'agence' && (
                        <div class="feat feat-plain">
                          <Picture media={agencePhoto} alt="" aspect="16 / 10" sizes="20rem" class="feat-img" />
                          <span class="feat-kicker">Passez nous voir</span>
                          <span class="feat-title">
                            {contact.street}, {contact.postalCode} {contact.city}
                          </span>
                          <ul class="feat-hours">
                            {contact.hours.map((h) => (
                              <li>{h}</li>
                            ))}
                          </ul>
                          <a class="feat-phone tnum" href={`tel:${contact.phoneE164}`}>
                            <Icon name="phone" size={16} /> {contact.phone}
                          </a>
                        </div>
                      )}
                    </aside>
                  </div>
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={item.href}
                  class:list={['nav-trigger', isActive(item) && 'is-active']}
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="tool" href="/selection/" title="Ma sélection">
        <Icon name="heart" size={22} />
        <span class="visually-hidden">Ma sélection</span>
        <span class="fav-count" data-fav-count hidden></span>
      </a>
      <a class="tool" href="/admin/" title="Espace agence" rel="nofollow">
        <Icon name="user" size={22} />
        <span class="visually-hidden">Espace agence</span>
      </a>
      <button class="tool burger" type="button" aria-expanded="false" aria-controls="drawer" data-burger>
        <Icon name="menu" size={26} />
        <span class="visually-hidden">Ouvrir le menu</span>
      </button>
    </div>
  </div>
</header>

<div class="backdrop" data-backdrop hidden></div>

<aside id="drawer" class="drawer" aria-label="Menu" data-drawer hidden>
  <div class="drawer-head">
    <a href="/" class="drawer-logo" aria-label={`${COMPANY.name} — accueil`}>
      {logo && <img src={`${logo.base}-180.png`} alt="" width="100" height={Math.round(100 / logo.ratio)} loading="lazy" />}
    </a>
    <button type="button" class="drawer-close" data-drawer-close>
      <Icon name="close" size={24} />
      <span class="visually-hidden">Fermer le menu</span>
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navigation principale (mobile)">
    {
      NAV.map((item) =>
        item.children ? (
          <details class="dgroup" open={isActive(item) ? true : undefined}>
            <summary class:list={[isActive(item) && 'is-active']}>
              {item.label}
              <Icon name="chevron" size={20} class="chev" />
            </summary>
            <ul>
              {item.children.map((c) => (
                <li>
                  <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                    <Icon name={(c.icon ?? 'arrow') as IconName} size={18} />
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a class:list={['dlink', isActive(item) && 'is-active']} href={item.href}>
            {item.label}
          </a>
        )
      )
    }
  </nav>

  <div class="drawer-foot">
    <a class="btn btn-lg" href="/estimation/"><Icon name="chart" size={18} /> Estimer mon bien</a>
    <a class="btn btn-lg btn-navy" href={`tel:${contact.phoneE164}`}>
      <Icon name="phone" size={18} /> <span class="tnum">{contact.phone}</span>
    </a>
    <div class="drawer-info">
      <p><Icon name="pin" size={16} /> {contact.street}, {contact.postalCode} {contact.city}</p>
      <ul>
        {contact.hours.map((h) => <li>{h}</li>)}
      </ul>
      <p class="drawer-social">
        {
          SOCIAL.map((s) => (
            <a href={s.url} rel="me noopener" target="_blank">
              <Icon name={socialIcon(s.label)} size={18} /> {s.label}
            </a>
          ))
        }
      </p>
    </div>
  </div>
</aside>

<script>
  document.documentElement.classList.add('js-nav');

  const header = document.querySelector<HTMLElement>('[data-header]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')];

  /* --- Ombre une fois la page défilée ----------------------------------- */
  const paintBar = () => header?.classList.toggle('is-stuck', window.scrollY > 10);
  paintBar();
  window.addEventListener('scroll', paintBar, { passive: true });

  /* --- Méga-menus -------------------------------------------------------- */
  let openItem: HTMLElement | null = null;
  let closeTimer: number | undefined;
  let openTimer: number | undefined;

  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>('[data-nav-trigger]')!,
    panel: item.querySelector<HTMLElement>('[data-nav-panel]')!,
  });

  const close = (item: HTMLElement | null, focusBack = false) => {
    if (!item) return;
    const { trigger, panel } = parts(item);
    trigger.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    if (openItem === item) openItem = null;
    if (focusBack) trigger.focus();
  };

  const open = (item: HTMLElement) => {
    if (openItem && openItem !== item) close(openItem);
    const { trigger, panel } = parts(item);
    trigger.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
    openItem = item;
  };

  for (const item of items) {
    const { trigger } = parts(item);

    trigger.addEventListener('click', () => {
      window.clearTimeout(openTimer);
      openItem === item ? close(item) : open(item);
    });

    // Survol à la souris, avec un léger délai pour ne pas ouvrir un menu
    // simplement parce que le pointeur a traversé la barre.
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      window.clearTimeout(closeTimer);
      window.clearTimeout(openTimer);
      openTimer = window.setTimeout(() => open(item), openItem ? 0 : 90);
    });
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(() => close(item), 180);
    });

    item.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !item.contains(next)) close(item);
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openItem) close(openItem, true);
  });
  document.addEventListener('click', (e) => {
    if (openItem && !openItem.contains(e.target as Node)) close(openItem);
  });

  /* --- Tiroir mobile ----------------------------------------------------- */
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  const setDrawer = (on: boolean) => {
    if (!drawer || !backdrop || !burger) return;
    burger.setAttribute('aria-expanded', String(on));
    document.body.classList.toggle('drawer-open', on);
    if (on) {
      drawer.hidden = false;
      backdrop.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
      });
      closeBtn?.focus();
    } else {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      window.setTimeout(() => {
        drawer.hidden = true;
        backdrop.hidden = true;
      }, 260);
      burger.focus();
    }
  };

  burger?.addEventListener('click', () => setDrawer(true));
  closeBtn?.addEventListener('click', () => setDrawer(false));
  backdrop?.addEventListener('click', () => setDrawer(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) setDrawer(false);
  });
  window.matchMedia('(min-width: 76rem)').addEventListener('change', (e) => {
    if (e.matches && drawer && !drawer.hidden) setDrawer(false);
  });

  /* --- Compteur de la sélection (clé de ListingCard) --------------------- */
  const badge = document.querySelector<HTMLElement>('[data-fav-count]');
  const paintFav = () => {
    if (!badge) return;
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem('aurea-selection') ?? '[]');
      const n = Array.isArray(parsed) ? parsed.length : 0;
      badge.textContent = String(n);
      badge.hidden = n === 0;
    } catch {
      badge.hidden = true;
    }
  };
  paintFav();
  window.addEventListener('storage', paintFav);
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement | null)?.closest('[data-fav]')) setTimeout(paintFav, 0);
  });
</script>

<style>
  /* ---------------------------------------------------- Barre principale -- */
  .site-header {
    --nav-size: 0.98rem;
    --nav-pad: 0.55rem;
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy-900);
    color: #ffffff;
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-stuck {
    box-shadow: 0 10px 30px rgb(0 19 42 / 0.35);
  }

  /* Plus large que le contenu : le logo et les icônes respirent aux bords. */
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    width: min(100% - var(--gutter) * 2, 92rem);
    height: var(--header-height);
    margin-inline: auto;
  }

  .logo {
    flex: none;
    display: block;
    margin-right: auto;
  }

  .logo img {
    width: 104px;
    height: auto;
  }

  /* --- Navigation ---------------------------------------------------------- */
  .nav {
    display: none;
    align-self: stretch;
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
  }

  /* Capitales à empattement, comme l'identité d'origine. */
  .nav-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--nav-pad);
    border: 0;
    background: none;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--nav-size);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-trigger:hover,
  .nav-trigger:focus-visible,
  .nav-trigger[aria-expanded='true'] {
    color: var(--gold-300);
  }

  /* Filet or sous l'entrée active ou ouverte. */
  .nav-trigger::after {
    content: '';
    position: absolute;
    left: var(--nav-pad);
    right: var(--nav-pad);
    bottom: calc(50% - 1.05em);
    height: 2px;
    border-radius: 2px;
    background: var(--gold-400);
    transform: scaleX(0);
    transition: transform var(--dur) var(--ease-out);
  }

  .nav-trigger:hover::after,
  .nav-trigger[aria-expanded='true']::after,
  .nav-trigger.is-active::after {
    transform: scaleX(1);
  }

  /* --- Méga-menu ------------------------------------------------------------ */
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    color: var(--ink);
    border-top: 3px solid var(--gold-400);
    box-shadow: 0 30px 60px -20px rgb(0 31 65 / 0.35);
    animation: panel-in var(--dur) var(--ease-out);
  }

  /* Sans JavaScript : ouverture au survol et au focus. */
  :global(:root:not(.js-nav)) .nav-item:hover > .panel,
  :global(:root:not(.js-nav)) .nav-item:focus-within > .panel {
    display: block;
  }

  /* Glissement seul, sans fondu : le panneau reste opaque à chaque image. */
  @keyframes panel-in {
    from {
      transform: translateY(-8px);
    }
    to {
      transform: none;
    }
  }

  .panel-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-xl);
    padding-block: var(--space-l);
  }

  .panel-title {
    margin: 0 0 var(--space-s);
    font-size: 0.85rem;
  }

  .panel-title a {
    color: var(--gold-700);
  }

  .panel-links ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel-link {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.8rem;
    border-radius: var(--radius-m);
    color: var(--navy-900);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .panel-link:hover,
  .panel-link:focus-visible,
  .panel-link[aria-current='page'] {
    background: var(--sand-50);
    color: var(--navy-900);
  }

  .pl-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-s);
    background: var(--navy-50);
    color: var(--navy-800);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .panel-link:hover .pl-icon {
    background: var(--gold-400);
    color: var(--navy-900);
  }

  .pl-label {
    display: block;
    font-weight: 600;
    font-size: 0.97rem;
  }

  .pl-hint {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 1.35;
  }

  /* --- Carte mise en avant -------------------------------------------------- */
  .feat {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-m);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .feat-photo {
    border: 1px solid var(--line);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .feat-photo:hover {
    box-shadow: var(--shadow-l);
    color: inherit;
  }

  .feat-photo :global(img) {
    width: 100%;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .feat-photo:hover :global(img) {
    transform: scale(1.04);
  }

  .feat-body {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem 1rem;
  }

  .feat-kicker {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--gold-700);
  }

  .feat-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .feat-title {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .feat-note {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .feat-note strong {
    color: var(--navy-900);
  }

  .feat-navy {
    gap: 0.65rem;
    padding: 1.4rem;
    background: var(--navy-900);
    color: #fff;
    background-image: radial-gradient(circle at 100% 0%, rgb(224 174 94 / 0.25), transparent 55%);
  }

  .feat-navy .feat-kicker {
    color: var(--gold-300);
  }

  .feat-big {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .feat-text {
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.78);
  }

  .feat-navy .btn {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  .feat-proof {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.7);
  }

  .feat-proof :global(svg) {
    color: var(--gold-300);
  }

  .feat-plain {
    gap: 0.3rem;
  }

  .feat-plain :global(.feat-img img) {
    border-radius: var(--radius-m);
    margin-bottom: 0.6rem;
  }

  .feat-plain .feat-title {
    font-weight: 600;
    color: var(--navy-900);
  }

  .feat-hours {
    margin: 0.3rem 0 0.4rem;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .feat-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--navy-900);
    text-decoration: none;
  }

  /* --- Outils ---------------------------------------------------------------- */
  .tools {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .tool {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-s);
    background: none;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }

  .tool:hover,
  .tool:focus-visible {
    color: var(--gold-300);
    background: rgb(255 255 255 / 0.06);
  }

  .fav-count {
    position: absolute;
    top: 3px;
    right: 1px;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
    color: var(--navy-900);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.15rem;
    text-align: center;
  }

