---
/**
 * Placeholder pour une information que l'agence n'a pas encore fournie.
 *
 * Il n'apparait QUE si le build est lance avec `PUBLIC_RECETTE=1` : un
 * visiteur ne doit jamais voir un « [[à fournir]] » jaune sur le site en
 * ligne. Le tableau de bord du back-office liste, lui, tout ce qui manque.
 * Les pages sont ecrites pour rester correctes quand ce composant ne rend
 * rien : une phrase entiere ne doit pas dependre de sa presence.
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
const recette = import.meta.env.PUBLIC_RECETTE === '1';
---

{
  recette && (
    <span class="todo" data-todo title="Information à fournir par l'agence avant la mise en ligne">
      [[{label}]]
    </span>
  )
}
