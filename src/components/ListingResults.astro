---
/**
 * Liste de biens : filtres, tri, compteur, grille, pagination.
 *
 * Tout se fait cote client sur la liste complete deja rendue : aucune URL de
 * filtre n'est creee (la canonique reste celle de la liste, §7). Les
 * parametres envoyes par le moteur de recherche de l'accueil (?commune=,
 * ?type=, ?budget=...) pre-remplissent les criteres.
 */
import ListingCard from '~/components/ListingCard.astro';
import Icon from '~/components/Icon.astro';
import type { Listing } from '~/lib/types';

interface Props {
  listings: Listing[];
  showFilters?: boolean;
  emptyMessage?: string;
  perPage?: number;
}
const {
  listings,
  showFilters = true,
  emptyMessage = 'Aucun bien ne correspond à cette recherche pour le moment.',
  perPage = 12,
} = Astro.props;

const communes = [
  ...new Map(
    listings
      .filter((l) => l.commune && l.communeSlug)
      .map((l) => [l.communeSlug as string, l.commune as string])
  ).entries(),
].sort((a, b) => a[1].localeCompare(b[1], 'fr'));

const types = [...new Set(listings.map((l) => l.propertyType))];
const typeLabels: Record<string, string> = {
  maison: 'Maison',
  appartement: 'Appartement',
  immeuble: 'Immeuble',
  terrain: 'Terrain',
  local: 'Local',
};
const isRental = listings.length > 0 && listings.every((l) => l.transaction === 'location');
---

<div class="listing" data-listing-root data-per-page={perPage}>
  {
    showFilters && listings.length > 0 && (
      <details class="filters-box" data-filters-box>
        <summary>
          <span><Icon name="layers" size={18} /> Affiner la recherche</span>
          <Icon name="chevron" size={18} class="chev" />
        </summary>
        <form class="filters" data-filters>
          <p class="f">
            <label for="f-commune">Commune</label>
            <select id="f-commune" name="commune">
              <option value="">Toutes</option>
              {communes.map(([slug, name]) => (
                <option value={slug}>{name}</option>
              ))}
            </select>
          </p>
          <p class="f">
            <label for="f-type">Type de bien</label>
            <select id="f-type" name="type">
              <option value="">Tous</option>
              {types.map((t) => (
                <option value={t}>{typeLabels[t] ?? t}</option>
              ))}
            </select>
          </p>
          <p class="f">
            <label for="f-budget-min">{isRental ? 'Loyer min (€)' : 'Budget min (€)'}</label>
            <input id="f-budget-min" name="budgetmin" type="number" min="0" step={isRental ? 50 : 1000} inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-budget">{isRental ? 'Loyer max (€)' : 'Budget max (€)'}</label>
            <input id="f-budget" name="budget" type="number" min="0" step={isRental ? 50 : 1000} inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-surface">Surface min (m²)</label>
            <input id="f-surface" name="surface" type="number" min="0" inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-surface-max">Surface max (m²)</label>
            <input id="f-surface-max" name="surfacemax" type="number" min="0" inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-rooms">Pièces min</label>
            <input id="f-rooms" name="rooms" type="number" min="1" inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-bedrooms">Chambres min</label>
            <input id="f-bedrooms" name="bedrooms" type="number" min="1" inputmode="numeric" />
          </p>
          <p class="f">
            <label for="f-ref">Référence</label>
            <input id="f-ref" name="ref" type="text" inputmode="numeric" />
          </p>
          <p class="f actions">
            <button type="submit" class="btn btn-navy">Appliquer</button>
            <button type="reset" class="btn btn-outline">Effacer</button>
          </p>
        </form>
      </details>
    )
  }

  <div class="bar">
    <p class="count" role="status" data-count>
      <strong>{listings.length}</strong> bien{listings.length > 1 ? 's' : ''}
    </p>
    <p class="sort">
      <label for="f-sort">Trier</label>
      <select id="f-sort" name="sort" data-sort>
        <option value="date">Nouveautés d’abord</option>
        <option value="asc">Prix croissant</option>
        <option value="desc">Prix décroissant</option>
        <option value="area">Surface décroissante</option>
      </select>
    </p>
  </div>

  <div class="grid" data-results>
    {
      listings.map((l, i) => (
        <div
          class="listing-item"
          data-listing
          data-index={i}
          data-commune={l.communeSlug ?? ''}
          data-type={l.propertyType}
          data-area={l.livingArea ?? 0}
          data-rooms={l.rooms ?? 0}
          data-bedrooms={l.bedrooms ?? 0}
          data-price={l.price ?? 0}
          data-ref={l.reference}
        >
          <ListingCard listing={l} priority={i < 3} />
        </div>
      ))
    }
  </div>

  <div class="empty" data-empty hidden>
    <p class="notice">{emptyMessage}</p>
    <p><a class="btn btn-outline" href="/alerte/"><Icon name="bell" size={18} /> Créer une alerte pour cette recherche</a></p>
  </div>
  {
    listings.length === 0 && (
      <div class="empty">
        <p class="notice">{emptyMessage}</p>
        <p><a class="btn btn-outline" href="/alerte/"><Icon name="bell" size={18} /> Créer une alerte</a></p>
      </div>
    )
  }

  <nav class="pagination" aria-label="Pagination" data-pagination hidden></nav>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-listing-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-filters]');
    const box = root.querySelector<HTMLDetailsElement>('[data-filters-box]');
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]');
    const grid = root.querySelector<HTMLElement>('[data-results]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const pager = root.querySelector<HTMLElement>('[data-pagination]');
    const perPage = Number(root.dataset.perPage) || 12;
    if (!grid || !count || !empty || !pager) return;

    const items = [...grid.querySelectorAll<HTMLElement>('[data-listing]')];
    let page = 1;

    // Les filtres sont deplies sur grand ecran, replies sur mobile.
    if (box && window.matchMedia('(min-width: 64rem)').matches) box.open = true;

    // Pre-remplissage depuis l'URL (moteur de recherche de l'accueil).
    const params = new URLSearchParams(location.search);
    let prefilled = false;
    if (form) {
      for (const [k, v] of params) {
        const f = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
        if (f && 'value' in f) {
          f.value = v;
          prefilled = true;
        }
      }
      if (prefilled && box) box.open = true;
    }

    const num = (name: string) => {
      const f = form?.elements.namedItem(name) as HTMLInputElement | null;
      const v = Number(f?.value);
      return f && f.value !== '' && Number.isFinite(v) ? v : null;
    };
    const str = (name: string) => {
      const f = form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      return f?.value?.trim() ?? '';
    };

    const matches = (el: HTMLElement) => {
      if (!form) return true;
      const d = el.dataset;
      const commune = str('commune');
      const type = str('type');
      const ref = str('ref');
      if (commune && d.commune !== commune) return false;
      if (type && d.type !== type) return false;
      if (ref && d.ref !== ref) return false;
      const area = Number(d.area), price = Number(d.price), rooms = Number(d.rooms), bedrooms = Number(d.bedrooms);
      const sMin = num('surface'), sMax = num('surfacemax'), bMin = num('budgetmin'), bMax = num('budget');
      const rMin = num('rooms'), cMin = num('bedrooms');
      if (sMin !== null && area < sMin) return false;
      if (sMax !== null && area > sMax) return false;
      if (bMin !== null && price < bMin) return false;
      if (bMax !== null && price > bMax) return false;
      if (rMin !== null && rooms < rMin) return false;
      if (cMin !== null && bedrooms < cMin) return false;
      return true;
    };

    const render = () => {
      const kept = items.filter(matches);
      const mode = sort?.value ?? 'date';
      kept.sort((a, b) => {
        if (mode === 'asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (mode === 'desc') return Number(b.dataset.price) - Number(a.dataset.price);
        if (mode === 'area') return Number(b.dataset.area) - Number(a.dataset.area);
        return Number(a.dataset.index) - Number(b.dataset.index);
      });

      const pages = Math.max(1, Math.ceil(kept.length / perPage));
      page = Math.min(page, pages);
      const start = (page - 1) * perPage;
      const visible = new Set(kept.slice(start, start + perPage));

      items.forEach((el) => (el.hidden = !visible.has(el)));
      kept.forEach((el, i) => (el.style.order = String(i)));

      count.innerHTML = `<strong>${kept.length}</strong> bien${kept.length > 1 ? 's' : ''}`;
      empty.hidden = kept.length > 0;

      pager.hidden = pages <= 1;
      pager.replaceChildren();
      if (pages > 1) {
        for (let p = 1; p <= pages; p++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = String(p);
          if (p === page) b.setAttribute('aria-current', 'page');
          b.addEventListener('click', () => {
            page = p;
            render();
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          pager.append(b);
        }
        if (page < pages) {
          const next = document.createElement('button');
          next.type = 'button';
          next.textContent = 'Suivante';
          next.addEventListener('click', () => {
            page += 1;
            render();
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          pager.append(next);
        }
      }
    };

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      page = 1;
      render();
    });
    form?.addEventListener('reset', () => {
      setTimeout(() => {
        page = 1;
        render();
      }, 0);
    });
    form?.addEventListener('change', () => {
      page = 1;
      render();
    });
    sort?.addEventListener('change', () => {
      page = 1;
      render();
    });
    render();
  });
</script>

<style>
  .filters-box {
    margin: 0 0 var(--space-m);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    font-weight: 600;
    color: var(--navy-900);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  summary :global(.chev) {
    transition: transform var(--dur) var(--ease-out);
  }

  .filters-box[open] summary :global(.chev) {
    transform: rotate(180deg);
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem 1rem;
    align-items: end;
    padding: 0 1.1rem 1.1rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .f {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .f label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .filters select,
  .filters input {
    height: 2.7rem;
    padding-block: 0;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    grid-column: 1 / -1;
    justify-content: flex-end;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .count {
    margin: 0;
    color: var(--ink-soft);
  }

  .count strong {
    color: var(--navy-900);
    font-size: 1.15rem;
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .sort select {
    width: auto;
    height: 2.5rem;
    padding-block: 0;
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: var(--space-m);
  }

  .listing-item[hidden] {
    display: none;
  }

  .empty {
    margin-top: var(--space-m);
  }

  .pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-l);
  }

  .pagination :global(button) {
    min-width: 2.6rem;
    height: 2.6rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: #fff;
    color: var(--navy-900);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .pagination :global(button:hover),
  .pagination :global(button[aria-current='page']) {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: #fff;
  }
</style>
