---
/**
 * Moteur de recherche : onglets Acheter / Louer, puis commune, type de bien,
 * budget et le bouton. Les criteres partent en parametres d'URL vers
 * /acheter/ ou /louer/, ou la liste les applique cote client — aucune page de
 * filtre n'est creee, la canonique reste celle de la liste.
 */
import Icon from '~/components/Icon.astro';
import { communesWithPage } from '~/lib/catalog';

interface Props {
  /** Sur fond sombre (hero) ou clair. */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

const communes = communesWithPage();
const TYPES = [
  ['maison', 'Maison'],
  ['appartement', 'Appartement'],
  ['immeuble', 'Immeuble'],
  ['terrain', 'Terrain'],
  ['local', 'Local'],
] as const;
---

<form class:list={['search', onDark && 'on-dark']} method="get" action="/acheter/" data-search>
  <div class="tabs" role="tablist" aria-label="Type de recherche">
    <button type="button" role="tab" aria-selected="true" data-transac="vente">Acheter</button>
    <button type="button" role="tab" aria-selected="false" data-transac="location">Louer</button>
    <a role="tab" href="/estimation/" aria-selected="false" class="tab-link">Estimer mon bien</a>
  </div>

  <div class="row">
    <p class="f">
      <label for="s-commune">Commune</label>
      <select id="s-commune" name="commune">
        <option value="">Tout le Mantois</option>
        {communes.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>
    </p>
    <p class="f">
      <label for="s-type">Type de bien</label>
      <select id="s-type" name="type">
        <option value="">Tous les biens</option>
        {TYPES.map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
    </p>
    <p class="f">
      <label for="s-budget">Budget maximum</label>
      <input id="s-budget" name="budget" type="number" min="0" step="1000" inputmode="numeric" placeholder="€" />
    </p>
    <p class="f f-more" hidden data-more>
      <label for="s-rooms">Pièces minimum</label>
      <input id="s-rooms" name="rooms" type="number" min="1" inputmode="numeric" placeholder="Indifférent" />
    </p>
    <p class="f f-more" hidden data-more>
      <label for="s-surface">Surface minimum</label>
      <input id="s-surface" name="surface" type="number" min="0" inputmode="numeric" placeholder="m²" />
    </p>
    <p class="submit">
      <button type="submit" class="btn btn-navy">
        <Icon name="search" size={18} /> Rechercher
      </button>
    </p>
  </div>

  <p class="more-toggle">
    <button type="button" class="btn-ghost btn btn-sm" data-toggle-more aria-expanded="false">
      Plus de critères <Icon name="chevron" size={16} />
    </button>
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-search]').forEach((form) => {
    const tabs = form.querySelectorAll<HTMLButtonElement>('[data-transac]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        form.action = tab.dataset.transac === 'location' ? '/louer/' : '/acheter/';
        const budget = form.querySelector<HTMLInputElement>('#s-budget');
        if (budget) budget.placeholder = tab.dataset.transac === 'location' ? '€ / mois' : '€';
      });
    });

    const more = form.querySelectorAll<HTMLElement>('[data-more]');
    const toggle = form.querySelector<HTMLButtonElement>('[data-toggle-more]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      more.forEach((el) => (el.hidden = open));
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.firstChild!.textContent = open ? 'Plus de critères ' : 'Moins de critères ';
    });

    // N'envoie que les champs remplis : l'URL reste courte et lisible.
    form.addEventListener('submit', () => {
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => {
        if (!f.value) f.disabled = true;
      });
    });
  });
</script>

<style>
  .search {
    background: #fff;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-l);
    padding: 0.5rem 1.25rem 0.75rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }

  .tabs button,
  .tab-link {
    padding: 0.8rem 1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .tabs button:hover,
  .tab-link:hover {
    color: var(--navy-900);
  }

  .tabs [aria-selected='true'] {
    color: var(--navy-900);
    border-bottom-color: var(--gold-400);
  }

  .tab-link {
    margin-left: auto;
    color: var(--gold-700);
  }

  .row {
    display: grid;
    gap: 0.75rem 1rem;
    grid-template-columns: 1fr;
    align-items: end;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: 1.2fr 1fr 1fr auto;
    }

    .f-more:not([hidden]) {
      grid-column: span 1;
    }
  }

  .f {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .f label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .f select,
  .f input {
    height: 2.9rem;
    padding-block: 0;
  }

  .submit {
    margin: 0;
  }

  .submit .btn {
    width: 100%;
    height: 2.9rem;
  }

  .more-toggle {
    margin: 0.5rem 0 0;
  }

  .more-toggle .btn {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .more-toggle .btn:hover {
    color: var(--navy-900);
  }
</style>
