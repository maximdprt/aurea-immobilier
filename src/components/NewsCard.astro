---
/**
 * Carte d'actualite : image de couverture (ou aplat de marque si aucune), date,
 * titre, extrait. Toute la carte est cliquable.
 */
import Picture from '~/components/Picture.astro';
import Icon from '~/components/Icon.astro';
import { newsMedia } from '~/lib/catalog';
import { frDate } from '~/lib/format';
import type { NewsItem } from '~/lib/news';

interface Props {
  item: NewsItem;
  priority?: boolean;
}
const { item, priority = false } = Astro.props;
const cover = item.coverKey ? newsMedia(item.slug) : null;
const href = `/actualites/${item.slug}/`;
---

<article class="news-card">
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Picture media={cover} alt="" aspect="16 / 9" sizes="(min-width: 64rem) 24rem, 92vw" priority={priority} />
      ) : (
        <div class="cover-fallback">
          <Icon name="sparkle" size={28} />
        </div>
      )
    }
  </a>
  <div class="body">
    <p class="date">
      <Icon name="calendar" size={14} />
      <time datetime={item.publishedAt}>{frDate(item.publishedAt)}</time>
    </p>
    <h3><a href={href}>{item.title}</a></h3>
    {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
    <p class="more link-arrow">Lire la suite</p>
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .news-card:hover {
    box-shadow: var(--shadow-l);
    transform: translateY(-3px);
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--sand-100);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(135deg, var(--navy-900), var(--navy-700));
    color: var(--gold-300);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.1rem 1.1rem;
  }

  .date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  h3 a {
    color: var(--navy-900);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .excerpt {
    margin: 0 0 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .more {
    margin: auto 0 0;
    font-size: var(--step--1);
    color: var(--gold-700);
  }
</style>
