---
/**
 * Information cookies.
 *
 * Objectif du brief (§21.4) : aucun cookie soumis a consentement n'est depose
 * au chargement. Le site n'utilise ni regie publicitaire, ni widget tiers, ni
 * analytics a cookie ; les contenus tiers (carte, video) sont derriere une
 * facade cliquable. Il n'y a donc rien a consentir au chargement, et afficher
 * un bandeau de consentement serait trompeur.
 *
 * Ce bandeau est purement informatif, s'affiche une fois, se ferme, et sa
 * fermeture est memorisee en localStorage — pas en cookie.
 */
---

<aside class="cookie-notice" id="cookie-notice" hidden data-cookie-notice>
  <p>
    Ce site ne dépose aucun cookie publicitaire ni traceur de mesure d’audience. Seuls des moyens
    techniques nécessaires à la sécurité des formulaires sont utilisés.
    <a href="/cookies/">En savoir plus</a>.
  </p>
  <button type="button" class="btn btn-sm btn-navy" data-cookie-dismiss>J’ai compris</button>
</aside>

<style>
  .cookie-notice {
    position: fixed;
    inset: auto var(--space-s) var(--space-s) auto;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    max-width: min(30rem, calc(100% - var(--space-s) * 2));
    padding: var(--space-s) var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-l);
    font-size: var(--step--1);
  }

  .cookie-notice p {
    margin: 0;
    flex: 1 1 14rem;
    color: var(--ink-soft);
  }

  @media (max-width: 48rem) {
    .cookie-notice {
      inset: auto var(--space-2xs) calc(4.5rem + env(safe-area-inset-bottom)) var(--space-2xs);
      max-width: none;
    }
  }
</style>

<script>
  const KEY = 'aurea:cookie-notice:v1';
  const box = document.querySelector<HTMLElement>('[data-cookie-notice]');
  if (box) {
    let seen = false;
    try {
      seen = localStorage.getItem(KEY) === '1';
    } catch {
      seen = false;
    }
    if (!seen) box.hidden = false;
    box.querySelector('[data-cookie-dismiss]')?.addEventListener('click', () => {
      box.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* sans stockage, le bandeau reapparaitra : acceptable */
      }
    });
  }
</script>
