---
/**
 * Barre fixe mobile : telephone cliquable et CTA estimation toujours visibles
 * (prompt v3 §8). Discrete, sans JS, masquee au-dela du mobile.
 */
import { CONTACT } from '~/lib/site';
---

<div class="action-bar">
  <a class="btn btn-secondary" href={`tel:${CONTACT.phoneE164}`}>
    <span aria-hidden="true">☎</span> Appeler
  </a>
  <a class="btn" href="/estimation/">Estimer mon bien</a>
</div>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s)
      calc(var(--space-2xs) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--canvas) 94%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }

  .action-bar .btn {
    min-height: 2.75rem;
    font-size: var(--step--1);
    padding-inline: var(--space-2xs);
  }

  .action-bar .btn-secondary {
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>
