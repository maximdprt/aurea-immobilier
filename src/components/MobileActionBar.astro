---
/**
 * Barre fixe mobile : telephone et estimation toujours a portee de pouce.
 * Sans JS, masquee au-dela du mobile.
 */
import Icon from '~/components/Icon.astro';
import { agency } from '~/lib/content';

const contact = agency();
---

<div class="action-bar">
  <a class="btn btn-outline" href={`tel:${contact.phoneE164}`}>
    <Icon name="phone" size={18} /> Appeler
  </a>
  <a class="btn" href="/estimation/">
    <Icon name="chart" size={18} /> Estimer mon bien
  </a>
</div>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s) calc(var(--space-2xs) + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }

  .action-bar .btn {
    min-height: 2.9rem;
    font-size: var(--step--1);
    padding-inline: var(--space-2xs);
  }

  .action-bar .btn-outline {
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>
