}

.page_annonce .page-header:after, .products_selled .page-header:after {
 	background-color: var(--color-1);   
}

.page_annonce .alert-fixed, .products_selled .alert-fixed {
    background: var(--color-1);
}

.barre-navigation-top .row-results, .barre-navigation-top .tri .input-tri .form-control {
 	color: var(--color-1);  
    font-size: 16px;
}

/** PAGE AGENCE */

.page_content_1 {
    background: var(--color-2);
}

.page_content_1 .page-header:after {
 	background-color: var(--color-1);   
}

/** PAGE GESTION */

.page_contact_us {
    background: var(--color-2);
    color: var(--color-1);
}

.page_contact_us .page-header:after {
 	background-color: var(--color-1);   
}

.page_contact_us a.btn-primary {
    border-color: var(--color-1);
    background-color: var(--color-1);
    color: white;
}

.page_content_5 {
    background: var(--color-2);
}

.breakout.breakout_gestion {
    background-color: var(--color-1);
    margin-top: 48px;
}

.breakout {
    width: 100vw;
    position: relative;
    left: calc(-1 * (100vw - 100%) / 2);
    padding: 30px 0;
}

.item-product .product-selection .product-image .bulle-nego img {
    width: 90%;
    height: 110%;
}

/** PAGE CONTACT2 */

.page_contact_us .entry-header {
    display: none;
}

.page_contact_us .contacter {
    
}

.contacter figure img {
    max-width: 100%;
}

.contacter h1 {
    text-align: center;
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 100;
    line-height: 1.3;
}

.contacter h2 {
    position: relative;
    display: block;
    margin-bottom: 35px;
    padding-bottom: 20px;
    text-align: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3; 
}

.contacter h2::after {
 	content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 3px;
    background-color: var(--color-2);
}

.contacter .fondateur {
    box-shadow: 0 4px 15px rgb(0 0 0 / 16%);
    padding: 20px;
    margin-bottom: 40px;
}

.contacter .fondateur .left {
    margin-bottom: 20px;
}

.contacter .fondateur .left figure {
    z-index: 0;
    position: relative;
}

.contacter .fondateur .left .fondateur_contact, .contacter .membre .membre_contact {
    background-color: #2b2828;
    color: white;
    text-align: center;
    padding: 15px;
    border-bottom: 8px solid var(--color-2);
    width: 86%;
    margin-left: auto;
    margin-right: auto;
    margin-top: -30px;
    z-index: 1;
    position: relative;
}

.contacter .fondateur h3, .contacter .membre h3 {
    color: white;
    margin-top: 0;
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 100;
    margin-bottom: 8px;
}

.contacter .membre h3 {
    font-size: 16px;
}

.contacter h3:after {
    content: none;
}

.contacter .fondateur h4, .contacter .membre h4 {
 	text-transform: uppercase;
    font-size: 14px;
    margin-top: 0;   
}

.contacter .fondateur .fondateur_contact p, .contacter .membre p {
    font-size: 14px;
    margin-bottom: 0;   
}

.contacter .fondateur p a, .contacter .membre p a {
 	color: white;   
}

.contacter .fondateur .mot {
    font-size: 15px;
}

.contacter .fondateur .mot h2 {
    text-transform: uppercase;
    font-size: 26px;
    text-align: left;
    font-weight: 100;
    padding-bottom: 0;
    margin-bottom: 20px;
}

.contacter .fondateur .mot h2:after {
    content: none;
}

.contacter .fondateur .mot ul {
    padding-left: 16px;
}

.contacter .membres {
    
}

.contacter .membres .membre {
    margin-bottom: 25px;
}

.contacter .membre p {
    font-size: 13px;
}

.contacter .bloc_contact {
 	margin-bottom: 50px;   
}

.contacter .bloc_contact h3 {
    text-align: center;
    text-transform: uppercase;
    font-size: 26px;
    font-weight: 100;
    margin-bottom: 20px;
}

.contacter .bloc_contact p {
    text-align: center;
}

h3.titre_form {
    text-align: center;
    text-transform: uppercase;
    font-weight: 100;
    font-size: 26px;
    margin-bottom: 50px;
}

h3.titre_form:after {
    content: none;
}

@media (min-width: 992px){
    .contacter h1 {
        font-size: 26px;
    }

    .contacter h2 {
        margin-top: 0;
        margin-bottom: 50px;
        padding-bottom: 30px;
        font-size: 18px;
    }
    
    .contacter .fondateur {
        display: flex;
    	justify-content: space-between;
    	align-items: center;
    }
    
    .contacter .fondateur .left {
        flex-basis: 22%;
    	margin-bottom: 0;
    }
    
    .contacter .fondateur .mot {
        flex-basis: 65%;
    }
    
    .contacter .fondateur .mot p {
     	margin-bottom: 25px;   
    }
    
    .contacter .membres {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 50px;
        gap: 50px;
    }
    
    .contacter .membres .membre {
        margin-bottom: 0;
        flex-basis: 26%;
    }
    
    .contacter .membre h3 {
        font-size: 16px;
    }
    
    .contacter .membre h4 {
        font-size: 14px;
    }
    
    .contacter .membre p {
        font-size: 13px;
    }
    
    .contacter .bloc_contact h3 {
        text-align: left;
    }
    
    .contacter .bloc_contact_coordonnees .coordonnee p {
        text-align: left;
    }
    
    h3.titre_form {
        font-size: 26px;
    }
}    </style>
