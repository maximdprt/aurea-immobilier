    font-size: 18px;
}

/** Moteur de recherche */

.page_home .header-main {
    top: auto;
    bottom: 10vh;
}

#quick_find > div.row-search-home.flex-row > div.row-input.row-localisation div.dropdown-menu.open > ul > li > a > span.text{
    text-transform: uppercase;   
} 

/** Page Accueil */

