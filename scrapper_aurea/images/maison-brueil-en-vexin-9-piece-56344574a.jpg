    <style>
        @import url('https://fonts.googleapis.com/css2?family=Arapey:ital@0;1&display=swap');

body {
    font-size: 16px !important;
}

.btn {
    font-size: 16px;
    font-weight: 600;
}

/** HOME */

#header .container-slider-home:after {
    background: none;
}

/** LOGO */

#bandeau_header .logo-header {
    padding: 0;
}

#bandeau_header .logo-header.home-logo {
    margin-top: 0;
}

/** HEADER */

#bandeau_header.dark-mode, #bandeau_header.dark-mode.mode-fixe {
    background-color: var(--color-1);
}

/** MENU */ 

#bandeau_header .header-menu .menu-desktop .menu .list-links li {
    margin: 0 10px;
}

#bandeau_header > div.container > div > div > div.header-menu > div.menu-desktop.hidden-xs.hidden-sm > div > ul > li:nth-child(6) > a{
    color: white;
    padding: 10px 8px;
	border: 1px solid var(--color-2);
}

.page_home #bandeau_header.dark-mode.mode-fixe .header-menu .menu-desktop .menu .list-links > li:nth-child(6) > a{
    color: var(--color-2);
}

#bandeau_header .logo-header img {
    max-width: 90%;
}

#bandeau_header .header-menu .menu-desktop .menu .list-links > li ul li a {
    font-size: 18px;
}

/** Moteur de recherche */

.page_home .header-main {
    top: auto;
    bottom: 10vh;
}

#quick_find > div.row-search-home.flex-row > div.row-input.row-localisation div.dropdown-menu.open > ul > li > a > span.text{
    text-transform: uppercase;   
} 

/** Page Accueil */

.page_home.dark-mode {
    background: var(--color-2, #003049);
}

.page_home .even.dark-mode .main-title {
    color: var(--color-1);
}

.page_home .even.dark-mode .main-title:after {
    background-color: var(--color-1);
}

.page_home .caption h1{
    font-size: 35px;
    font-weight: 600;
    display:none;
}

.page_home .caption h2 {
	font-size: 18px;
    font-weight: 400;
    margin-top: 20px;
    color: var(--color-2);
    display: block;
}

.container.caption {
    display: none;
}

.container.caption + script + .even {
 	padding-top: 40px;   
}

#box_selection .cta a.btn-primary {
    border-color: var(--color-1);
    background-color: var(--color-1);
    color: white;
}

/** BOUTONS */

.btn.btn-primary.dark-mode {
    background: var(--color-2);
    border-color: var(--color-2);
}

.btn.btn-primary.dark-mode:hover {
    background: var(--color-2-transparent);
    border-color: var(--color-2);
}

/** MOTEUR DE RECHERCHE */

.page_home .header-main {
    top: auto;
    bottom: 10vh;
}

/** CONTENT */

.texte-content a {
    color: #fff;
    font-weight: 600;
}

#box_home_content .bg-content-side {
    top: 5%;
    width: 50%;
    height: 500px;
}

#box_home_content .bg-content-side img {
    object-fit: contain;
}

.flex_agence {
    gap: 10px;
}

.flex_agence .texte_agence, .flex_agence .image_agence {
    flex: 1;
}

.entry-title, .page-header {
    text-transform: uppercase;
    font-size:34px;
}

/** CONTENUS */

.flex_contenu {
    margin: 30px 0;
}

.flex_contenu.first_flex {
 	margin: 0;   
}

.flex_contenu figure {
    margin-bottom: 25px;
}

.flex_contenu figure img {
    max-width: 100%;
}

.flex_contenu .flex_contenu_texte h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-2);
    line-height: 1.5;
    display: block;
    margin-top: 20px;
    margin-bottom: 10px;
}

.flex_contenu .flex_contenu_texte h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-1);
    line-height: 1.5;
    display:block;
    margin-top: 20px;
    margin-bottom: 10px;
}

.flex_contenu .flex_contenu_texte h3:first-of-type {
    margin-top: 0;
}

.flex_contenu .flex_contenu_texte h4 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-2);
    line-height: 1.5;
    display:block;
    margin-top: 20px;
    margin-bottom: 10px;
}

.flex_contenu .flex_contenu_texte span {
    color: var(--color-2);
}

.flex_contenu .flex_contenu_texte ul {
    margin: 10px 0;
}

.flex_contenu .flex_contenu_texte p:last-of-type {
    margin-bottom: 0;   
}

.flex_contenu .flex_contenu_texte .boutons {
    margin: 20px 0 0 0;   
    justify-content: flex-start;
}

@media (min-width: 992px){
    .flex_contenu {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 80px 0;
    }

    /* SI LE CONTENU EST PLUS HAUT QUE L'IMAGE, PERMET D'AGRANDIR LE VISUEL SUR LA MêME HAUTEUR */
    .flex_contenu.big {
        align-items: stretch;
    }

    .flex_contenu.big figure img {
        height: 100%;
        object-fit: cover;
    }

    .flex_contenu_texte {
        flex-basis: 55%;
    }
    
    .flex_contenu_texte p, .flex_contenu_texte li {
        color: var(--color-1);
    }

    .flex_contenu figure {
        flex-basis: 40%;
        margin-bottom: 0;
    }
    
    .page_content_1 .flex_contenu figure {
        flex-basis: 30%;
    }
    
    .page_content_1 .flex_contenu_texte {
        flex-basis: 70%;
    }

    /* PERMET DE GERER L'ALTERNANCE GAUCHE / DROITE SI PLUSIEURS BLOCS SUCCESSIFS */
    .flex_contenu.reverse figure {
        order: 1;
    }

    .flex_contenu.reverse .flex_contenu_texte {
        text-align: left;   
    }

    .flex_contenu.reverse .flex_contenu_texte ul {
        list-style-position: inside;
    }

    .flex_contenu.reverse .flex_contenu_texte .boutons {
        justify-content: flex-end;
    }
}

breakout {
    width: 100vw;
    position: relative;
    left: calc(-1 * (100vw - 100%) / 2);
    padding: 30px 0;
}

.breakout_off {
 	padding-top: 0;   
}

.breakout_off .flex_contenu {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin: 0;
}

.breakout_off .flex_contenu figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.breakout_off .flex_contenu .flex_contenu_texte {
    display: flex;
    justify-content: center;
    text-align: justify;
}

.breakout_off .flex_contenu .flex_contenu_texte .flex_contenu_texte_center {
    padding: 0 20px;
}

.breakout_off .flex_contenu .flex_contenu_texte h3 {
    font-size: 22px;
    font-weight: normal;
    text-align: center;
    margin-bottom: 42px;
}

.breakout_off .flex_contenu .flex_contenu_texte h3:not(:first-of-type) {
    margin-top: 45px;
}

.breakout_off .flex_contenu .flex_contenu_texte .boutons .btn {
    background-color: transparent;
    color: black;
    border-color: black;
    font-weight: 300;
    font-size: 12px;
}


/**LISTING**/

.item-product.dark-mode .product-selection .product-infos .product-price, #listing_bien.dark-mode .listing-item .product-price {
    color: var(--color-1);
    font-size: 22px;
}

/** FICHE BIEN */

.page_products_info .infos-bien.dark-mode .product-price, .page_products_info .infos-bien-mobile.dark-mode .product-price {
    color: #fff;
}

/** AGENCE */

.flex_agence figure {
    margin-bottom: 30px;
}

.flex_agence figure img {
        max-width: 100%;   
}

.flex_agence .texte_agence {
    box-shadow: 0 3px 15px rgb(0 0 0 / 16%);
    padding: 20px; 
    background-color: var(--color-1);
    color: white;
    text-align: center;
	background-image: url(https://v2.immo-facile.com/office5/aureaimmo_140824/catalog/images/perso/PICTO1COUPE.png);
    background-repeat: no-repeat;
    background-position-x: right;
    background-position-y: bottom;
}

.flex_agence .texte_agence h3 {
    margin-top: 0;
    margin-bottom: 25px;
    font-size: 22px;
    font-weight: 600;
    color: var(--color-2);  
}

.flex_agence .texte_agence .boutons {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
}

.flex_agence .texte_agence .boutons .reseaux_sociaux {
    display: flex;
}

.flex_agence .texte_agence .boutons .reseaux_sociaux figure {
    flex-basis: auto;
}

/* SI 3 PICTOS RESEAUX SOCIAUX */
.flex_agence .texte_agence .boutons .reseaux_sociaux figure:nth-child(2) {
        margin: 0 15px;   
}

/* SI 2 PICTOS RESEAUX SOCIAUX */
.flex_agence .texte_agence .boutons .reseaux_sociaux figure:first-child {
    margin-right: 15px;   
}

.description_agence {
    margin: 40px 0;
    color: var(--color-1);
}

.description_agence h3{
    font-size: 20px;
    font-weight: 600;
    color: var(--color-1);
    margin-bottom: 20px;
    display: block;
}

.description_agence h4{
    font-size: 18px;
    font-weight: 600;
    color: var(--color-2);
    margin-bottom: 20px;
    display: block;
}

@media (min-width: 992px){
    .flex_agence {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 30px;
    }
    
    .flex_agence figure {
       flex-basis: 45%;  
        margin-bottom: 0;
    }
}



/** EQUIPE */

.aurea_equipe h2 {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-1);
    display: block;
    margin-top: 40px;
    margin-bottom: 20px;
}

.membre_equipe {
	margin-bottom: 30px;
    background-color: white;
    box-shadow: 0 3px 15px rgb(0 0 0 / 16%);
    padding: 20px;
}

.membre_equipe figure {
    text-align: center; 
}

.membre_equipe figure img {
 	max-width: 100%;   
}

.membre_equipe .membre_equipe_details {
	text-align: center;
    margin-top: 20px;
}

.membre_equipe .membre_equipe_details h3 {
	color: var(--color-1);
	font-weight: 700;
	font-size: 22px;
	margin-top: 0;
}  

.membre_equipe .membre_equipe_details h4 {
	color: var(--color-2-darken);
	font-weight: 700;
	font-size: 20px;
	margin-top: 0;
}  

@media (min-width: 992px){
	.membres_equipe {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}

	.membre_equipe {
		flex-basis: calc(25% - 30px);
		margin: 0 15px 30px;
	}
}


/** CONTACT */

.contactez {
    margin: 40px 0;
}

.coordonnees {
    display: flex;
    flex-direction: column;
}

.coordonnee {
    box-shadow: 0 3px 15px rgb(0 0 0 / 16%);
    background-color: white;
    text-align: center;
    padding: 20px;
}

.coordonnee a{
    color:#000;
}

.coordonnees .coordonnee:nth-child(2) {
    margin: 15px 0;
}

.coordonnees .coordonnee h3{
	color: var(--color-1);
}

.contactez figure {
    box-shadow: 0 3px 15px rgb(0 0 0 / 16%);
}

.contactez figure img {
    max-width: 100%;
}

.page_contact_us h3:after, .page_contact_us h3:after, .page_login h3:after, .page_login h3:after {
    border-bottom: none;
}

@media (min-width: 1024px){
    .contactez {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .coordonnees {
        flex-basis: 40%;   
    }

    .contactez figure {
        flex-basis: 55%;
    }
}

/** AGENCE */

.page_agences_list .agences .agence {
    padding: 10px 20px;
}

/** MEDIA QUERIES */ 

@media (max-width: 1299px){
    #bandeau_header .header-menu .menu-desktop .menu .list-links li {
        margin: 0 5px;
    }
}  

@media (max-width: 1199px){
    #bandeau_header .header-menu .menu-desktop .menu .list-links > li {
        padding: 5px;
    }
    #bandeau_header .header-menu .menu-desktop .menu .list-links > li > a {
  		font-size: 15px;
	}
}

@media (min-width: 1200px){
    #bandeau_header .header-menu .menu-desktop .menu .list-links > li > a {
  		font-size: 20px;
	}
}

@media (max-width: 768px){ 
	.container.caption .logo-h1 {
   		 max-width: 30%;
	}
}

@media (max-width: 425px){ 
	.container.caption .logo-h1 {
   		max-width: 50%;
	}
    .page_home .caption h2 {
        font-size: 15px;
    }
} 

@media (min-width: 992px){
    .directrice {
        display: flex;
        flex-basis: 45%;  
       gap:40px;
        
    }

    .directrice .membre_equipe_details {
        text-align: left;
    }
	
	.directrice figure {
	flex-basis: 40%
	}
	
	.directrice .membre_equipe_details {
	flex-basis: 60%
	}
}

#bandeau_header.dark-mode .header-menu .menu-desktop .menu .list-links > li > a, #bandeau_header.dark-mode.mode-fixe .header-menu .menu-desktop .menu .list-links > li > a, #bandeau_header.dark-mode .header-menu .menu-tools a, #bandeau_header.dark-mode.mode-fixe .header-menu .menu-tools a, #bandeau_header.dark-mode .header-menu .menu-tools .links a, #bandeau_header.dark-mode.mode-fixe .header-menu .menu-tools .links a {
    color: #E5DBC9;
}

.btn.btn-primary {
    color: #001F41;
}
.btn.btn-primary.dark-mode {
   color: #001F41;
}

#box_search .search-form .row-transac .list-transac li .btn-primary {
    background: var(--color-2, #fe5f55);
    color: #001F41;
}    

/** PAGE ESTIMATION */

.page_estimation {
 	background-color: var(--color-2);   
}

.page_estimation .page-header:after {
 	background-color: var(--color-1);   
}

.page_estimation .entry-content .btn-primary {
    border-color: var(--color-1);
    background-color: var(--color-1);
    color: white;
}

/** PAGE LISTING */

.page_annonce, .products_selled  {
    background-color: var(--color-2);  
    color: var(--color-1);
}

.page_annonce .page-header:after, .products_selled .page-header:after {
 	background-color: var(--color-1);   
}

.page_annonce .alert-fixed, .products_selled .alert-fixed {
    background: var(--color-1);
}

.barre-navigation-top .row-results, .barre-navigation-top .tri .input-tri .form-control {
 	color: var(--color-1);  
    font-size: 16px;
}

/** PAGE AGENCE */

.page_content_1 {
    background: var(--color-2);
}

.page_content_1 .page-header:after {
 	background-color: var(--color-1);   
}

/** PAGE GESTION */

.page_contact_us {
    background: var(--color-2);
    color: var(--color-1);
}

.page_contact_us .page-header:after {
 	background-color: var(--color-1);   
}

.page_contact_us a.btn-primary {
    border-color: var(--color-1);
    background-color: var(--color-1);
    color: white;
}

.page_content_5 {
    background: var(--color-2);
}

.breakout.breakout_gestion {
    background-color: var(--color-1);
    margin-top: 48px;
}

.breakout {
    width: 100vw;
    position: relative;
    left: calc(-1 * (100vw - 100%) / 2);
    padding: 30px 0;
}

.item-product .product-selection .product-image .bulle-nego img {
    width: 90%;
    height: 110%;
}

/** PAGE CONTACT2 */

.page_contact_us .entry-header {
    display: none;
}

.page_contact_us .contacter {
    
}

.contacter figure img {
    max-width: 100%;
}

.contacter h1 {
    text-align: center;
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 100;
    line-height: 1.3;
}

.contacter h2 {
    position: relative;
    display: block;
    margin-bottom: 35px;
    padding-bottom: 20px;
    text-align: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3; 
}

.contacter h2::after {
 	content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 3px;
    background-color: var(--color-2);
}

.contacter .fondateur {
    box-shadow: 0 4px 15px rgb(0 0 0 / 16%);
    padding: 20px;
    margin-bottom: 40px;
}

.contacter .fondateur .left {
    margin-bottom: 20px;
}

.contacter .fondateur .left figure {
    z-index: 0;
    position: relative;
}

.contacter .fondateur .left .fondateur_contact, .contacter .membre .membre_contact {
    background-color: #2b2828;
    color: white;
    text-align: center;
    padding: 15px;
    border-bottom: 8px solid var(--color-2);
    width: 86%;
    margin-left: auto;
    margin-right: auto;
    margin-top: -30px;
    z-index: 1;
    position: relative;
}

.contacter .fondateur h3, .contacter .membre h3 {
    color: white;
    margin-top: 0;
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 100;
    margin-bottom: 8px;
}

.contacter .membre h3 {
    font-size: 16px;
}

.contacter h3:after {
    content: none;
}

.contacter .fondateur h4, .contacter .membre h4 {
 	text-transform: uppercase;
    font-size: 14px;
    margin-top: 0;   
}

.contacter .fondateur .fondateur_contact p, .contacter .membre p {
    font-size: 14px;
    margin-bottom: 0;   
}

.contacter .fondateur p a, .contacter .membre p a {
 	color: white;   
}

.contacter .fondateur .mot {
    font-size: 15px;
}

.contacter .fondateur .mot h2 {
    text-transform: uppercase;
    font-size: 26px;
    text-align: left;
    font-weight: 100;
    padding-bottom: 0;
    margin-bottom: 20px;
}

.contacter .fondateur .mot h2:after {
    content: none;
}

.contacter .fondateur .mot ul {
    padding-left: 16px;
}

.contacter .membres {
    
}

.contacter .membres .membre {
    margin-bottom: 25px;
}

.contacter .membre p {
    font-size: 13px;
}

.contacter .bloc_contact {
 	margin-bottom: 50px;   
}

.contacter .bloc_contact h3 {
    text-align: center;
    text-transform: uppercase;
    font-size: 26px;
    font-weight: 100;
    margin-bottom: 20px;
}

.contacter .bloc_contact p {
    text-align: center;
}

h3.titre_form {
    text-align: center;
    text-transform: uppercase;
    font-weight: 100;
    font-size: 26px;
    margin-bottom: 50px;
}

h3.titre_form:after {
    content: none;
}

@media (min-width: 992px){
    .contacter h1 {
        font-size: 26px;
    }

    .contacter h2 {
        margin-top: 0;
        margin-bottom: 50px;
        padding-bottom: 30px;
        font-size: 18px;
    }
    
    .contacter .fondateur {
        display: flex;
    	justify-content: space-between;
    	align-items: center;
    }
    
    .contacter .fondateur .left {
        flex-basis: 22%;
    	margin-bottom: 0;
    }
    
    .contacter .fondateur .mot {
        flex-basis: 65%;
    }
    
    .contacter .fondateur .mot p {
     	margin-bottom: 25px;   
    }
    
    .contacter .membres {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 50px;
        gap: 50px;
    }
    
    .contacter .membres .membre {
        margin-bottom: 0;
        flex-basis: 26%;
    }
    
    .contacter .membre h3 {
        font-size: 16px;
    }
    
    .contacter .membre h4 {
        font-size: 14px;
    }
    
    .contacter .membre p {
        font-size: 13px;
    }
    
    .contacter .bloc_contact h3 {
        text-align: left;
    }
    
    .contacter .bloc_contact_coordonnees .coordonnee p {
        text-align: left;
    }
    
    h3.titre_form {
        font-size: 26px;
    }
}    </style>
