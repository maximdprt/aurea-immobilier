# Copier en .env.local (jamais commite). Sur Vercel : Settings > Environment Variables.
# Les variables PUBLIC_ sont exposees au navigateur ; les autres restent serveur.

PUBLIC_SITE_URL=https://www.aurea-immobilier.fr

# --- Supabase (projet esgygaazfyjzzzdrvcey) ---------------------------------
PUBLIC_SUPABASE_URL=https://esgygaazfyjzzzdrvcey.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=https://esgygaazfyjzzzdrvcey.supabase.co/auth/v1/.well-known/jwks.json

# Cles secretes (Settings > API Keys > Secret keys). Une par usage, revocables
# separement. Contournent la RLS : jamais cote client, jamais dans le depot.
SUPABASE_SECRET_KEY_FORMS=sb_secret_...
SUPABASE_SECRET_KEY_IMPORT=sb_secret_...
SUPABASE_SECRET_KEY_CONTENT=sb_secret_...

# --- Back-office de contenu (/admin/) -----------------------------------------
# 12 caracteres minimum. Le changer deconnecte toutes les sessions ouvertes.
ADMIN_CODE=
# Vercel > Settings > Git > Deploy Hooks : relance la construction du site
# apres chaque enregistrement dans le back-office.
VERCEL_DEPLOY_HOOK_URL=

# --- Alertes email --------------------------------------------------------------
# Derive les jetons de desinscription. Le changer invalide tous les liens envoyes.
ALERT_TOKEN_SECRET=

# --- Anti-spam (Cloudflare Turnstile) ----------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Emails (Resend) ----------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=AUREA Immobilier <contact@aurea-immobilier.fr>
EMAIL_TO_AGENCY=contact@aurea-immobilier.fr

# --- Divers -------------------------------------------------------------------
IP_HASH_SALT=
CRON_SECRET=
ORISHA_FEED_URL=
ORISHA_FEED_TOKEN=

# Affiche les placeholders [[a fournir]] sur le site (recette uniquement).
# PUBLIC_RECETTE=1
